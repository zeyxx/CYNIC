{
  "schema": "cynic.api_topology.v1",
  "status": "normative",
  "purpose": "Classify every kernel REST operation by organism layer, mutation level, canonical family and agent safety so OpenAPI discoverability exposes structure instead of hiding accidental growth.",
  "source_of_truth": {
    "router": "crates/cynic-kernel/src/api/rest/mod.rs",
    "openapi": "docs/api/openapi.json",
    "human_reference": "API.md",
    "layer_alignment": "axioms/api-layer-alignment-v1.json"
  },
  "allowed": {
    "layers": [
      "perception",
      "memory",
      "coordination",
      "cognition",
      "metabolism",
      "compatibility"
    ],
    "mutation_levels": [
      "read",
      "stream",
      "mempool",
      "runtime",
      "deployment",
      "destructive"
    ],
    "statuses": [
      "canonical",
      "compat",
      "transitional",
      "legacy"
    ]
  },
  "invariants": [
    "Every OpenAPI operation must have exactly one topology entry.",
    "Every topology operation must exist in the OpenAPI document.",
    "Operations with deployment or destructive mutation levels must not be agent_safe_default.",
    "Compatibility operations may keep external path conventions, but must declare their canonical family.",
    "Transitional operations are migration debt and must remain within the explicit topology_budget.",
    "Root splits are migration debt and must remain within the explicit topology_budget."
  ],
  "topology_budget": {
    "max_root_splits": 0,
    "max_transitional_operations": 0,
    "max_legacy_operations": 0,
    "compat_operations": {
      "allowed": true,
      "reason": "External protocol compatibility may remain when the status is explicit and canonical_family points to the organism-native surface."
    }
  },
  "public_discovery_endpoints": {
    "GET /openapi.json": {
      "serves": "docs/api/openapi.json",
      "schema": "openapi-3.1"
    },
    "GET /api/topology": {
      "serves": "axioms/api-topology-v1.json",
      "schema": "cynic.api_topology.v1"
    },
    "GET /api/layer-alignment": {
      "serves": "axioms/api-layer-alignment-v1.json",
      "schema": "cynic.api_layer_alignment.v1"
    }
  },
