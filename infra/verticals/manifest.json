{
  "schema": "cynic.verticals_manifest.v1",
  "status": "normative",
  "purpose": "Point d'entrée déclaratif des verticales fondamentales CYNIC. Chaque verticale est une unité de desired state + observe + reconcile + bounded action + read-back proof (PoH offchain + DNS external_proof) + remédiation. Les monolithes historiques (infra/registry.json, infra/surface-registry.json, infra/agent-exposure.json) sont des aggregates qui référencent ces verticales; la source de vérité découplée est ici.",
  "convention": {
    "layout": "infra/verticals/<verticale>/intent.json",
    "schema_per_vertical": "cynic.vertical_intent.v1",
    "desired_state": "inline dans intent.json (pas de fragmentation)",
    "code_contract": "types/champs Rust que le desired_state doit respecter (réconciliation JSON↔code)",
    "read_back_proof": {
      "poh_checkpoint": "cynic.poh_checkpoint_batch.v1, offchain par défaut (Surreal proof_of_history), onchain optionnel (Anchor record_poh_checkpoint)",
      "dns_proof": "cynic.runtime_network_preflight.v1, external_proof référencé dans le PoH (hash+timestamp), non inclus dans la séquence de cycle de vie",
      "maturity_percent_min": 80,
      "known_coverage_percent_min": 60
    },
    "remediation": "obligatoire si bounded_action.mutates == true; absente si read-only (ce n'est pas une erreur de modèle)"
  },
  "verticals": [
    { "id": "provider_enrollment", "source": "infra/registry.json#provider_control", "layer": "l1_host" },
    { "id": "release", "source": "infra/registry.json#release_publication", "layer": "l1_host" },
    { "id": "storage", "source": "infra/registry.json#storage_registry", "layer": "l1_host" },
    { "id": "machine_enrollment", "source": "infra/registry.json#node_enrollment", "layer": "l1_host", "status": "extracted_first_due_to_token_ttl_s_divergence" },
    { "id": "network", "source": ["infra/registry.json#network_policy", "infra/surface-registry/fragments/network_runtime.json", "infra/surface-registry/fragments/runtime_network_preflight.json"], "layer": "l1_to_l2_node_network" },
    { "id": "node", "source": "infra/registry.json#nodes", "layer": "l1_host" },
    { "id": "build_runner", "source": "infra/registry.json#build_lifecycle", "layer": "l1_host" },
    { "id": "fleet", "source": ["infra/registry.json#fleet_desired", "infra/surface-registry/fragments/fleet_observation.json"], "layer": "l1_host_readonly" },
    { "id": "lifecycle", "source": ["infra/registry.json#lifecycle", "infra/surface-registry/fragments/update_lifecycle.json"], "layer": "l0_to_l3_promotion_membrane" },
    { "id": "dev_governance", "source": "infra/surface-registry/fragments/agent_development.json", "layer": "l0_to_l2_architecture_governance" },
    { "id": "bootstrap", "source": "infra/surface-registry/fragments/bootstrap_host_exec_bridge.json", "layer": "l1_host_apply_boundary" },
    { "id": "deps", "source": ["infra/surface-registry/fragments/ecosystem_deps.json", "infra/surface-registry/fragments/ecosystem_deps_upgrade.json"], "layer": "l1_host_readonly" },
    { "id": "integrations", "source": ["infra/surface-registry/fragments/ecosystem_integrations.json", "infra/surface-registry/fragments/ecosystem_integrations_adopt.json", "infra/surface-registry/fragments/ecosystem_integrations_connect.json", "infra/surface-registry/fragments/ecosystem_integrations_plan.json"], "layer": "l1_host_apply_boundary" },
    { "id": "inference", "source": "infra/surface-registry/fragments/chat_operator_surface.json", "layer": "l1_host_readonly" },
    { "id": "runtime", "source": ["infra/surface-registry/fragments/runtime_agent_matrix.json", "infra/surface-registry/fragments/runtime_disk_management.json", "infra/surface-registry/fragments/runtime_execution_context.json", "infra/surface-registry/fragments/runtime_execution_suite.json", "infra/surface-registry/fragments/runtime_host_checks.json", "infra/surface-registry/fragments/runtime_paths.json", "infra/surface-registry/fragments/runtime_report.json", "infra/surface-registry/fragments/runtime_resolver_plan.json", "infra/surface-registry/fragments/runtime_validation.json"], "layer": "l0_to_l3_runtime_plan" },
    { "id": "lab", "source": "infra/surface-registry/fragments/portable_lab.json", "layer": "l0_proof_harness" },
    { "id": "transport", "source": "infra/surface-registry/fragments/transport_observation.json", "layer": "l1_host_readonly" },
    { "id": "agent_exposure", "source": "infra/agent-exposure.json", "layer": "adapter" },
    { "id": "framework_spec", "source": ["contracts/framework.json", "contracts/foundation.json"], "layer": "normative" }
  ]
}
