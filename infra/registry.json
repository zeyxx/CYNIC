  "routing_rules": {
    "primary_tunnel": "headscale_souverain_mesh",
    "management_fallback": "local_192_168_0_0_24",
    "slack_routing": {
      "kernel_ops": "SLACK_CHANNEL_KERNEL",
      "blitz_and_chill": "SLACK_CHANNEL_BC",
      "talaria_alerts": "SLACK_CHANNEL_TALARIA",
      "stage_privacy_ethereum": "SLACK_CHANNEL_CAPLOGY"
    }
