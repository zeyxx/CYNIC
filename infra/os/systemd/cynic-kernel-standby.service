[Unit]
Description=CYNIC OS V2 — Resident Standby Kernel
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/lib/cynic
ExecStart=/usr/local/bin/cynic-kernel
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/cynic/env
Environment="CYNIC_STANDBY_MODE=resident"
Environment="CYNIC_REST_ADDR=127.0.0.1:3031"
Environment="CYNIC_KERNEL_SOCKET=/run/cynic/kernel-standby.sock"
Environment="CYNIC_LOCAL_SPOOL_DIR=/var/lib/cynic/standby-spool"
Environment="CYNIC_COORDINATION_AUTHORITY_ID=cynic-coordination"
Environment="CYNIC_NODE_ID=cynic-vm-v2"
Environment="CYNIC_STANDBY_UNIT=cynic-kernel-standby.service"
Environment="CYNIC_ACTIVE_UNIT=cynic-kernel.service"
Environment="CYNIC_ACTIVE_HEALTH_ENDPOINT=http://127.0.0.1:3030/health"
Environment="CYNIC_ACTIVE_IDENTITY_ENDPOINT=http://127.0.0.1:3030/identity"
Environment="SURREALDB_PASS_FILE=/etc/cynic/secrets/storage-runtime-password"
Environment="CYNIC_STORAGE_CONFIG=/etc/cynic/storage.toml"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
LimitNOFILE=65535
MemoryMax=2G

[Install]
WantedBy=default.target
