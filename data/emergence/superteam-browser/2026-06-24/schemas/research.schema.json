{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StructuredResearch.schema.json",
  "title": "StructuredResearch",
  "type": "object",
  "required": [
    "question",
    "sources",
    "findings",
    "applicability_to_cynic",
    "risks",
    "next_experiment"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "sources": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "applicability_to_cynic": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "next_experiment": {
      "type": "string"
    }
  },
  "additionalProperties": true
}