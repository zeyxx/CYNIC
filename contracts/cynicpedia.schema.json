{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "cynic.cynicpedia.v1",
  "version": "1.0.0",
  "status": "draft",
  "purpose": "Schema for infra/cynicpedia.json: registry of CYNIC knowledge articles (docs, contracts, traces, designs) with provenance and lifecycle status.",
  "required": [
    "schema",
    "status",
    "purpose",
    "articles",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cynic.cynicpedia.v1",
      "description": "Schema identifier for the CYNICpedia registry document."
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "draft",
        "active",
        "normative"
      ],
      "description": "Lifecycle status of the CYNICpedia registry."
    },
    "purpose": {
      "type": "string",
      "description": "Human-readable purpose of the document."
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "article_id",
          "title",
          "path",
          "kind",
          "provenance",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable article identifier."
          },
          "title": {
            "type": "string",
            "description": "Human-readable article title."
          },
          "path": {
            "type": "string",
            "description": "Path relative to repository root."
          },
          "kind": {
            "type": "string",
            "enum": [
              "doc",
              "contract",
              "trace",
              "design"
            ],
            "description": "Article kind."
          },
          "provenance": {
            "type": "string",
            "description": "Git commit hash or author provenance."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "deprecated"
            ],
            "description": "Lifecycle status of the article."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp of creation."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp of last update."
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of registry creation."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of last registry update."
    }
  },
  "additionalProperties": false
}
