[Unit]
Description=CYNIC Organ — Legacy Wireguard Hot-Reloader Daemon (breakglass only)
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.cynic-env
Environment=CYNIC_ALLOW_LEGACY_WIREGUARD_DAEMON=1
WorkingDirectory=@CYNIC_PROJECT_ROOT@/organs/wireguard
ExecStart=/usr/bin/env uv run python src/entrypoints/cli.py
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
