{
    "schema": "cynic.storage_primary_activation.v1",
    "status": "normative",
    "description": "Deterministic activation contract for moving CYNIC primary storage to the dedicated cynic-lxc-surrealdb node without ad hoc LAN endpoints, root/root credentials, or shell provisioning shortcuts.",
    "authority": {
        "registry": "infra/registry.json",
        "storage_schema": "infra/surrealdb/schema.surql",
        "lxc_exec_bridge": "axioms/lxc-exec-bridge-v1.json",
        "organ": "organs/keep"
    },
    "target": {
        "node": "cynic-lxc-surrealdb",
        "role": "storage_primary",
        "service": "surrealdb",
        "canonical_endpoint": "http://organ-surrealdb.synapse.cynic:8000",
        "forbidden_endpoint_classes": [
            "manual_lan_ip",
            "localhost_for_remote_storage",
            "proxmox_guest_ip_as_service_contract"
        ]
    },
    "activation_requirements": [
        "network.ipam.check passes for cynic-lxc-surrealdb",
        "network.mesh.status proves organ-surrealdb.synapse.cynic resolves/reaches the storage node",
        "fleet.node.status observes lxc/103 running",
        "fleet.node.exec LXC bridge activation_status is active",
        "surrealdb service unit is installed from bundle",
        "service.health passes through Synapse endpoint",
        "kernel SURREALDB_URL points to the Synapse endpoint",
        "kernel health no longer reports storage down"
    ],
    "bundle_files": {
        "surrealdb.service": "systemd unit for the storage node",
        "surrealdb.env.template": "environment template without secrets",
        "README.activation.md": "operator activation instructions and checks",
        "manifest.json": "machine-readable bundle manifest"
    },
    "status_contract": {
        "schema": "cynic.storage_primary_activation.status.v1",
        "active_requires": [
            "endpoint_is_synapse_dns",
            "bridge_active",
            "fleet_observes_node_running",
            "mesh_reaches_storage",
            "bundle_complete",
            "service_health_healthy"
        ]
    },
    "activation_request_contract": {
        "schema": "cynic.storage_primary_activation.request.v1",
        "transport": {
            "preferred": "kernel_mempool",
            "fallback": "operator_or_dedicated_activation_organ",
            "dispatch_preconditions": [
                "kernel_task_storage_healthy",
                "dispatched_task_visible_in_pending_or_completed_readback"
            ]
        },
        "task": {
            "kind": "hermes",
            "domain": "storage-activation",
            "consumer": "organ-forge-hermes-agent",
            "priority": 95,
            "action": "activate_lxc_exec_bridge_then_storage_primary",
            "activation_schema_version": "storage-activation.v1"
        },
        "bundles": {
            "lxc_exec_bridge": "/tmp/cynic-lxc-bridge",
            "storage_primary": "/tmp/cynic-storage-primary"
        },
        "coord_targets": [
            "organs/fleet",
            "organs/keep",
            "axioms/lxc-exec-bridge-v1.json",
            "axioms/storage-primary-activation-v1.json",
            "infra/registry.json"
        ],
        "required_sequence": [
            "install root-owned LXC exec bridge helper, policy, and sudoers on the Proxmox host from the lxc_exec_bridge bundle",
            "verify lxc_exec_bridge_status.status is active",
            "start or observe cynic-lxc-surrealdb running through fleet.node.status",
            "install the storage_primary bundle inside cynic-lxc-surrealdb through the approved bridge or operator path",
            "start the surrealdb service with secrets supplied out-of-band",
            "verify organ-surrealdb.synapse.cynic DNS and mesh reachability",
            "verify service.health on http://organ-surrealdb.synapse.cynic:8000/health",
            "verify storage_primary_readiness.ready is true",
            "point kernel SURREALDB_URL to the Synapse endpoint and verify kernel health no longer reports storage down"
        ],
        "done_when": [
            "lxc_exec_bridge_status.status == active",
            "storage_primary_readiness.ready == true",
            "kernel health has no storage_down cause after SURREALDB_URL uses the Synapse endpoint"
        ],
        "no_cortex_root_execution": true
    },
    "forbidden_patterns": [
        "curl | sh",
        "bash -c heredoc via pct exec",
        "root/root default credentials",
        "192.168.* service endpoint",
        "direct pct exec exposed to agents"
    ]
}
