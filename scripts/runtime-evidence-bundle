#!/usr/bin/env bash
# Emit a real runtime proof bundle from local evidence (not synthetic fixtures).
# Consumed by: cynic runtime metrics --json --proof <path>
#
# Evidence sources:
#   - architecture_boundary tests (host + cli) when cargo available
#   - make lab-smoke when requested
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
OUT="${1:-/tmp/cynic-runtime-proof-bundle.json}"
NOW_MS="$(python3 -c 'import time; print(int(time.time()*1000))')"
export CYNIC_ALLOW_LOCAL_DEV_BUILD=1
export RUST_MIN_STACK="${RUST_MIN_STACK:-536870912}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
CARGO="${CARGO:-cargo}"

HOST_OK=0
CLI_OK=0
LAB_OK=0
HOST_DETAIL="not_run"
CLI_DETAIL="not_run"
LAB_DETAIL="not_run"

if "$CARGO" test -p cynic-host --test architecture_boundary -- --quiet >/tmp/cynic-ev-host.log 2>&1; then
  HOST_OK=1
  HOST_DETAIL="cynic-host architecture_boundary ok"
else
  HOST_DETAIL="cynic-host architecture_boundary failed (see /tmp/cynic-ev-host.log)"
fi

if "$CARGO" test -p cynic-cli --test architecture_boundary -- --quiet >/tmp/cynic-ev-cli.log 2>&1; then
  CLI_OK=1
  CLI_DETAIL="cynic-cli architecture_boundary ok"
else
  CLI_DETAIL="cynic-cli architecture_boundary failed (see /tmp/cynic-ev-cli.log)"
fi

if [[ "${CYNIC_EVIDENCE_LAB_SMOKE:-0}" == "1" ]]; then
  if make lab-smoke >/tmp/cynic-ev-lab.log 2>&1; then
    LAB_OK=1
    LAB_DETAIL="make lab-smoke ok"
  else
    LAB_DETAIL="make lab-smoke failed (see /tmp/cynic-ev-lab.log)"
  fi
else
  LAB_DETAIL="skipped (set CYNIC_EVIDENCE_LAB_SMOKE=1)"
fi

ARCH_STATUS="blocked"
if [[ "$HOST_OK" -eq 1 && "$CLI_OK" -eq 1 ]]; then
  ARCH_STATUS="satisfied"
fi
LAB_STATUS="blocked"
if [[ "$LAB_OK" -eq 1 ]]; then
  LAB_STATUS="satisfied"
elif [[ "${CYNIC_EVIDENCE_LAB_SMOKE:-0}" != "1" ]]; then
  LAB_STATUS="unknown"
fi

BUNDLE_STATUS="blocked"
if [[ "$ARCH_STATUS" == "satisfied" ]]; then
  if [[ "$LAB_STATUS" == "satisfied" || "$LAB_STATUS" == "unknown" ]]; then
    BUNDLE_STATUS="satisfied"
  fi
fi

python3 - "$OUT" "$NOW_MS" "$ARCH_STATUS" "$LAB_STATUS" "$BUNDLE_STATUS" \
  "$HOST_DETAIL" "$CLI_DETAIL" "$LAB_DETAIL" <<'PY'
import json, sys
out, now, arch, lab, bundle, host_d, cli_d, lab_d = sys.argv[1:]
now = int(now)
proofs = [
  {
    "schema": "cynic.runtime_proof.v1",
    "gate": "architecture_boundary_verified",
    "status": arch,
    "producer": "scripts/runtime-evidence-bundle",
    "subject": "cynic-host+cynic-cli architecture_boundary",
    "observed_at_unix_ms": now,
    "evidence": [
      {"id": "host_architecture_boundary", "status": "active" if arch == "satisfied" else "blocked", "detail": host_d},
      {"id": "cli_architecture_boundary", "status": "active" if arch == "satisfied" else "blocked", "detail": cli_d},
    ],
  }
]
if lab != "unknown":
  proofs.append({
    "schema": "cynic.runtime_proof.v1",
    "gate": "distributed_formation_observed",
    "status": lab,
    "producer": "scripts/runtime-evidence-bundle",
    "subject": "infra/registries/lab.json",
    "observed_at_unix_ms": now,
    "evidence": [
      {"id": "lab_smoke", "status": "active" if lab == "satisfied" else "blocked", "detail": lab_d},
    ],
  })
doc = {
  "schema": "cynic.runtime_proof_bundle.v1",
  "status": bundle,
  "proofs": proofs,
  "rules": [
    "proofs are produced by executable tests/smoke, not hand-written green badges",
    "unknown lab evidence is omitted rather than faked",
  ],
}
open(out, "w").write(json.dumps(doc, indent=2) + "\n")
import os
if os.environ.get("CYNIC_EVIDENCE_BUNDLE_VERBOSE") == "1":
    print(out)
    print("bundle_status", bundle, "arch", arch, "lab", lab)
PY
