{
  "schema": "cynic.secret_patterns.v1",
  "version": "1.0.0",
  "description": "Patterns scanned in PR diffs by cynic-vcs::secret_lint. Updated without recompilation.",
  "patterns": [
    {
      "id": "github_pat",
      "name": "GitHub personal access token",
      "regex": "ghp_[A-Za-z0-9]{36,}",
      "severity": "critical"
    },
    {
      "id": "github_fine_grained",
      "name": "GitHub fine-grained token",
      "regex": "github_pat_[A-Za-z0-9_]{82,}",
      "severity": "critical"
    },
    {
      "id": "openai_key",
      "name": "OpenAI API key",
      "regex": "sk-[A-Za-z0-9]{48,}",
      "severity": "critical"
    },
    {
      "id": "aws_access_key",
      "name": "AWS access key ID",
      "regex": "AKIA[0-9A-Z]{16}",
      "severity": "critical"
    },
    {
      "id": "generic_secret_assignment",
      "name": "Hardcoded secret assignment",
      "regex": "(?i)(password|secret|token|api_key|apikey)\\s*[:=]\\s*[\"'][^\"']{8,}[\"']",
      "severity": "high"
    },
    {
      "id": "private_key_header",
      "name": "Private key header",
      "regex": "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
      "severity": "critical"
    }
  ]
}
