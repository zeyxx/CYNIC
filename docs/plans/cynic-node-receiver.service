[Unit]
Description=CYNIC Node Receiver (control plane :9090, build_runner)
After=network.target

[Service]
User=cynic
WorkingDirectory=/var/lib/cynic
ExecStart=/var/lib/cynic/bin/cynic-node control --config /var/lib/cynic/node-control.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
