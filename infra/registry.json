{
  "version": 1,
  "schema": "cynic.registry.v1.minimal",
  "purpose": "Minimal runtime placement registry for the rebuilt low-layer organism.",
  "nodes": [
    {
      "id": "local-kernel",
      "name": "local-kernel",
      "role": "kernel_primary",
      "status": "candidate",
      "deploy_target": true,
      "network": {
        "synapse": "127.0.0.1"
      },
      "services": [
        {
          "name": "cynic-kernel",
          "artifact": "cynic-kernel",
          "port": 3030,
          "unit": "cynic-kernel.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "tcp",
            "port": 3030
          }
        },
        {
          "name": "cynic-node",
          "artifact": "cynic-node",
          "unit": "cynic-node.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "process",
            "process": "cynic-node"
          }
        },
        {
          "name": "surrealdb",
          "unit": "surrealdb.service",
          "port": 8000,
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "tcp",
            "port": 8000
          }
        }
      ]
    },
    {
      "id": "local-builder",
      "name": "local-builder",
      "aliases": [
        "ubuntu"
      ],
      "role": "build_runner",
      "status": "candidate",
      "deploy_target": false,
      "network": {
        "synapse": "127.0.0.1"
      },
      "services": []
    }
  ],
  "lifecycle": {
    "kernel_release": {
      "build_runner_role": "build_runner",
      "deploy_target_role": "kernel_primary",
      "host_bootstrap": {
        "role_profiles": {
          "kernel_primary": {
            "target_stage": "h6_host_actionable",
            "required_domains": [
              "host",
              "services",
              "storage",
              "kernel"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "kernel_service_observed",
              "storage_health_observed"
            ]
          },
          "build_runner": {
            "target_stage": "h4_privilege_helpers_ready",
            "required_domains": [
              "host",
              "toolchain",
              "build"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "cargo_check_observed",
              "binary_build_observed"
            ]
          },
          "storage_primary": {
            "target_stage": "h5_services_projected",
            "required_domains": [
              "host",
              "storage"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "storage_health_observed"
            ]
          }
        }
      },
      "runtime_artifacts": [
        "cynic-kernel",
        "cynic-node",
        "cynic-mcp",
        "cynic"
      ]
    }
  }
}
