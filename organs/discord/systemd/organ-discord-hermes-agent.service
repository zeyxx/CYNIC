[Unit]
Description=CYNIC Organ Discord Hermes Agent - Discord surface manager
After=cynic-kernel.service discord-passive-proxy.service hermes-agent-executor.service
Wants=cynic-kernel.service discord-passive-proxy.service

[Service]
Type=simple
WorkingDirectory=%h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC
EnvironmentFile=%h/.config/cynic/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC/services/cynic-python
Environment=HERMES_AGENT_DOMAIN_ALLOW=discord
Environment=HERMES_AGENT_KIND_ALLOW=hermes
Environment=HERMES_AGENT_POLL_LIMIT=100
Environment=X_ORGAN_DIR=%h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC/organs/discord/state
ExecStartPre=/usr/bin/install -Dm644 %h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC/organs/discord/state/SKILL.md %h/.cynic/organs/discord/SKILL.md
ExecStart=/usr/bin/python3 -m organs.core.daemon --organ-dir %h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC/organs/discord/state --interval 30
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
