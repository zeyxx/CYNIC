{
  "$schema": "cynic.agent-exposure.v1",
  "version": 1,
  "description": "Single source of truth for organism capabilities exposed to cortex agents.",
  "policy": {
    "secrets": "Do not store real endpoints, API keys, cookies, wallet secrets, or personal account data in this file.",
    "mutation_default": "approval_required",
    "transport_preference": [
      "mcp_stdio",
      "kernel_rest_fallback"
    ]
  },
  "projection_targets": {
    "codex": ".codex/config.toml",
    "claude": ".mcp.json",
    "antigravity": ".antigravity/settings.json"
  },
  "mcp_tool_domains": {
    "coordination": {
      "description": "Agent/session coordination, claims, releases, and cross-agent coordination records.",
      "fallback_tools": [
        "cynic_coord_register",
        "cynic_coord_who",
        "cynic_coord_claim",
        "cynic_coord_claim_batch",
        "cynic_coord_release"
      ],
      "tools": [
        "cynic_coord_register",
        "cynic_coord_who",
        "cynic_coord_claim",
        "cynic_coord_claim_batch",
        "cynic_coord_release",
        "coordination_contract_manifest",
        "coordination_status_publish",
        "coordination_status_read",
        "coordination_thread_reply",
        "coordination_artifact_share",
        "coordination_decision_record"
      ]
    },
    "memory_tasks": {
      "description": "Durable task memory, research/library observations, task claims, completion, and audit reads. Research notes should flow through cynic_observe/cynic_audit_query instead of repo-local Markdown snapshots.",
      "fallback_tools": [
        "cynic_observe",
        "cynic_library_query",
        "cynic_dispatch_agent_task",
        "cynic_list_pending_agent_tasks",
        "cynic_watch_pending_agent_tasks",
        "cynic_list_completed_agent_tasks",
        "cynic_claim_agent_task",
        "cynic_update_agent_task_result"
      ],
      "tools": [
        "cynic_observe",
        "cynic_library_query",
        "cynic_dispatch_agent_task",
        "cynic_list_pending_agent_tasks",
        "cynic_watch_pending_agent_tasks",
        "cynic_list_completed_agent_tasks",
        "cynic_claim_agent_task",
        "cynic_update_agent_task_result",
        "cynic_audit_query"
      ]
    },
    "lifecycle": {
      "description": "Registry-derived lifecycle dry-runs and dispatches. Dispatch must prove task read-back.",
      "fallback_tools": [
        "cynic_lifecycle_status",
        "cynic_lifecycle_payloads",
        "cynic_lifecycle_dispatch"
      ],
      "tools": [
        "cynic_lifecycle_status",
        "cynic_lifecycle_payloads",
        "cynic_lifecycle_dispatch"
      ]
    },
    "organism_status": {
      "description": "Organism health, attention, metabolism, API contracts, identity attestation, and read-only service status.",
      "fallback_tools": [
        "cynic_attention",
        "cynic_health"
      ],
      "tools": [
        "cynic_api_contracts",
        "cynic_mcp_surface",
        "cynic_attention",
        "cynic_health",
        "cynic_metabolism",
        "identity_attest",
        "identity_smoke_check",
        "service_status",
        "service_health",
        "storage_primary_status"
      ]
    },
    "infra_read_only": {
      "description": "Read-only registry, IPAM, mesh, fleet, bridge, and storage readiness inspection.",
      "tools": [
        "infra_registry_read",
        "infra_registry_validate",
        "network_ipam_check",
        "network_mesh_dns_render",
        "network_mesh_status",
        "network_mesh_provider_fallback_hosts",
        "network_mesh_provider_fallback_status",
        "network_mesh_dns_activation_plan",
        "network_mesh_dns_activation_status",
        "fleet_node_status",
        "lxc_exec_bridge_plan",
        "lxc_exec_bridge_status",
        "storage_primary_plan",
        "storage_primary_readiness"
      ]
    },
    "infra_controlled_mutation": {
      "description": "Controlled infrastructure mutation surfaces. These remain approval-gated and are not part of the Python fallback.",
      "tools": [
        "network_mesh_dns_activation_bundle",
        "lxc_exec_bridge_bundle",
        "fleet_node_exec",
        "storage_primary_bundle"
      ]
    }
  },
  "mcp_servers": [
    {
      "name": "cynic-coord",
      "description": "CYNIC kernel coordination and organism control plane.",
      "command": "python3",
      "args": [
        "./.cortex/mcp/run_cynic_mcp.py"
      ],
      "status": "active",
      "agents": [
        "codex",
        "claude",
        "antigravity"
      ],
      "tools": [
        {
          "name": "cynic_api_contracts",
          "approval_mode": "auto"
        },
        {
          "name": "cynic_mcp_surface",
          "approval_mode": "auto"
        },
        {
          "name": "cynic_attention",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_health",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_dispatch_agent_task",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_coord_register",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_list_pending_agent_tasks",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_watch_pending_agent_tasks",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_list_completed_agent_tasks",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_coord_claim_batch",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_observe",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_library_query",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_coord_release",
          "approval_mode": "approve"
        },
      {
        "name": "cynic_coord_who",
        "approval_mode": "approve"
      },
      {
        "name": "cynic_lifecycle_status",
        "approval_mode": "approve"
      },
      {
        "name": "cynic_lifecycle_payloads",
        "approval_mode": "approve"
        },
        {
          "name": "cynic_lifecycle_dispatch",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_contract_manifest",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_status_publish",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_status_read",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_thread_reply",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_artifact_share",
          "approval_mode": "approve"
        },
        {
          "name": "coordination_decision_record",
          "approval_mode": "approve"
        },
        {
          "name": "infra_registry_read",
          "approval_mode": "approve"
        },
        {
          "name": "infra_registry_validate",
          "approval_mode": "auto"
        },
        {
          "name": "network_ipam_check",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_dns_render",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_status",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_provider_fallback_hosts",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_provider_fallback_status",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_dns_activation_plan",
          "approval_mode": "auto"
        },
        {
          "name": "network_mesh_dns_activation_bundle",
          "approval_mode": "approve"
        },
        {
          "name": "network_mesh_dns_activation_status",
          "approval_mode": "auto"
        },
        {
          "name": "fleet_node_status",
          "approval_mode": "approve"
        },
        {
          "name": "lxc_exec_bridge_plan",
          "approval_mode": "auto"
        },
        {
          "name": "lxc_exec_bridge_bundle",
          "approval_mode": "approve"
        },
        {
          "name": "lxc_exec_bridge_status",
          "approval_mode": "auto"
        },
        {
          "name": "fleet_node_exec",
          "approval_mode": "approve"
        },
        {
          "name": "service_status",
          "approval_mode": "auto"
        },
        {
          "name": "service_health",
          "approval_mode": "approve"
        },
        {
          "name": "storage_primary_plan",
          "approval_mode": "approve"
        },
        {
          "name": "storage_primary_bundle",
          "approval_mode": "approve"
        },
        {
          "name": "storage_primary_readiness",
          "approval_mode": "approve"
        },
        {
          "name": "storage_primary_status",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_audit_query",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_coord_claim",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_metabolism",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_update_agent_task_result",
          "approval_mode": "approve"
        },
        {
          "name": "cynic_claim_agent_task",
          "approval_mode": "approve"
        },
        {
          "name": "identity_attest",
          "approval_mode": "auto",
          "_comment": "Returns credential group attestation (presence + shape + commitment). Values never included."
        },
        {
          "name": "identity_smoke_check",
          "approval_mode": "approve",
          "_comment": "Live API liveness check for porkbun and cloudflare credentials."
        }
      ]
    },
    {
      "name": "cynic-browser",
      "description": "Policy-wrapped organ-browser MCP surface over the Browser Hub and Hermes-compatible tools.",
      "command": "python3",
      "args": [
        "./.cortex/mcp/run_browser_mcp.py"
      ],
      "status": "active",
      "agents": [
        "codex",
        "claude",
        "antigravity"
      ],
      "requires": [
        "organ-browser.service",
        "organ-browser-hub.service"
      ],
      "tools": [
        {
          "name": "browser_policy",
          "approval_mode": "auto"
        },
        {
          "name": "browser_status",
          "approval_mode": "auto"
        },
        {
          "name": "browser_tabs",
          "approval_mode": "auto"
        },
        {
          "name": "browser_task_state",
          "approval_mode": "auto"
        },
        {
          "name": "browser_snapshot",
          "approval_mode": "auto"
        },
        {
          "name": "browser_render_public_url",
          "approval_mode": "approve"
        },
        {
          "name": "browser_navigate",
          "approval_mode": "approve"
        },
        {
          "name": "browser_scroll",
          "approval_mode": "approve"
        },
        {
          "name": "browser_back",
          "approval_mode": "approve"
        },
        {
          "name": "browser_get_images",
          "approval_mode": "approve"
        },
        {
          "name": "browser_vision",
          "approval_mode": "approve"
        },
        {
          "name": "browser_console",
          "approval_mode": "approve"
        },
        {
          "name": "browser_cdp",
          "approval_mode": "approve"
        },
        {
          "name": "browser_dialog",
          "approval_mode": "approve"
        },
        {
          "name": "browser_click",
          "approval_mode": "approve"
        },
        {
          "name": "browser_type",
          "approval_mode": "approve"
        }
      ]
    },

    {
      "name": "cynic-docker",
      "description": "Native Docker integration allowing CYNIC agents to inspect and manage invisible local containers.",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ],
      "status": "active",
      "agents": [
        "codex",
        "claude",
        "antigravity"
      ],
      "tools": [
        {
          "name": "docker_container_list",
          "approval_mode": "auto"
        },
        {
          "name": "docker_container_logs",
          "approval_mode": "auto"
        },
        {
          "name": "docker_container_inspect",
          "approval_mode": "auto"
        }
      ]
    }
  ]
}
