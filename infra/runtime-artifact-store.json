{
  "schema": "cynic.runtime_artifact_store.v1",
  "status": "normative",
  "purpose": "Single Source of Truth for runtime binary artifact publication, verification, and distribution across the CYNIC fleet.",
  "endpoint": {
    "host": "10.10.10.103",
    "port": 8443,
    "base_url": "http://10.10.10.103:8443",
    "protocol": "http",
    "service_unit": "runtime-artifact-store.service"
  },
  "storage": {
    "root_directory": "/data/runtime-releases",
    "latest_symlink": "/data/runtime-releases/latest",
    "version_layout": "/data/runtime-releases/{version}"
  },
  "ingestion": {
    "authorized_publishers": [
      {
        "node": "cynic-builder",
        "ip": "10.10.10.119",
        "method": "ssh_scp",
        "target_path": "/data/runtime-releases/{version}"
      }
    ],
    "required_artifacts": [
      "cynic",
      "SHA256SUMS"
    ]
  },
  "verification": {
    "checksum_file": "SHA256SUMS",
    "algorithm": "sha256",
    "download_template": "http://10.10.10.103:8443/latest/{binary_name}"
  }
}
