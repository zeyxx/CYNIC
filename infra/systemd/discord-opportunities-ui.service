[Unit]
Description=CYNIC Discord opportunities UI
After=discord-pipeline.service

[Service]
Type=simple
WorkingDirectory=%h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC
Environment=DISCORD_DB_PATH=%h/.cynic/organs/discord/messages.db
Environment=DISCORD_UI_HOST=127.0.0.1
Environment=DISCORD_UI_PORT=8891
ExecStart=/usr/bin/python3 -m organs.discord.src.ui
Restart=on-failure
RestartSec=10
MemoryMax=256M

[Install]
WantedBy=default.target
