#!/usr/bin/env bash
# scripts/disk-audit — disk usage cartography for CYNIC hosts
# Usage: ./scripts/disk-audit [--json] [--depth N] [--root PATH]
#
# Outputs a structured report of disk usage, top consumers, and cleanup hints.
# Machine-readable JSON with --json flag; human text otherwise.

set -euo pipefail

# ── defaults ────────────────────────────────────────────────────────────────
DEPTH="${DISK_AUDIT_DEPTH:-3}"
ROOT="${DISK_AUDIT_ROOT:-/}"
JSON=0
TOP_N=40
REPORT_FILE=""

# ── arg parsing ─────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)        JSON=1; shift ;;
    --depth)       DEPTH="$2"; shift 2 ;;
    --root)        ROOT="$2"; shift 2 ;;
    --top)         TOP_N="$2"; shift 2 ;;
    --out)         REPORT_FILE="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: disk-audit [--json] [--depth N] [--root PATH] [--top N] [--out FILE]"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done

# ── helpers ──────────────────────────────────────────────────────────────────
bytes() {
  # convert human-readable du output to bytes
  local val="$1"
  local num="${val//[^0-9.]/}"
  case "$val" in
    *T) echo "$(python3 -c "print(int($num*1024**4))" 2>/dev/null || echo 0)" ;;
    *G) echo "$(python3 -c "print(int($num*1024**3))" 2>/dev/null || echo 0)" ;;
    *M) echo "$(python3 -c "print(int($num*1024**2))" 2>/dev/null || echo 0)" ;;
    *K) echo "$(python3 -c "print(int($num*1024))" 2>/dev/null || echo 0)" ;;
    *)  echo "${num:-0}" ;;
  esac
}

require() { command -v "$1" &>/dev/null || { echo "MISSING: $1" >&2; exit 1; }; }
require du
require df

TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# ── filesystem overview ──────────────────────────────────────────────────────
FS_LINES=$(df -h --output=source,fstype,size,used,avail,pcent,target 2>/dev/null | tail -n +2)

# ── top directories ──────────────────────────────────────────────────────────
SUDO_CMD=""
[[ "$ROOT" == "/" ]] && SUDO_CMD="sudo"

TOP_DIRS=$(${SUDO_CMD} du -h --max-depth="${DEPTH}" "${ROOT}" 2>/dev/null \
  | sort -rh \
  | head -n "${TOP_N}")

# ── large files (>100 MB) ────────────────────────────────────────────────────
LARGE_FILES=$(${SUDO_CMD} find "${ROOT}" -xdev -type f -size +100M \
  -printf '%s\t%p\n' 2>/dev/null \
  | sort -rn \
  | head -n "${TOP_N}" \
  | awk '{
      size=$1
      path=$2
      if (size >= 1073741824)      printf "%.1fG\t%s\n", size/1073741824, path
      else if (size >= 1048576)    printf "%.1fM\t%s\n", size/1048576, path
      else                         printf "%.1fK\t%s\n", size/1024, path
    }')

# ── docker / container storage ───────────────────────────────────────────────
DOCKER_INFO=""
if command -v docker &>/dev/null; then
  DOCKER_INFO=$(docker system df 2>/dev/null || echo "docker system df failed")
fi

# ── package / build caches ───────────────────────────────────────────────────
CACHES=()
declare -A CACHE_MAP
check_cache() {
  local label="$1" path="$2"
  if [[ -d "$path" ]]; then
    local sz
    sz=$(du -sh "$path" 2>/dev/null | cut -f1)
    CACHES+=("$label|$path|$sz")
  fi
}

check_cache "cargo-registry"    "${CARGO_HOME:-$HOME/.cargo}/registry"
check_cache "cargo-git"         "${CARGO_HOME:-$HOME/.cargo}/git"
check_cache "cargo-target"      "$HOME/Bureau/SOLANA/asdf-forge/zeyxx/CYNIC/target"
check_cache "npm-cache"         "$HOME/.npm"
check_cache "pip-cache"         "${XDG_CACHE_HOME:-$HOME/.cache}/pip"
check_cache "uv-cache"          "${XDG_CACHE_HOME:-$HOME/.cache}/uv"
check_cache "apt-cache"         "/var/cache/apt/archives"
check_cache "journal-logs"      "/var/log/journal"
check_cache "docker-overlay"    "/var/lib/docker"
check_cache "lxc-storage"       "/var/lib/lxc"
check_cache "libvirt-images"    "/var/lib/libvirt/images"
check_cache "flatpak"           "/var/lib/flatpak"
check_cache "snap"              "/var/lib/snapd"
check_cache "nix-store"         "/nix/store"
check_cache "trash"             "$HOME/.local/share/Trash"
check_cache "hf-cache"          "${HF_HOME:-$HOME/.cache/huggingface}"
check_cache "ollama-models"     "$HOME/.ollama"
check_cache "llama-models"      "/var/lib/cynic/models"
check_cache "gemini-data"       "$HOME/.gemini"
check_cache "antigravity-data"  "$HOME/.gemini/antigravity-cli"
check_cache "xdg-cache"         "${XDG_CACHE_HOME:-$HOME/.cache}"
check_cache "thumbnails"        "$HOME/.cache/thumbnails"

# ── produce output ────────────────────────────────────────────────────────────
emit_human() {
  echo "════════════════════════════════════════════════════════════"
  echo "  CYNIC DISK AUDIT — $TS"
  echo "════════════════════════════════════════════════════════════"
  echo ""
  echo "── Filesystem Overview ──────────────────────────────────────"
  df -h --output=source,fstype,size,used,avail,pcent,target 2>/dev/null
  echo ""
  echo "── Top ${TOP_N} Directories (depth=${DEPTH}, root=${ROOT}) ──────────────"
  echo "$TOP_DIRS"
  echo ""
  echo "── Large Files (>100 MB) ────────────────────────────────────"
  if [[ -n "$LARGE_FILES" ]]; then
    echo "$LARGE_FILES"
  else
    echo "(none found)"
  fi
  echo ""
  echo "── Known Caches & Build Artifacts ──────────────────────────"
  printf "%-30s %-12s %s\n" "LABEL" "SIZE" "PATH"
  printf "%-30s %-12s %s\n" "-----" "----" "----"
  for entry in "${CACHES[@]}"; do
    IFS='|' read -r label path sz <<< "$entry"
    printf "%-30s %-12s %s\n" "$label" "$sz" "$path"
  done
  echo ""
  if [[ -n "$DOCKER_INFO" ]]; then
    echo "── Docker Storage ───────────────────────────────────────────"
    echo "$DOCKER_INFO"
    echo ""
  fi
  echo "── Cleanup Hints ────────────────────────────────────────────"
  echo "  cargo clean:      cd CYNIC && cargo clean"
  echo "  cargo prune:      cargo cache -a  (cargo-cache crate)"
  echo "  apt clean:        sudo apt clean && sudo apt autoremove -y"
  echo "  journal vacuum:   sudo journalctl --vacuum-size=200M"
  echo "  docker prune:     docker system prune -af --volumes"
  echo "  pip cache:        pip cache purge"
  echo "  uv cache:         uv cache clean"
  echo "  hf cache:         huggingface-cli delete-cache"
  echo "  trash:            rm -rf ~/.local/share/Trash/*"
  echo ""
}

emit_json() {
  # build caches array
  local caches_json="["
  local first=1
  for entry in "${CACHES[@]}"; do
    IFS='|' read -r label path sz <<< "$entry"
    [[ $first -eq 0 ]] && caches_json+=","
    caches_json+="{\"label\":\"$label\",\"path\":\"$path\",\"size_human\":\"$sz\"}"
    first=0
  done
  caches_json+="]"

  # build large files array
  local files_json="["
  local first2=1
  while IFS=$'\t' read -r sz path; do
    [[ -z "$path" ]] && continue
    [[ $first2 -eq 0 ]] && files_json+=","
    # escape quotes in path
    path="${path//\"/\\\"}"
    files_json+="{\"size_human\":\"$sz\",\"path\":\"$path\"}"
    first2=0
  done <<< "$LARGE_FILES"
  files_json+="]"

  # filesystem json
  local fs_json="["
  local first3=1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    read -r src fstype size used avail pct mnt <<< "$line"
    [[ $first3 -eq 0 ]] && fs_json+=","
    fs_json+="{\"source\":\"$src\",\"fstype\":\"$fstype\",\"size\":\"$size\",\"used\":\"$used\",\"avail\":\"$avail\",\"use_pct\":\"$pct\",\"mount\":\"$mnt\"}"
    first3=0
  done <<< "$FS_LINES"
  fs_json+="]"

  cat <<EOF
{
  "kind": "disk_audit",
  "timestamp": "$TS",
  "root": "$ROOT",
  "depth": $DEPTH,
  "filesystems": $fs_json,
  "caches": $caches_json,
  "large_files": $files_json,
  "top_dirs_raw": $(echo "$TOP_DIRS" | python3 -c "import sys,json; lines=[l.split('\t',1) for l in sys.stdin.read().strip().split('\n') if l]; print(json.dumps([{'size':l[0],'path':l[1]} for l in lines if len(l)==2]))"),
  "docker_info": $(echo "$DOCKER_INFO" | python3 -c "import sys,json; print(json.dumps(sys.stdin.read().strip()))")
}
EOF
}

# ── render ────────────────────────────────────────────────────────────────────
OUTPUT=""
if [[ $JSON -eq 1 ]]; then
  OUTPUT=$(emit_json)
else
  OUTPUT=$(emit_human)
fi

if [[ -n "$REPORT_FILE" ]]; then
  echo "$OUTPUT" > "$REPORT_FILE"
  echo "Report saved to: $REPORT_FILE" >&2
else
  echo "$OUTPUT"
fi
