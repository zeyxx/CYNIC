    "organ_maturity_policy": {
        "allowed_statuses": [
            "canonical",
            "canonical_partial",
            "transitional",
            "embryonic",
            "quarantined",
            "legacy_blocked",
            "burn_candidate"
        ],
        "status_meanings": {
            "canonical": "Manifest-backed organ with declared boundary and complete required executable shape when applicable.",
            "canonical_partial": "Manifest-backed organ intentionally missing a bounded part while a concrete replacement/expiry is declared.",
            "transitional": "Existing behavior is tolerated with owner, replacement and expiry; new canonical behavior must not be added here.",
            "embryonic": "Directory exists as an undifferentiated organ seed; it must either gain a manifest/shape or be folded into another organ.",
            "quarantined": "May be read for migration or deletion but must not receive new features.",
            "legacy_blocked": "Legacy path must fail closed except for explicitly guarded emergency fallback.",
            "burn_candidate": "No durable role is proven; deletion or absorption is the preferred outcome."
        },
        "minimum_exception_fields": [
            "path",
            "status",
            "owner",
            "replacement",
            "expiry_condition"
        ],
        "shape_exception_fields": [
            "path",
            "status",
            "owner",
            "missing_paths",
            "replacement",
            "expiry_condition"
        ],
        "rule": "Every non-canonical organ state must use an allowed maturity status and carry owner, replacement and expiry evidence."
    }
