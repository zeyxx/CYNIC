[Unit]
Description=CYNIC Hermes Navigator — UCB1-guided organic browsing
After=hermes-browser.service
Wants=hermes-browser.service
PartOf=hermes-organism.target

[Service]
EnvironmentFile=%h/.config/cynic/env
Type=oneshot
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=@CYNIC_PROJECT_ROOT@"
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py navigator \
    --organ-dir %h/.cynic/organs/hermes/x \
    --budget 5
TimeoutStartSec=300
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-navigator

[Install]
WantedBy=timers.target
