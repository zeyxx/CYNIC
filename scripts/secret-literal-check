#!/usr/bin/env bash
set -euo pipefail

# Fail without echoing suspected material. This gate intentionally scans only
# Git-tracked source: runtime secret files are outside the repository authority.
patterns=(
  '(api[_-]?key|token|secret|password)[[:space:]]*=[[:space:]]*"[A-Za-z0-9_./+:-]{24,}"'
  '"--(api-key|token|secret|password)"[[:space:]]*,[[:space:]]*"[A-Za-z0-9_./+:-]{24,}"'
)

findings=()
for pattern in "${patterns[@]}"; do
  while IFS= read -r location; do
    [[ -n "${location}" ]] && findings+=("${location}")
  done < <(git grep -nIE "${pattern}" -- . 2>/dev/null | cut -d: -f1-2 || true)
done

if ((${#findings[@]} > 0)); then
  printf '%s\n' "tracked source contains suspected literal credentials:" >&2
  printf '  %s: secret value redacted\n' "${findings[@]}" | sort -u >&2
  exit 1
fi

echo "tracked-source secret literal check passed"
