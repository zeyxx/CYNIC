[Unit]
Description=Organ Fleet - Hermes Autonomous Agent
After=network.target cynic-kernel.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.cynic-env
ExecStart=/usr/bin/python3 %h/.cynic/repos/CYNIC/organs/forge/src/dispatch.py fleet
Restart=always
RestartSec=10
WorkingDirectory=%h/.cynic/repos/CYNIC

[Install]
WantedBy=default.target
