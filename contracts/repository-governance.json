{
  "schema": "cynic.repository_governance.v1",
  "status": "normative",
  "policy": "deny_by_default",
  "description": "Constitutional repository tree governance: fail-closed admission policy, explicit whitelists and blacklists.",
  "root_admission": {
    "allowed_directories": [
      ".cargo",
      ".codex",
      ".github",
      "apps",
      "contracts",
      "crates",
      "docs",
      "infra",
      "programs",
      "tests"
    ],
    "allowed_files": [
      ".antigravityignore",
      ".gitattributes",
      ".gitignore",
      ".gitleaks.toml",
      ".mcp.cynic-gpu.json",
      ".mcp.json",
      "AGENTS.md",
      "CODEX.md",
      "CONTRIBUTING.md",
      "Cargo.lock",
      "Cargo.toml",
      "LICENSE",
      "Makefile",
      "README.md",
      "SECURITY.md",
      "clippy.toml",
      "deny.toml",
      "env.example",
      "rust-toolchain.toml",
      "rustfmt.toml"
    ]
  },
  "forbidden_roots": [
    "archive",
    "benchmarks",
    "data_system",
    "evidence",
    "references",
    "scripts",
    "specs",
    "vault"
  ],
  "blacklisted_file_patterns": [
    "*.bin",
    "*.db",
    "*.docx",
    "*.dll",
    "*.exe",
    "*.jsonl",
    "*.log",
    "*.pdf",
    "*.pptx",
    "*.so",
    "*.sqlite",
    "*.tar",
    "*.tar.gz",
    "*.tmp",
    "*.xlsx",
    "*.zip",
    ".agent-claims.json",
    ".env",
    ".env.*"
  ],
  "enforcement": {
    "gate_test": "crates/cynic-cli/tests/repository_governance.rs",
    "action_on_violation": "fail_closed"
  }
}
