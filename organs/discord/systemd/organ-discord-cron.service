[Unit]
Description=CYNIC Organ Discord Cron - dispatch Discord surface task
After=cynic-kernel.service organ-discord-hermes-agent.service
Wants=organ-discord-hermes-agent.service

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/discord/src/dispatch.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
