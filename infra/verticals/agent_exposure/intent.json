{
  "schema": "cynic.vertical_intent.v1",
  "vertical": "agent_exposure",
  "layer": "adapter",
  "owner_crate": "cynic-cli",
  "desired_state": {
    "schema": "cynic.agent_exposure.desired_state.v1",
    "responsibility": "Expose CYNIC runtime capabilities to agents through the CLI surface under explicit policy, capability, and human-in-the-loop boundaries.",
    "anti_responsibilities": [
      "grant mutation authority by implication",
      "hide principal or harness preconditions",
      "treat unknown surfaces as safe by default",
      "expose secret values through CLI tool output"
    ],
    "canonical_entrypoints": [
      "cynic dev agent-exposure --json",
      "cynic runtime agents --json",
      "cynic runtime hermes-run --json"
    ],
    "policy": {
      "protocol_profile": "cynic-runtime v1",
      "human_in_the_loop": "required_for_mutating_tools",
      "capability_boundary": "read_back_before_mutation"
    }
  },
  "code_contract": {
    "types": ["AgentExposurePolicy"],
    "required_fields": ["canonical_entrypoints", "policy"],
    "modules": ["cynic-cli::agent_exposure"]
  },
  "observe": {
    "port": "AgentExposureObservationPort",
    "adapter": "cynic-cli::agent_exposure",
    "reports": ["AgentExposureAudit"]
  },
  "reconcile": "pure decision from desired_state.agent_exposure vs observed AgentExposureAudit; assert every mutating tool requires explicit human confirmation and no secret exposure",
  "bounded_action": {
    "argv": "cynic dev agent-exposure --json",
    "mutates": false,
    "authority": "none",
    "rollback_intent": []
  },
  "read_back_proof": {
    "poh_checkpoint": { "schema": "cynic.poh_checkpoint_batch.v1", "onchain": false },
    "dns_proof": { "schema": "cynic.runtime_network_preflight.v1", "external_proof": true },
    "maturity_percent_min": 80,
    "known_coverage_percent_min": 60
  }
}
