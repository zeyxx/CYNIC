{
  "schema": "cynic.organ_layer_topology.v1",
  "status": "normative",
  "purpose": "Define the stable rank and layer vocabulary for organs so every persistent subsystem has one primary layer and the body can be reasoned about without ad-hoc grouping.",
  "authorities": {
    "human_readable_policy": "docs/foundation/CYNIC_REPO_TOPOLOGY_POLICY.md",
    "policy_matrix": "docs/foundation/CYNIC_ORGANISM_POLICY_MATRIX.md",
    "organ_maturity_inventory": "axioms/organ-maturity-inventory-v1.json"
  },
  "symbolic_vocabulary": {
    "Keter": "source intent, organism purpose and policy crown",
    "Chokhmah": "generative novelty, hypothesis and expansion pressure",
    "Binah": "bounded form, contract, schema and structure",
    "Chesed": "capacity, delegation and resource expansion",
    "Gevurah": "constraint, admission control, claim, refusal and security",
    "Tiferet": "integration, balanced judgement and coherent routing",
    "Netzach": "execution, endurance and operational persistence",
    "Hod": "protocol, interface, language and adapter surface",
    "Yesod": "foundation, bridge, queue and state transmission",
    "Malkhut": "manifest runtime, process, file, socket and visible effect"
  },
  "layer_policy": {
    "ordering": "ascending_abstraction",
    "rank_meaning": "Lower ranks are closer to source of truth and governance; higher ranks are closer to external surfaces and human workspaces.",
    "required_fields": [
      "id",
      "rank",
      "name",
      "responsibility",
      "system_primitives",
      "symbolic_alignment",
      "must_not_own",
      "canonical_examples"
    ]
  },
  "layers": [
    {
      "id": "foundational_contract",
      "rank": 10,
      "name": "Foundational contract",
      "responsibility": "Own machine contracts, canonical vocabularies and the smallest stable source-of-truth surfaces.",
      "system_primitives": [
        "json schema",
        "contract validation",
        "content-addressed source file",
        "git object"
      ],
      "symbolic_alignment": [
        "Keter",
        "Binah"
      ],
      "must_not_own": [
        "runtime_state",
        "provider_secrets",
        "deployment_scripts"
      ],
      "canonical_examples": [
        "organs/contracts/"
      ],
      "parent_layer": null,
      "projection_kind": "fractal_rank"
    },
    {
      "id": "governance_control_plane",
      "rank": 20,
      "name": "Governance control plane",
      "responsibility": "Own policy decisions, supervision, admission control and structural coordination of the body.",
      "system_primitives": [
        "lease",
        "claim table",
        "admission check",
        "policy evaluator"
      ],
      "symbolic_alignment": [
        "Gevurah",
        "Tiferet",
        "Hod"
      ],
      "must_not_own": [
        "user_payloads",
        "mesh_config",
        "ui_copy"
      ],
      "canonical_examples": [
        "organs/supervisor/",
        "organs/exposure/",
        "organs/forge/"
      ],
      "parent_layer": "foundational_contract",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "fleet_orchestration",
      "rank": 30,
      "name": "Fleet orchestration",
      "responsibility": "Own lifecycle convergence, node placement, release choreography and fleet truth aggregation.",
      "system_primitives": [
        "scheduler",
        "systemd unit",
        "node inventory",
        "readiness probe"
      ],
      "symbolic_alignment": [
        "Netzach",
        "Tiferet",
        "Malkhut"
      ],
      "must_not_own": [
        "transport_payloads",
        "presentation_copy",
        "human_policy"
      ],
      "canonical_examples": [
        "organs/fleet/",
        "organs/lifecycle/"
      ],
      "parent_layer": "governance_control_plane",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "mesh_network",
      "rank": 40,
      "name": "Mesh network",
      "responsibility": "Own synapse connectivity, service reachability and DNS or mesh projection surfaces.",
      "system_primitives": [
        "socket",
        "route",
        "DNS record",
        "wireguard peer"
      ],
      "symbolic_alignment": [
        "Yesod",
        "Hod",
        "Malkhut"
      ],
      "must_not_own": [
        "business_rules",
        "presentation_workflows",
        "durable_app_state"
      ],
      "canonical_examples": [
        "organs/headscale/",
        "organs/wireguard/",
        "organs/freebox/"
      ],
      "parent_layer": "fleet_orchestration",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "storage_state",
      "rank": 50,
      "name": "Storage and state",
      "responsibility": "Own durable state, caches and retrieval memory that must survive a session.",
      "system_primitives": [
        "database transaction",
        "write-ahead log",
        "snapshot",
        "fsync"
      ],
      "symbolic_alignment": [
        "Yesod",
        "Binah"
      ],
      "must_not_own": [
        "policy_contracts",
        "mesh_routing",
        "user_interface_logic"
      ],
      "canonical_examples": [
        "organs/keep/",
        "organs/rag/"
      ],
      "parent_layer": "mesh_network",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "transport_integration",
      "rank": 60,
      "name": "Transport integration",
      "responsibility": "Own adapters to external services and protocol bridges without redefining organism policy.",
      "system_primitives": [
        "HTTP client",
        "API adapter",
        "browser session",
        "protocol shim"
      ],
      "symbolic_alignment": [
        "Hod",
        "Yesod"
      ],
      "must_not_own": [
        "canonical_policy",
        "kernel_memory",
        "deployment_authority"
      ],
      "canonical_examples": [
        "organs/browser/",
        "organs/twitter/",
        "organs/slack/",
        "organs/telegram/",
        "organs/discord/",
        "organs/domain/",
        "organs/gasdf/",
        "organs/percolator/"
      ],
      "parent_layer": "storage_state",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "observability_analysis",
      "rank": 70,
      "name": "Observability and analysis",
      "responsibility": "Own audits, scoring, derived insight and reporting surfaces that observe the body without becoming the body.",
      "system_primitives": [
        "metric",
        "log scan",
        "aggregation job",
        "report artifact"
      ],
      "symbolic_alignment": [
        "Chokhmah",
        "Tiferet",
        "Hod"
      ],
      "must_not_own": [
        "direct_provider_mutation_as_primary_role",
        "policy_authority",
        "presentation_state"
      ],
      "canonical_examples": [
        "organs/oracle/",
        "organs/radar/",
        "organs/reflection/",
        "organs/telemetry/",
        "organs/prompt-enricher/",
        "organs/framework-map/"
      ],
      "parent_layer": "transport_integration",
      "projection_kind": "fractal_rank"
    },
    {
      "id": "presentation_workspace",
      "rank": 80,
      "name": "Presentation and workspace",
      "responsibility": "Own user and operator facing workbenches, dashboards and interactive shells.",
      "system_primitives": [
        "UI process",
        "terminal session",
        "websocket",
        "rendered view"
      ],
      "symbolic_alignment": [
        "Malkhut",
        "Hod"
      ],
      "must_not_own": [
        "organism_policy",
        "kernel_memory",
        "mesh_routing"
      ],
      "canonical_examples": [
        "organs/kanban-ui/",
        "organs/jupyter/",
        "organs/superteam/"
      ],
      "parent_layer": "observability_analysis",
      "projection_kind": "fractal_rank"
    }
  ],
