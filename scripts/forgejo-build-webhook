#!/usr/bin/env bash
# ── forgejo-build-webhook ─────────────────────────────────────
#
# Forgejo webhook handler for the CYNIC distributed build.
#
# Triggered by a Forgejo push or pull-request webhook. Forgejo POSTs a
# JSON payload; this script extracts the exact source commit and triggers a
# distributed build on the network runner via `cynic build` (which uses the
# BuildRunnerPort → cynic-build-runner on 10.10.10.119).
#
# This is the "build as a side effect of a PR" surface (emergence B):
#   forgejo push/PR  →  webhook  →  this script  →  cynic build --commit <sha>
#
# Wire it behind any webhook receiver (e.g. `webhook`, caddy, nginx):
#   webhook --hooks forgejo-build-webhook.hooks.json --verbose
# where the hook passes the raw payload on stdin.
#
# Env:
#   CYNIC_BIN        path to the cynic CLI (default: cynic)
#   BUILD_PHASE      check|build|activate (default: check)
#   BUILD_NETWORK    offline|online (default: offline)
#   BUILD_HOST       runner SSH host (default: 10.10.10.119)
#   BUILD_USER       runner SSH user (default: cynic)
#   REQUIRE_BRANCH   only build this branch (default: any; e.g. main)

set -euo pipefail

CYNIC_BIN="${CYNIC_BIN:-cynic}"
BUILD_PHASE="${BUILD_PHASE:-check}"
BUILD_NETWORK="${BUILD_NETWORK:-offline}"
BUILD_HOST="${BUILD_HOST:-10.10.10.119}"
BUILD_USER="${BUILD_USER:-cynic}"
REQUIRE_BRANCH="${REQUIRE_BRANCH:-}"

# Read payload (stdin, or a file passed as $1)
if [[ -n "${1:-}" && -f "$1" ]]; then
  PAYLOAD="$(cat "$1")"
else
  PAYLOAD="$(cat)"
fi

extract() {
  # Minimal JSON field extraction (no jq dependency required, but prefer jq).
  local field="$1"
  if command -v jq >/dev/null 2>&1; then
    echo "$PAYLOAD" | jq -r "$field // empty"
  else
    # crude fallback: first "...field...":"value" occurrence
    echo "$PAYLOAD" | grep -o "\"$field\"[ ]*:[ ]*\"[^\"]*\"" | head -1 | sed -E "s/.*:[ ]*\"([^\"]*)\"/\1/"
  fi
}

# Pull request vs push
PR_SHA="$(extract '.pull_request.head.sha')"
PUSH_SHA="$(extract '.after')"
BRANCH="$(extract '.ref' | sed 's#refs/heads/##')"

COMMIT="${PR_SHA:-$PUSH_SHA}"

if [[ -z "$COMMIT" || "$COMMIT" == "null" ]]; then
  echo "forgejo-build-webhook: no commit SHA found in payload; skipping" >&2
  exit 0
fi

if [[ -n "$REQUIRE_BRANCH" && "$BRANCH" != "$REQUIRE_BRANCH" ]]; then
  echo "forgejo-build-webhook: branch '$BRANCH' != required '$REQUIRE_BRANCH'; skipping" >&2
  exit 0
fi

echo "forgejo-build-webhook: triggering build for commit $COMMIT (phase=$BUILD_PHASE branch=$BRANCH)" >&2

exec "$CYNIC_BIN" build trigger \
  --commit "$COMMIT" \
  --phase "$BUILD_PHASE" \
  --network-mode "$BUILD_NETWORK" \
  --host "$BUILD_HOST" \
  --user "$BUILD_USER" \
  --json
