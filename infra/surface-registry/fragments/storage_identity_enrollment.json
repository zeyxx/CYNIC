{
  "id": "storage_identity_enrollment",
  "layer": "l1_host_apply_boundary",
  "owner_crate": "cynic-host",
  "adapter_module": "cynic-host::host_exec_cli::storage_identity",
  "domain_owner": "cynic-protocol::storage_identity",
  "owner_modules": [
    "cynic-protocol::storage_identity",
    "cynic-host::storage_identity::enrollment",
    "cynic-host::storage_identity::port",
    "cynic-host::storage_identity::surreal_admin",
    "cynic-host::storage_identity::secret_adapter",
    "cynic-host::storage_identity::lease",
    "cynic-host::runtime_secret_install",
    "cynic-host::host_exec_cli::storage_identity",
    "cynic-host::host_exec_cli::storage_schema"
  ],
  "owner_call_markers": [
    "reconcile_storage_identity",
    "enroll_storage_identity",
    "StorageIdentitySecretPort"
  ],
  "responsibility": "Enroll one least-privilege SurrealDB runtime identity and, through a separate content-addressed HumanAdmin command, migrate schema before steady-state runtime startup.",
  "mutation_policy": "explicit_apply_only_with_bootstrap_human_admin_secret_on_stdin_and_ownership_proven_compensation",
  "canonical_entrypoints": [
    "cynic-host-exec storage-identity-enroll --endpoint <url> --namespace <ns> --database <db> --admin-user <user>",
    "cynic-host-exec storage-identity-enroll --endpoint <url> --namespace <ns> --database <db> --admin-user <user> --apply < admin-secret",
    "cynic-host-exec storage-schema-migrate --endpoint <url> --namespace <ns> --database <db> --admin-user <user> --schema-file <path> --expected-sha256 <digest> --apply < admin-secret"
  ],
  "evidence": [
    "cynic.storage_identity_spec.v1",
    "cynic.storage_identity_observation.v1",
    "cynic.storage_identity_plan.v1",
    "cynic.storage_identity_enrollment_report.v1",
    "cynic.runtime_secret_install_report.v1",
    "cynic.storage_schema_migration_report.v1"
  ],
  "anti_responsibilities": [
    "accept a runtime or administrator secret in argv, environment, JSON, or logs",
    "install or rotate the local credential independently of the database identity",
    "send administrator Basic authentication over non-loopback plaintext HTTP",
    "delete a database identity whose ownership cannot be proven by runtime authentication",
    "claim convergence before database role, local file metadata, and runtime authentication read-back",
    "grant DDL authority to the steady-state runtime identity or run schema bootstrap on kernel startup"
  ]
}
