{
  "schema_version": "1.0.0",
  "organ": "discord",
  "source_of_truth": "CYNIC/organs/discord/desired/discord-organ.json",
  "runtime": {
    "db_path": "~/.cynic/organs/discord/messages.db",
    "heartbeat_interval_seconds": 300,
    "capture_all_discord_metadata": true,
    "store_raw_events": false,
    "raw_event_allowlist": [],
    "retention": {
      "raw_days": 90
    }
  },
  "organ_contract": {
    "principle": "Discord is a graph of N guilds, N groups, N direct contacts, N channels, N messages, and N intents. The organ must structure that graph before any usecase-specific workflow consumes it.",
    "authoritative_runtime": "edge_capture_without_kernel_dependency",
    "personal_pc_role": "capture_and_queue_only",
    "browser_dependency": "exploration_only_not_correctness",
    "kernel_dependency": false,
    "storage_contract": {
      "operational_stream": "~/.cynic/organs/discord/messages.db",
      "format": "sqlite_wal",
      "single_writer": "discord_capture_daemon_or_importer",
      "readers": [
        "kernel_organ_port_when_available",
        "percolator_watch",
        "analysis_scripts",
        "manual_operator"
      ]
    },
    "normalization_contract": {
      "required_fields": [
        "captured_at_utc",
        "observed_at_utc",
        "observed_at_paris",
        "guild_id",
        "channel_id",
        "message_id",
        "author_hash_or_id",
        "content_text",
        "links",
        "github_refs",
        "classification",
        "sensitivity"
      ],
      "rule": "One raw Discord observation may feed multiple intents, but raw capture does not belong to any single bounty."
    },
    "failure_policy": {
      "personal_workstation_off": "always_on_or_next_available_node_continues_from_sqlite_and_queues",
      "local_inference_unavailable": "append_tasks_and_continue_deterministic_indexing",
      "browser_proxy_unavailable": "pipeline_correctness_degrades_but_contract_remains_valid",
      "kernel_unreachable": "record_unavailable_backend_and_keep_manual_gates"
    }
  },
  "proxy": {
    "mode": "chrome_managed_pac",
    "pac_url": "http://127.0.0.1:8892/proxy-policy.pac",
    "pac_file": "CYNIC/organs/discord/state/proxy-policy.pac",
    "mitmproxy_port": 8890,
    "pac_server_port": 8892,
    "policy": "intercept_target_api_routes_only"
  },
  "surfaces": {
    "servers": [
      {
        "server_id": "discord_server_1471242940801089668",
        "discord_guild_id": "1471242940801089668",
        "name": null,
        "category": "bounty",
        "capture_policy": "messages_allowlisted"
      }
    ],
    "channels": [
      {
        "channel_id": "discord_channel_1471256421998793022",
        "discord_channel_id": "1471256421998793022",
        "parent_id": "discord_server_1471242940801089668",
        "name": null,
        "kind": "text",
        "topic": "percolator_bounty_tracking",
        "capture_policy": "messages_allowlisted",
        "watch_profiles": ["percolator_bounty_watch"]
      },
      {
        "channel_id": "discord_channel_1471256414507765873",
        "discord_channel_id": "1471256414507765873",
        "parent_id": "discord_server_1471242940801089668",
        "name": null,
        "kind": "announcement",
        "topic": "percolator_announcements",
        "capture_policy": "messages_allowlisted",
        "watch_profiles": ["percolator_bounty_watch"]
      },
      {
        "channel_id": "discord_channel_1471256425631056059",
        "discord_channel_id": "1471256425631056059",
        "parent_id": "discord_server_1471242940801089668",
        "name": "github-feed",
        "kind": "text",
        "topic": "percolator_github_feed",
        "capture_policy": "messages_allowlisted",
        "watch_profiles": ["percolator_bounty_watch"]
      }
    ]
  },
  "watch_profiles": [
    {
      "watch_profile_id": "percolator_bounty_watch",
      "domain": "percolator",
      "feed": "percolator/ops/researcher-feed.json",
      "queue": "percolator/ops/infer-queue.jsonl",
      "rules": "percolator/notes/bounty-rules.json",
      "dedupe_policy": "strict",
      "kernel_dependency": false
    }
  ],
  "usecases": [
    {
      "usecase_id": "percolator-bounty",
      "intent": "Find real medium-critical Percolator vulnerabilities, avoid duplicate submissions, and prepare issue-first reports with proof.",
      "artifact_roots": {
        "researcher_feed": "percolator/ops/researcher-feed.json",
        "dedupe_brief": "percolator/ops/dedupe-brief.json",
        "finding_board": "percolator/ops/finding-board.json",
        "submission_queue": "percolator/ops/submissions/queue.json",
        "candidate_root": "percolator/audits/_candidates",
        "inference_queue": "percolator/ops/infer-queue.jsonl",
        "inference_state": "percolator/ops/infer-queue-state.json"
      },
      "manual_gates": [
        "no_github_issue_without_human_approval",
        "no_discord_post_without_human_approval",
        "no_high_or_critical_wording_without_concrete_impact_proof",
        "no_submission_with_unresolved_duplicate_overlap",
        "no_inference_output_as_sole_proof"
      ]
    }
  ]
}
