[Unit]
Description=CYNIC Hermes task runner — claims organ-local tasks and executes
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/cynic/env
Environment="X_ORGAN_DIR=%h/.cynic/organs/hermes/x"
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py task-runner --organ-dir $X_ORGAN_DIR --interval 10
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
