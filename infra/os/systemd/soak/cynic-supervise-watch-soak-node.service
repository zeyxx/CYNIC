[Unit]
Description=CYNIC soak watcher — consumer for the soak parent heartbeat
After=network-online.target cynic-supervise-soak-node.service
Wants=network-online.target cynic-supervise-soak-node.service
# Consumer records only, never restarts. See infra/os/systemd/soak/README.md.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Polls the soak status file every 5s, appends one JSON line per verdict
# change plus an hourly fresh confirmation. Stale past 2x the 5s producer
# cadence cap. Independent unit so a dead parent is still recorded.
Type=simple
# User=/Group= are deliberately absent. These units are installed in the
# systemd user scope (this account's own manager, enabled by Linger),
# which already runs as this account. A User=/Group= line there is
# invalid: the service exits 216 (EXIT_GROUP) before it ever starts.
# Measured: 216/GROUP with the line, 0/active without it.
WorkingDirectory=/var/lib/cynic
# The binary lives outside the Cargo tree on purpose: a build in the
# shared target directory replaces the file a running unit executes,
# which is a service-under-a-reclaimable-path failure.
#
# /var/lib/cynic/bin/cynic is the operator entry point that symlinks to
# current/ (infra/directory-tree.json, runtime_install.layer): the
# release is versioned under releases/ and the switch is a symlink, so
# a unit restart picks up a new release instead of a rebuilt cache file.
ExecStart=/var/lib/cynic/bin/cynic supervise watch --role node --status-file /var/lib/cynic/supervise-soak/node.status.json --ledger-file /var/lib/cynic/supervise-soak/watch.jsonl --poll-interval-secs 5 --stale-after-ms 10000 --confirm-interval-secs 3600
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=10
LimitNOFILE=16384
MemoryMax=128M

[Install]
WantedBy=default.target
