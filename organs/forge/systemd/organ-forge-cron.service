[Unit]
Description=CYNIC Organ Forge Cron - dispatch repo lifecycle task
After=cynic-kernel.service organ-forge-hermes-agent.service
Wants=organ-forge-hermes-agent.service

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/forge/src/entrypoints/cli.py audit
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/forge/src/dispatch.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
