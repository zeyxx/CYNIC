[Unit]
Description=CYNIC node-local storage reconciliation
After=surrealdb.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cynic-node storage-reconcile --state-dir /var/lib/cynic/storage-lifecycle --warmup-seconds 30 --restart-window-seconds 300 --max-restarts-per-window 1 --apply --json
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cynic/storage-lifecycle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=surreal-watchdog
