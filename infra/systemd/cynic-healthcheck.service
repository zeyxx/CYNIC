[Unit]
Description=CYNIC Health Check — Telegram alerting on kernel degradation
After=cynic-kernel.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
ExecStart=/bin/sh -c 'echo "legacy healthcheck entrypoint removed; reforge as an organ entrypoint before enabling cynic-healthcheck" >&2; exit 1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cynic-healthcheck
