{
  "schema": "cynic.runtime_principals.v1",
  "status": "normative",
  "purpose": "Define the OS-level organism principal contract so cortex CLIs and runtime projections use the dedicated cynic account with high velocity but bounded destructive authority.",
  "dedicated_user": {
    "name": "cynic",
    "name_env": "CYNIC_RUNTIME_USER",
    "home_env": "CYNIC_RUNTIME_HOME",
    "home_default_template": "/home/${CYNIC_RUNTIME_USER}",
    "primary_group": "cynic",
    "primary_group_env": "CYNIC_RUNTIME_GROUP",
    "required_groups": [
      "cynic"
    ],
    "forbidden_users": [
      "root",
      "user"
    ]
  },
  "postures": {
    "bounded_yolo": {
      "description": "Approval-free execution for repo-local development, kernel MCP, data read/write, builds, and infra inspection. Destructive host, disk, network, and provider mutations remain blocked or require bounded MCP/helper contracts.",
      "requires_project_scoping": true,
      "requires_denylist": true,
      "forbidden_nopasswd_concerns": [
        "infra-write",
        "network"
      ],
      "forbidden_commands": [
        "rm -rf /",
        "rm -rf ~",
        "dd if=* of=/dev/*",
        "mkfs.*",
        "shred *",
        "git push --force",
        "git reset --hard HEAD~"
      ]
    }
  },
  "cortex_cli_policy": {
    "required_agents": [
      "codex",
      "antigravity"
    ],
    "required_runtime_user": "cynic",
    "required_posture": "bounded_yolo",
    "projection": "infra/agent-policy.toml"
  },
  "projection_requirements": {
    "agent_policy_toml": {
      "path": "infra/agent-policy.toml",
      "runtime_section_required": true,
      "agents_must_declare_runtime_user": true,
      "agents_must_declare_execution_posture": true,
      "bounded_yolo_must_keep_destructive_concerns_passworded": true
    }
  },
  "activation": {
    "script": "organs/supervisor/entrypoints/runtime_principals.py",
    "status_command": "make runtime-principals-status",
    "plan_command": "make runtime-principals-plan",
    "apply_command": "sudo make runtime-principals-apply",
    "install_defaults_command": "sudo make runtime-principals-install-defaults",
    "operator_cli_env": "CYNIC_OPERATOR_CLI",
    "operator_cli_default": "/usr/local/bin/cynic",
    "operator_commands": [
      "cynic codex",
      "cynic agy",
      "cynic hermes",
      "cynic repos",
      "cynic repos status",
      "cynic repos add",
      "cynic repos remove",
      "cynic repos sync",
      "cynic bootstrap",
      "cynic bootstrap --json",
      "cynic update --dry-run",
      "cynic update",
      "cynic update --bootstrap",
      "cynic organism",
      "cynic organism --json",
      "cynic actions",
      "cynic actions --json",
      "cynic activate --dry-run",
      "cynic activate",
      "cynic activate --json",
      "cynic bootstrap-request --dry-run",
      "cynic bootstrap-request",
      "cynic bootstrap-request --json",
      "cynic mcp-reload --dry-run",
      "cynic mcp-reload",
      "cynic mcp-reload --json",
      "cynic gate-2 --dry-run",
      "cynic gate-2",
      "cynic gate-2 --json",
      "cynic deploy --dry-run",
      "cynic deploy",
      "cynic deploy --json",
      "cynic storage plan",
      "cynic storage bundle --output-dir <dir>",
      "cynic storage status",
      "cynic storage status --json",
      "cynic bridge plan",
      "cynic bridge status",
      "cynic bridge status --json",
      "cynic fleet status",
      "cynic fleet status --json",
      "cynic mesh status",
      "cynic mesh status --json",
      "cynic mesh status --resolve-dns --include-records",
      "cynic status",
      "cynic status --json",
      "cynic doctor",
      "cynic plan",
      "cynic shell"
    ],
    "compatibility_aliases": [
      "cynic antigravity -> cynic agy"
    ],
    "yolo_flags": {
      "codex": [
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "agy": [
        "--dangerously-skip-permissions"
      ],
      "hermes": []
    },
    "primary_dependency_updates": {
      "operator_command": "cynic update",
      "allowed_update_commands": {
        "codex": [
          "codex",
          "update"
        ],
        "agy": [
          "agy",
          "update"
        ],
        "hermes": [
          "make",
          "hermes-update"
        ]
      },
      "forbidden_update_patterns": [
        "curl | sh",
        "curl -fsSL * | sh",
        "cargo build -p cynic-mcp",
        "install -m 0755 target/release/cynic-mcp",
        "cp target/release/cynic-kernel"
      ],
      "post_update": "re-run runtime-principals bootstrap so dedicated-user bridges and wrappers point at the updated operator binaries",
      "required_projection_fields": [
        "operator_sequence",
        "proof_commands",
        "read_back",
        "done_when"
      ]
    },
    "lifecycle_operator_sequence": {
      "activation_command": "activate",
      "profiles": [
        "bootstrap-request",
        "mcp-reload",
        "gate-2",
        "deploy"
      ],
      "steps": [
        {
          "name": "inspect",
          "command_template": "cynic {profile} --dry-run",
          "mutates_mempool": false
        },
        {
          "name": "dispatch",
          "command_template": "cynic {profile}",
          "mutates_mempool": true
        },
        {
          "name": "dispatch_json",
          "command_template": "cynic {profile} --json",
          "mutates_mempool": true
        },
        {
          "name": "observe",
          "command_template": "cynic organism",
          "mutates_mempool": false
        }
      ],
      "required_projection_fields": [
        "operator_sequence",
        "proof_commands",
        "done_when"
      ]
    },
    "status_format": "JSON for machine consumers",
    "doctor_format": "plain text for human operators",
    "canonical_project_root_env": "CYNIC_PROJECT_ROOT",
    "cortex_checkout_model": "single canonical Git checkout shared by human operator and dedicated cynic cortex user",
    "cortex_checkout_rule": "interactive cortex CLIs must edit the canonical checkout directly; recursive autonomous agents require a separate future sandbox/worktree contract",
    "project_access_materialization": "organ-supervisor grants traverse ACLs on every parent of the canonical checkout to the dedicated cynic user, then grants symmetric rwX access to the checkout for cynic and the invoking human operator, preferring recursive/default ACLs and falling back to group rwX",
    "operator_binary_bridge": "organ-supervisor detects operator-installed codex and agy binaries from SUDO_USER, grants cynic read/traverse access to their resolved paths, and installs small wrappers in the dedicated user's bin directory so the dedicated user can execute the same CLI binaries without duplicating them",
    "default_profile_env": "CYNIC_PROFILE_DEFAULTS",
    "default_profile_default": "/etc/profile.d/cynic-agents.sh",
    "required_script_commands": [
      "status",
      "doctor",
      "plan",
      "update",
      "organism",
      "actions",
      "activate",
      "bootstrap-request",
      "mcp-reload",
      "gate-2",
      "deploy",
      "storage",
      "bridge",
      "fleet",
      "mesh",
      "repos",
      "apply",
      "install-defaults",
      "print-launchers",
      "print-profile",
      "print-cynic-cli",
      "bootstrap"
    ],
    "forbidden_legacy_sudoers": [
      "cynic ALL=(ALL) NOPASSWD: /usr/bin/pvesh"
    ]
  }
}
