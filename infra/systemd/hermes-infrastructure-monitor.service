[Unit]
Description=K15 Infrastructure Consumer — Route probe failures to recovery
Requires=network.target
After=network.target

[Service]
Type=simple
WorkingDirectory=@CYNIC_PROJECT_ROOT@
Environment="CYNIC_ROOT=@CYNIC_PROJECT_ROOT@"

# Legacy wrapper removed. Reforge this as an organ entrypoint before enabling.
ExecStart=/bin/sh -c 'echo "legacy infrastructure monitor entrypoint removed; reforge as an organ entrypoint before enabling hermes-infrastructure-monitor" >&2; exit 1'

# Restart on failure with 30s backoff
Restart=on-failure
RestartSec=30

# Output to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
