[Unit]
Description=CYNIC Organ Reflection Cron
After=cynic-kernel.service

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/reflection/src/entrypoints/cli.py
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/reflection/src/dispatch.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
