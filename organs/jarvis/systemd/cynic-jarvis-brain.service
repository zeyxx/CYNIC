[Unit]
Description=CYNIC Jarvis Brain (Cognitive Data Lake)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/jarvis/src/entrypoints/brain_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
