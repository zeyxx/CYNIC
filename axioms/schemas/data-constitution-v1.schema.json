{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYNIC Data Constitution Contract Schema",
  "type": "object",
  "required": [
    "schema",
    "status",
    "data_rules"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cynic.data_constitution.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "normative",
        "draft",
        "deprecated"
      ]
    },
    "data_rules": {
      "type": "object",
      "required": [
        "membrane_policy",
        "state_isolation_policy",
        "persistence_policy"
      ],
      "properties": {
        "membrane_policy": {
          "type": "object",
          "required": [
            "enforce_validation_library",
            "requires_manifest_schemas"
          ],
          "properties": {
            "enforce_validation_library": {
              "type": "object",
              "properties": {
                "python": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "rust": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "requires_manifest_schemas": {
              "type": "boolean"
            }
          }
        },
        "state_isolation_policy": {
          "type": "object",
          "required": [
            "forbidden_imports",
            "allowed_shared_bus"
          ],
          "properties": {
            "forbidden_imports": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowed_shared_bus": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "persistence_policy": {
          "type": "object",
          "required": [
            "allowed_extensions_under_state",
            "enforce_append_only_for_extensions"
          ],
          "properties": {
            "allowed_extensions_under_state": {
              "type": "array",
              "items": { "type": "string" }
            },
            "enforce_append_only_for_extensions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
