{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "cynic.pattern_registry.v1",
  "version": "1.0.0",
  "status": "draft",
  "purpose": "Schema for infra/pattern-registry.json: registry of recurring CYNIC implementation patterns, their layer progression, invariants, observed occurrences, and lifecycle status.",
  "required": [
    "schema",
    "status",
    "purpose",
    "patterns"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cynic.pattern_registry.v1",
      "description": "Schema identifier for the pattern registry document."
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "draft",
        "active",
        "normative"
      ],
      "description": "Lifecycle status of the pattern registry."
    },
    "purpose": {
      "type": "string",
      "description": "Human-readable purpose of the document."
    },
    "patterns": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "pattern_id",
          "name",
          "layers",
          "invariants",
          "occurrences",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "pattern_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable pattern identifier."
          },
          "name": {
            "type": "string",
            "description": "Human-readable pattern name."
          },
          "layers": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "observe",
                "formalize",
                "implement",
                "verify",
                "deliver"
              ]
            },
            "description": "Ordered list of the five organic layer names the pattern traverses."
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Invariants enforced by the pattern."
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Crate or surface paths that use this pattern."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "deprecated",
              "orphan"
            ],
            "description": "Lifecycle status of the pattern."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp of creation."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp of last update."
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of registry creation."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of last registry update."
    }
  },
  "additionalProperties": false
}
