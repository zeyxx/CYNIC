{
  "schema": "cynic.odysseum_manifest.v1",
  "status": "normative",
  "purpose": "Define the machine-readable boundary for the Odysseum v0 standard without promoting pitch narrative, tokenomics, legal claims, or unverified market projections to protocol authority.",
  "authority_chain": {
    "manifest_markdown": "docs/foundation/ODYSSEUM_MANIFEST.md",
    "policy_matrix": "docs/foundation/CYNIC_ORGANISM_POLICY_MATRIX.md",
    "repo_topology": "axioms/repo-topology-v1.json",
    "internal_research_inputs": [
      "docs/internal/STOCKS_ON_SOLANA_GROUND_TRUTH.md",
      "docs/internal/ODYSSEUM_FUTARDIO_WHITEPAPER.md",
      "docs/ODYSSEUM_PITCH_WAKEUP_2026-06-30.md"
    ]
  },
  "authority_rules": [
    "The manifesto is the public doctrine source for Odysseum boundaries.",
    "Internal research and pitch documents are inputs, not protocol authority.",
    "Machine claims in this axiom must be narrower than or equal to the manifesto.",
    "Solana, Pump and PumpSwap mechanisms must be observed before they become contract design assumptions.",
    "TALARIA SAS commercial support must not be represented as custody or protocol control."
  ],
  "surface_boundaries": {
    "odysseum_protocol": {
      "owns": [
        "Odysseum-Locked verification",
        "vault routing rules",
        "proposal lifecycle",
        "conditional market state",
        "fee capture and burn accounting",
        "public technical documentation",
        "program ids, audits, verifiable build proofs and integration guides"
      ],
      "must_not_own": [
        "TALARIA SAS invoices or commercial contracts",
        "custody over community treasuries",
        "discretion over governance outcomes",
        "unverified ARR projections",
        "legal equity claims"
      ]
    },
    "talaria_sas": {
      "owns": [
        "enterprise intake",
        "contracts and invoices",
        "partnership conversations",
        "implementation support",
        "public communications calendar",
        "domain deployment and business operations"
      ],
      "must_not_own": [
        "vault custody",
        "market resolution",
        "protocol treasury execution",
        "Odysseum-Locked verification authority"
      ]
    },
    "solana_library": {
      "owns": [
        "Pump and PumpSwap mechanism observations",
        "mint and token program classification",
        "live chain evidence emission into the Kernel library"
      ],
      "repo_anchor": "organs/solana",
      "must_not_own": [
        "Odysseum product backend",
        "Odysseum business logic",
        "wallet signing",
        "transaction submission"
      ]
    },
    "rag_memory": {
      "owns": [
        "retrieval over Kernel/library memory"
      ],
      "repo_anchor": "organs/rag",
      "must_not_own": [
        "durable source of truth",
        "Solana mechanism authority",
        "Odysseum product state"
      ]
    },
    "percolator": {
      "owns": [
        "Percolator bounty workflow",
        "duplicate intelligence",
        "security finding proof gates"
      ],
      "repo_anchor": "organs/percolator",
      "must_not_own": [
        "Odysseum market research",
        "PumpSwap pitch metrics",
        "Odysseum revenue simulations"
      ]
    }
  },
  "v0_contract_families": [
    {
      "id": "vault_route",
      "status": "candidate",
      "purpose": "Define where captured fees go and what authority can update routing.",
      "likely_state": [
        "token mint or wrapped asset reference",
        "vault account",
        "fee receiver account",
        "route percentage or basis points",
        "update authority policy",
        "freeze or immutability state"
      ]
    },
    {
      "id": "proposal_market",
      "status": "candidate",
      "purpose": "Convert governance actions into conditional market decisions.",
      "likely_state": [
        "proposal id",
        "action payload hash",
        "pass market",
        "fail market",
        "resolution conditions",
        "execution gate",
        "expiry"
      ]
    },
    {
      "id": "ignis_burn_executor",
      "status": "candidate",
      "purpose": "Execute buyback and burn policy from collected fees.",
      "repo_anchor": "services/ignis",
      "likely_state": [
        "spend budget",
        "execution interval",
        "slippage bounds",
        "burn target",
        "proof of burn"
      ]
    },
    {
      "id": "evidence_and_verification",
      "status": "candidate",
      "purpose": "Make Odysseum-Locked status auditable.",
      "likely_state": [
        "asset identity",
        "program ids",
        "vault route proof",
        "governance proof",
        "fee collection proof",
        "public metadata uri",
        "verification status"
      ]
    },
    {
      "id": "survivor_intake",
      "status": "candidate",
      "purpose": "Qualify communities whose actual token mechanics can support an Odysseum route.",
      "likely_state": [
        "mint and token program",
        "launch source",
        "bonding curve or pool status",
        "community ownership signals",
        "fee surfaces observed",
        "operator contacts",
        "requested Odysseum route",
        "opt-in proof"
      ]
    }
  ],
  "research_inputs_not_normative": [
    {
      "id": "stocks_on_solana",
      "source": "docs/internal/STOCKS_ON_SOLANA_GROUND_TRUTH.md",
      "status": "internal_thesis",
      "rule": "May inform positioning and readiness checklists; must not imply legal shares, equity, dividends or investment entitlement."
    },
    {
      "id": "options_on_solana",
      "source": "docs/internal/STOCKS_ON_SOLANA_GROUND_TRUTH.md",
      "status": "internal_thesis",
      "rule": "May inform proposal-market UX; must not become a public governance derivative claim before mechanism and legal review."
    },
    {
      "id": "conglomerate_mechanisms",
      "source": "docs/internal/STOCKS_ON_SOLANA_GROUND_TRUTH.md",
      "status": "roadmap_hypothesis",
      "rule": "Franchise, acquisition, OPA and M&A language must stay out of v0 protocol authority until contract and legal boundaries exist."
    },
    {
      "id": "zero_human_layer",
      "source": "docs/internal/STOCKS_ON_SOLANA_GROUND_TRUTH.md",
      "status": "roadmap_hypothesis",
      "rule": "Odysseum may reduce discretionary capture; it must not claim to replace all human, legal, KYC, audit or compliance functions."
    }
  ],
  "non_goals_v0": [
    "custodial treasury product",
    "legal wrapper for every jurisdiction",
    "promise of token performance",
    "centralized multisig with better branding",
    "white paper authority before contracts, flows and market claims are defensible",
    "promotion of internal pitch numbers or roadmap dates as public protocol truth",
    "generic launchpad abstraction before Pump/PumpSwap mechanisms are understood"
  ],
  "evidence_requirements": [
    "Odysseum-Locked verification schema",
    "Pump/PumpSwap mechanism table built from live mints",
    "at least one vault route prototype",
    "clear TALARIA SAS versus protocol communication map",
    "falsifiable meme-coin-as-PME readiness checklist"
  ]
}
