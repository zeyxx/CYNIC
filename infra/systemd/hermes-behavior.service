[Unit]
Description=CYNIC Hermes behavior logger — mouse/keyboard capture for ML training
After=hermes-browser.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=CYNIC_VENV=%h/.cynic/organs/hermes/behavior/.venv
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py behavior-logger
Restart=on-failure
RestartSec=10
# Cgroup limits — observed: 32MB.
MemoryMax=128M

[Install]
WantedBy=default.target
