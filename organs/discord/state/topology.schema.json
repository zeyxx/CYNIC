{
  "schema_version": "1.0.0",
  "organ": "discord",
  "purpose": "Canonical structure for Discord as a multi-surface social graph: servers, groups, friends, channels, threads, messages, and observation scopes.",
  "entities": {
    "identity": {
      "description": "A Discord user, friend, researcher, maintainer, or local operator-facing contact.",
      "primary_key": "identity_id",
      "fields": {
        "identity_id": "string",
        "discord_user_id": "string|null",
        "display_name": "string|null",
        "aliases": "string[]",
        "relationship": "unknown|friend|researcher|maintainer|operator|bot|project_member",
        "trust_level": "unknown|low|medium|high",
        "notes": "object"
      }
    },
    "server": {
      "description": "A Discord guild/server.",
      "primary_key": "server_id",
      "fields": {
        "server_id": "string",
        "discord_guild_id": "string|null",
        "name": "string|null",
        "category": "unknown|security|bounty|project|community|private|research",
        "access_level": "unknown|public|private|invite_only",
        "capture_policy": "disabled|metadata_only|messages_allowlisted",
        "notes": "object"
      }
    },
    "group": {
      "description": "A Discord group DM or informal group not represented as a server.",
      "primary_key": "group_id",
      "fields": {
        "group_id": "string",
        "name": "string|null",
        "member_identity_ids": "string[]",
        "category": "unknown|friends|research|bounty|project|private",
        "capture_policy": "disabled|metadata_only|messages_allowlisted",
        "notes": "object"
      }
    },
    "direct_contact": {
      "description": "A one-to-one Discord DM relationship.",
      "primary_key": "contact_id",
      "fields": {
        "contact_id": "string",
        "identity_id": "string",
        "relationship": "unknown|friend|researcher|maintainer|project_member",
        "capture_policy": "disabled|metadata_only|messages_allowlisted",
        "notes": "object"
      }
    },
    "channel": {
      "description": "A text channel, forum channel, announcement channel, or DM-like message surface.",
      "primary_key": "channel_id",
      "fields": {
        "channel_id": "string",
        "discord_channel_id": "string",
        "parent_type": "server|group|direct_contact|unknown",
        "parent_id": "string|null",
        "name": "string|null",
        "kind": "text|forum|announcement|thread|dm|group_dm|unknown",
        "topic": "string|null",
        "capture_policy": "disabled|metadata_only|messages_allowlisted",
        "watch_profiles": "string[]",
        "notes": "object"
      }
    },
    "watch_profile": {
      "description": "A named extraction policy attached to channels or groups.",
      "primary_key": "watch_profile_id",
      "fields": {
        "watch_profile_id": "string",
        "domain": "string",
        "keywords": "string[]",
        "negative_keywords": "string[]",
        "risk_classes": "string[]",
        "output_targets": "string[]",
        "dedupe_policy": "none|weak|strict",
        "notes": "object"
      }
    },
    "observation": {
      "description": "A normalized observed Discord item after passive capture.",
      "primary_key": "observation_id",
      "fields": {
        "observation_id": "string",
        "source": "discord",
        "server_id": "string|null",
        "group_id": "string|null",
        "contact_id": "string|null",
        "channel_id": "string",
        "thread_id": "string|null",
        "message_id": "string",
        "author_identity_id": "string|null",
        "timestamp": "string",
        "content_hash": "string",
        "raw_ref": "string",
        "classification": "object",
        "privacy": "public|semi_public|private|unknown"
      }
    }
  },
  "required_invariants": [
    "every_channel_has_exactly_one_parent_type",
    "messages_are_never_processed_without_channel_scope",
    "private_dm_capture_defaults_to_disabled",
    "group_capture_defaults_to_disabled",
    "server_capture_requires_explicit_channel_allowlist",
    "every_exported_signal_keeps_source_pointer",
    "dedupe_uses_channel_id_message_id_and_content_hash"
  ]
}
