{
  "manifest_version": "1.0.0",
  "contract_version": "2026.07.02",
  "objective": "Standardized adapter contract for project-specific integration into CYNIC",
  "ports": {
    "kernel_transport": {
      "required": true,
      "interface": "KernelRestPort",
      "required_methods": [
        "base_url",
        "auth_token",
        "observe",
        "health",
        "post_event"
      ],
      "defaults": {
        "transport": "https",
        "timeout_ms": 3000,
        "retries": 3
      },
      "config_keys": [
        "CYNIC_PROJECT_KERNEL_URL",
        "CYNIC_PROJECT_KERNEL_TOKEN",
        "CYNIC_PROJECT_PROXY_URL"
      ]
    },
    "state_store": {
      "required": true,
      "interface": "ProjectStateStore",
      "required_methods": [
        "load",
        "save",
        "list",
        "snapshot",
        "compact"
      ],
      "adapters": [
        "surreal",
        "postgres",
        "sqlite",
        "filesystem"
      ]
    },
    "secrets": {
      "required": true,
      "interface": "ProjectSecretProvider",
      "required_methods": [
        "get",
        "get_required",
        "set",
        "rotate"
      ],
      "providers": [
        "environment",
        "vault",
        "kms"
      ],
      "config_keys": [
        "CYNIC_PROJECT_SECRET_BACKEND",
        "CYNIC_PROJECT_SECRET_SCOPE"
      ]
    },
    "permissions": {
      "required": true,
      "interface": "ProjectPermissionPolicy",
      "required_methods": [
        "is_action_allowed",
        "scope",
        "audit_denial"
      ],
      "config_keys": [
        "CYNIC_PROJECT_POLICY_MODE",
        "CYNIC_PROJECT_ALLOW_NETWORK"
      ]
    }
  },
  "runtime_bootstrap": {
    "entrypoint_contract": "One bootstrap module per project must instantiate all adapters",
    "must_inject": [
      "kernel_transport",
      "state_store",
      "secrets",
      "permissions"
    ],
    "forbidden": [
      "hardcoded kernel URL in application/domain layer",
      "hardcoded storage path in domain layer",
      "direct CYNIC internal DB connection in application layer"
    ]
  },
  "evidence": {
    "required_artifacts": [
      "adapter-resolve.json",
      "boot-seal.json",
      "startup-validation.log.json"
    ]
  }
}
