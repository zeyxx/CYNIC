{
  "schema": "cynic.organ_hexagonal_architecture.v1",
  "status": "draft",
  "purpose": "Define the reusable hexagonal architecture contract every CYNIC organ should converge toward so the organism can evolve without reinventing ports, adapters and runtime membranes in each subsystem.",
  "owner": "organ-supervisor",
  "applies_to": [
    "organs/*/"
  ],
  "architecture_layers": [
    {
      "id": "core.domain",
      "path": "src/core/",
      "owns": [
        "entities",
        "value_objects",
        "pure_policy",
        "domain_errors"
      ],
      "must_not_own": [
        "filesystem_io",
        "network_io",
        "subprocess_calls",
        "environment_reads",
        "kernel_http_calls"
      ]
    },
    {
      "id": "core.ports",
      "path": "src/core/",
      "owns": [
        "protocols",
        "abstract_ports",
        "use_case_input_output_contracts"
      ],
      "must_not_own": [
        "provider_specific_code",
        "transport_specific_code"
      ]
    },
    {
      "id": "core.use_cases",
      "path": "src/core/",
      "owns": [
        "application_services",
        "orchestration_between_ports",
        "decision_logic"
      ],
      "must_not_own": [
        "direct_provider_calls",
        "CLI_argument_parsing",
        "systemd_runtime_assumptions"
      ]
    },
    {
      "id": "adapters",
      "path": "src/adapters/",
      "owns": [
        "filesystem_adapters",
        "network_adapters",
        "kernel_adapters",
        "provider_adapters",
        "subprocess_adapters"
      ],
      "must_not_own": [
        "business_policy",
        "schema_authority",
        "organ_identity"
      ]
    },
    {
      "id": "entrypoints",
      "path": "src/entrypoints/",
      "owns": [
        "CLI_wiring",
        "daemon_wiring",
        "dependency_injection",
        "JSON_output_boundary"
      ],
      "must_not_own": [
        "domain_logic",
        "provider_logic",
        "long_running_business_workflows"
      ]
    }
  ],
  "shared_port_policy": {
    "canonical_home": "organs/contracts/src/",
    "rule": "When two or more organs need the same transport, manifest parser, kernel API client, surface registry, dependency scanner, environment loader, or runtime directory resolver, the reusable port or adapter belongs in organ-contracts or another declared shared runtime before adding a second local copy.",
    "known_shared_ports": [
      {
        "id": "surface_registry",
        "module": "organs.contracts.src.surface_contracts",
        "use_for": [
          "command manifests",
          "report manifests",
          "JSON surface metadata"
        ]
      },
      {
        "id": "kernel_http",
        "module": "organs.contracts.src.adapters.kernel_http",
        "use_for": [
          "kernel REST requests",
          "kernel URL normalization",
          "kernel auth headers"
        ]
      },
      {
        "id": "kernel_observe",
        "module": "organs.contracts.src.adapters.kernel_observe",
        "use_for": [
          "structured observations",
          "Proof-of-History publication"
        ]
      },
      {
        "id": "agent_tasks",
        "module": "organs.contracts.src.adapters.agent_tasks",
        "use_for": [
          "agent task listing",
          "agent task read-back",
          "mempool query paths"
        ]
      },
      {
        "id": "dependency_inventory",
        "module": "organs.contracts.src.adapters.dependency_inventory",
        "use_for": [
          "pyproject.toml scanning",
          "package.json scanning",
          "Cargo.toml scanning",
          "requirements.txt scanning"
        ]
      },
      {
        "id": "agent_framework_capabilities",
        "module": "organs.contracts.src.core.agent_framework_capabilities",
        "use_for": [
          "agent framework capability payloads",
          "capability confidence",
          "capability side effect classification"
        ]
      }
    ],
    "anti_reinvention_rule": "A new organ-local adapter with the same use_for concern as a known shared port must either import the shared module or declare a justified exception in its MANIFEST.yaml.",
    "exception_fields": [
      "concern",
      "why_shared_port_is_insufficient",
      "expiry_condition",
      "replacement_path"
    ]
  },
  "evolution_policy": {
    "rule": "Organs evolve by adding ports, adapters and use cases behind stable report/command surfaces; they do not grow by accumulating one-off scripts or provider-specific shortcuts.",
    "allowed_growth": [
      "new core port",
      "new adapter implementing existing port",
      "new use case orchestrating existing ports",
      "new entrypoint wiring a use case",
      "new shared contract promoted from duplicated organ code"
    ],
    "forbidden_growth": [
      "business logic in entrypoints",
      "provider API calls from core",
      "copy-pasted kernel clients",
      "unbounded adapter god objects",
      "runtime state committed as source",
      "new script surfaces outside organ entrypoints"
    ],
    "promotion_trigger": "When an organ-local pattern appears in a second organ, promote it into a shared port or shared runtime contract before extending it a third time."
  },
  "framework_map_projection": {
    "recommended_organ": "organs/framework-map/",
    "role": "external_framework_cartographer",
    "core_ports": [
      "SourceAcquisitionPort",
      "ManifestInventoryPort",
      "CapabilityDiscoveryPort",
      "ArchitecturePatternPort",
      "CompatibilityPort",
      "PublicationPort"
    ],
    "adapters": [
      "GitCheckoutAdapter",
      "LocalPathAdapter",
      "HermesAgentScanner",
      "DependencyInventoryScanner",
      "KernelObservePublisher"
    ],
    "reports": [
      "cynic.framework_source_inventory.v1",
      "cynic.external_dependency_inventory.v1",
      "cynic.agent_framework_capabilities.v1",
      "cynic.framework_architecture_patterns.v1",
      "cynic.framework_cynic_compatibility.v1"
    ]
  }
}
