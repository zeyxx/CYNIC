{
  "schema": "cynic.audit_debt_ledger.v1",
  "status": "normative",
  "purpose": "Declared, counted, shrink-only ledger of audit violations present at ratification. Read by audit_engine::apply_debt_ledger. A violation whose identity is absent here fails the gate; a ledger entry with no observed violation also fails the gate, because paid debt left in the ledger hides that the ledger is stale.",
  "rule": {
    "growth": "blocked -- a new identity, or a count above the recorded one, fails",
    "shrink": "required -- an entry with no observed violation must be deleted",
    "why_not_a_threshold": "A threshold is a policy that erodes: it tolerates the next violation by construction. An exact per-identity count does not, because any increase is a distinct, named failure."
  },
  "identity_policy": {
    "measured_rules": [
      "ARCH-001-HOTSPOT"
    ],
    "measured_identity": "code|span.file_path",
    "measured_reason": "the message embeds a line count that changes on any edit; keying on it would force regeneration on every edit and turn a deliberate act into muscle memory",
    "default_identity": "code|message",
    "default_reason": "the 15 ARCH-004 edges share one span.file_path and differ only by message, so keying on the file would collapse 15 distinct violations into one and hide a partial repair"
  },
  "ratified_at_commit": "92e9a85c4a931b67049f7e7e173b9c9ec7daaf62",
