      "local": "10.10.10.101",
      "synapse": "10.10.10.101"
    },
    "services": [
      {
        "name": "ssh",
        "scheme": "ssh",
        "port": 22
      },
      {
        "name": "forgejo-backend",
        "scheme": "http",
        "port": 3000
      },
      {
        "name": "forgejo-api-tls",
        "scheme": "https",
        "port": 443
      }
    ]
  }
