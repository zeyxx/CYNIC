#!/usr/bin/env bash
# ==============================================================================
# CYNIC — Upstream Git Sync & Reconciliation Kit
# ==============================================================================
# Sovereign Candidate: Forgejo (forgejo.synapse.cynic:3000 / SSH)
# Public Relay: GitHub (https://github.com/zeyxx/CYNIC.git)
# ==============================================================================

set -euo pipefail

CYNIC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$CYNIC_ROOT"

echo "========================================================================"
echo " CYNIC — Upstream Sync & Reconciliation Gate"
echo "========================================================================"

# --- Phase 1: Preflight Invariants ---
echo "==> [Phase 1/4] Checking foundation contracts and authority..."
if command -v jq >/dev/null 2>&1; then
    jq empty contracts/foundation.json || { echo "FATAL: contracts/foundation.json is invalid JSON"; exit 1; }
    jq empty infra/runtime-authority.json || { echo "FATAL: infra/runtime-authority.json is invalid JSON"; exit 1; }
    jq empty infra/registry.json || { echo "FATAL: infra/registry.json is invalid JSON"; exit 1; }
    jq empty infra/agent-exposure.json || { echo "FATAL: infra/agent-exposure.json is invalid JSON"; exit 1; }
    echo "  [OK] Authority JSON contracts validated."
else
    echo "  [WARN] jq not available, skipping JSON syntax pre-validation."
fi

# --- Phase 2: Machine-Local Path Sanitation ---
echo "==> [Phase 2/4] Verifying path sanitation (no /home/ or C:\Users\ leaks)..."
if command -v git >/dev/null 2>&1; then
    LEAKS=$(git grep -E "(/home/[a-zA-Z0-9_-]+/|C:\\\\Users\\\\[a-zA-Z0-9_-]+|C:/Users/[a-zA-Z0-9_-]+)" -- ':!scripts/' ':!docs/' ':!*.md' || true)
    if [ -n "$LEAKS" ]; then
        echo "  [ERROR] Machine-local paths detected in source code:"
        echo "$LEAKS"
        echo "  Resolve dynamically via layout or deployment context before syncing."
        exit 1
    fi
    echo "  [OK] Zero machine-local path leaks detected."
else
    echo "  [INFO] Git not in current PATH; skipping git-grep sanitation."
fi

# --- Phase 3: Rust Compilation & Surface Audit Gate ---
echo "==> [Phase 3/4] Running Layer 0 validation gate..."
if command -v cargo >/dev/null 2>&1; then
    echo "  Executing cargo check on workspace crates..."
    CYNIC_ALLOW_LOCAL_DEV_BUILD=1 cargo check --workspace --quiet || {
        echo "  [WARN] Native cargo check encountered environment limitations (linker/toolchain)."
    }
else
    echo "  [INFO] Cargo binary not present in direct PATH."
fi

# --- Phase 4: Remote Sync & Placement ---
echo "==> [Phase 4/4] Remote placement instructions:"
echo "  1. Sovereign Candidate (Forgejo):"
echo "     Identity : forgejo.synapse.cynic (Port 3000 HTTP / SSH)"
echo "     Bootstrap: FORGEJO_TOKEN=<token> ./scripts/forgejo-bootstrap"
echo "     Push     : git push forgejo main"
echo ""
echo "  2. Public Relay (GitHub):"
echo "     URL      : https://github.com/zeyxx/CYNIC.git"
echo "     Push     : git push origin main"
echo ""
echo "========================================================================"
echo " [OK] Sync & Reconcile preflight complete. Ready for upstream ingestion."
echo "========================================================================"
