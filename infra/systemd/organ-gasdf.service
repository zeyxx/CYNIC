[Unit]
Description=CYNIC Organ — GASdf Percolator Node
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.cynic-env
Environment=GASDF_ROOT=@CYNIC_PROJECT_ROOT@/../GASdf
Environment=NODE_ENV=production
WorkingDirectory=@CYNIC_PROJECT_ROOT@/../GASdf
ExecStart=/usr/bin/env node src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=15
MemoryMax=512M

[Install]
WantedBy=default.target
