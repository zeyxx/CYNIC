{
  "schema": "cynic.organ_contracts.v1",
  "status": "draft",
  "description": "Information-theory derived I/O mapping of python organs to reduce chaos.",
  "organs": {
    "reflection": {
      "inputs": [
        {
          "source": "organs/*/state/dataset.jsonl",
          "data": "all organ events and traces"
        }
      ],
      "outputs": [
        {
          "path": "~/.cynic/organs/reflection/askesis.jsonl",
          "format": "jsonl"
        },
        {
          "path": "kernel /observe (domain=reflection)",
          "format": "REST POST"
        }
      ],
      "status": "ACTIVE",
      "domain": "synthesis"
    },
    "telemetry": {
      "inputs": [
        {
          "source": "~/.gemini/antigravity-cli/brain",
          "data": "local Antigravity log stream"
        },
        {
          "source": "environment",
          "data": "SURREALDB_URL and SURREALDB_PASS when telemetry persistence is enabled"
        }
      ],
      "outputs": [
        {
          "path": "SurrealDB cynic/main",
          "format": "telemetry anomaly records"
        },
        {
          "path": "stdout",
          "format": "RCA report"
        }
      ],
      "status": "ACTIVE",
      "domain": "observability"
    },
    "fleet": {
      "inputs": {
        "registry": [
          "infra/registry.json"
        ],
        "providers": [
          "proxmox",
          "proxmox_mcp_text",
          "headscale",
          "synapse",
          "systemd",
          "kernel_health"
        ]
      },
      "outputs": {
        "report": {
          "format": "json",
          "fields": [
            "desired",
            "declared",
            "observed",
            "effective",
            "anomalies",
            "energy"
          ]
        },
        "lxc_exec_bridge_policy": {
          "format": "json",
          "path": "organs/fleet/policies/lxc-exec-bridge.policy.json"
        }
      },
      "status": "planned",
      "domain": "UNKNOWN"
    },
    "headscale": {
      "inputs": [],
      "outputs": {
        "fleet_evidence": {
          "format": "json",
          "consumer": "organ-fleet"
        }
      },
      "status": "active",
      "domain": "UNKNOWN"
    },
    "exposure": {
      "inputs": [
        {
          "source": "infra/agent-exposure.json",
          "data": "declared MCP servers, tool approvals, agent targets, and runtime requirements"
        }
      ],
      "outputs": [
        {
          "path": "process/stdout",
          "format": "TOML / JSON",
          "frequency": "on demand"
        },
        {
          "path": "REST future kernel /observe",
          "format": "REST POST",
          "frequency": "on drift detection"
        }
      ],
      "status": "ACTIVE",
      "domain": "organism/exposure"
    },
    "kanban-ui": {
      "inputs": [
        {
          "source": "hermes tasks",
          "data": "json tasks from surrealdb/sqlite"
        }
      ],
      "outputs": [
        {
          "path": "~/.cynic/organs/kanban-ui/board.md",
          "format": "markdown"
        }
      ],
      "status": "ACTIVE",
      "domain": "presentation"
    },
    "discord": {
      "inputs": [
        {
          "source": "discord_web_passive_capture",
          "data": "allowed_channel_message_responses"
        }
      ],
      "outputs": [
        {
          "path": "~/.cynic/organs/discord/messages.db",
          "format": "sqlite"
        },
        {
          "path": "http://127.0.0.1:8891",
          "format": "local_http_ui"
        },
        {
          "path": "kernel /observe (domain=discord)",
          "format": "REST POST"
        }
      ],
      "status": "ACTIVE",
      "domain": "social"
    },
    "prompt-enricher": {
      "inputs": [
        {
          "source": "cynic-kernel /agent-tasks",
          "data": "raw or naive agent task prompts"
        },
        {
          "source": "repository context",
          "data": "policy and retrieval context for prompt scaffolding"
        }
      ],
      "outputs": [
        {
          "path": "cynic-kernel /agent-tasks",
          "format": "enriched task payload"
        },
        {
          "path": "kernel /observe",
          "format": "enrichment impact observations"
        }
      ],
      "status": "TRANSITIONAL",
      "domain": "prompt-middleware"
    },
    "browser": {
      "inputs": [
        {
          "source": "cynic-kernel /agent-tasks",
          "data": "browser tasks (search, scrape, interact) conforming to browser_task.schema.json"
        },
        {
          "source": "local configuration",
          "data": "credentials and endpoints for SearXNG, Firecrawl, Hermes Agent browser backends, and browser CDP"
        }
      ],
      "outputs": [
        {
          "path": "kernel /observe",
          "format": "REST POST",
          "frequency": "per-discovery"
        },
        {
          "path": "organs/browser/state/evidence/",
          "format": "JSON / PNG",
          "frequency": "per-task"
        },
        {
          "path": "organs/browser/state/action_ledger.jsonl",
          "format": "JSONL",
          "frequency": "per-action"
        }
      ],
      "status": "ACTIVE",
      "domain": "tech-watch/browser"
    },
    "percolator": {
      "inputs": [
        {
          "source": "CYNIC/organs/percolator/desired/percolator-bounty.json",
          "data": "bounty desired state and rules"
        },
        {
          "source": "percolator/ops/researcher-feed.json",
          "data": "Discord-derived researcher and GitHub duplicate signals"
        },
        {
          "source": "percolator/upstream",
          "data": "local upstream repository clones for code review"
        }
      ],
      "outputs": [
        {
          "path": "organs/percolator/state/SSOT.json",
          "format": "generated_json"
        },
        {
          "path": "percolator/ops/infer-queue.jsonl",
          "format": "degraded_queue_jsonl"
        }
      ],
      "status": "declared",
      "domain": "security-bounty"
    },
    "rag": {
      "inputs": [
        {
          "source": "organs/rag",
          "data": "local retrieval-memory membrane inventory"
        }
      ],
      "outputs": [
        {
          "path": "stdout",
          "format": "cynic.rag.status.v1"
        }
      ],
      "status": "ACTIVE",
      "domain": "retrieval-memory"
    },
    "forge": {
      "inputs": [
        {
          "source": "git log / status",
          "data": "git commit history and working tree state"
        },
        {
          "source": "make gate",
          "data": "build system status"
        }
      ],
      "outputs": [
        {
          "path": "kernel /observe (domain=forge)",
          "format": "REST POST",
          "frequency": "per-ingest"
        },
        {
          "path": "~/.cynic/organs/forge/dataset.jsonl",
          "format": "jsonl",
          "frequency": "per-ingest"
        }
      ],
      "status": "ACTIVE",
      "domain": "infrastructure"
    },
    "radar": {
      "inputs": [],
      "outputs": [],
      "status": "planned",
      "domain": "tech-watch"
    },
    "slack": {
      "inputs": [
        {
          "source": "surrealdb_mempool",
          "data": "observations (domain=slack)"
        }
      ],
      "outputs": [
        {
          "path": "REST Slack API (chat.postMessage)",
          "format": "HTTPS POST"
        },
        {
          "path": "kernel /observe (domain=slack, status=delivered|failed)",
          "format": "REST POST"
        }
      ],
      "status": "ACTIVE",
      "domain": "slack"
    },
    "keep": {
      "inputs": {
        "registry": [
          "infra/registry.json"
        ],
        "schema": [
          "infra/surrealdb/schema.surql"
        ],
        "bridge": [
          "docs/contracts/lxc-exec-bridge-v1.json"
        ]
      },
      "outputs": {
        "storage_activation_bundle": {
          "format": "directory",
          "command": "python3 organs/keep/src/entrypoints/cli.py storage-primary bundle --output-dir /tmp/cynic-storage-primary"
        }
      },
      "status": "planned",
      "domain": "storage"
    },
    "telegram": {
      "inputs": [
        {
          "source": "telegram_api",
          "data": "mtproto_stream"
        }
      ],
      "outputs": [
        {
          "path": "~/.cynic/organs/telegram/messages.db",
          "format": "sqlite"
        },
        {
          "path": "kernel /observe (domain=telegram)",
          "format": "REST POST"
        }
      ],
      "status": "ACTIVE",
      "domain": "social"
    },
    "superteam": {
      "inputs": [
        {
          "source": "opportunity_details.jsonl",
          "data": "normalized Superteam opportunity listings and metadata"
        }
      ],
      "outputs": [
        {
          "path": "output/rag/opportunity_cards.jsonl",
          "format": "jsonl"
        },
        {
          "path": "output/top_targets.json",
          "format": "json"
        },
        {
          "path": "output/browser_requests.jsonl",
          "format": "jsonl"
        },
        {
          "path": "output/human_gates.json",
          "format": "json"
        },
        {
          "path": "output/submission_packets/",
          "format": "directory"
        }
      ],
      "status": "ACTIVE",
      "domain": "opportunity-intelligence"
    },
    "jupyter": {
      "inputs": [
        {
          "source": "workspace/.ipynb files",
          "data": "notebook file modifications"
        },
        {
          "source": "jupyter kernel events",
          "data": "kernel states (Idle, Busy, Error)"
        }
      ],
      "outputs": [
        {
          "path": "kernel /observe (domain=jupyter)",
          "format": "REST POST",
          "frequency": "event-driven"
        },
        {
          "path": "~/.cynic/organs/jupyter/dataset.jsonl",
          "format": "jsonl",
          "frequency": "event-driven"
        }
      ],
      "status": "ACTIVE",
      "domain": "environment"
    },
    "wireguard": {
      "inputs": [],
      "outputs": [],
      "status": "planned",
      "domain": "UNKNOWN"
    },
    "freebox": {
      "inputs": [
        {
          "source": "registry and Kernel lifecycle requests",
          "data": "explicit edge exposure intents and approved network targets"
        },
        {
          "source": "operator environment",
          "data": "Freebox API credentials and physical-router approval state"
        }
      ],
      "outputs": [
        {
          "path": "Freebox OS API",
          "format": "provider mutation requests"
        },
        {
          "path": "kernel /observe",
          "format": "edge network observations and blockers"
        }
      ],
      "status": "TRANSITIONAL",
      "domain": "edge-network"
    },
    "supervisor": {
      "inputs": [
        {
          "source": "infra/registry.json",
          "data": "declared organ identities, statuses, roles, dependencies, and runtime instances"
        },
        {
          "source": "organs/*/MANIFEST.yaml",
          "data": "filesystem organ contracts"
        },
        {
          "source": "organs/*/systemd/*.service",
          "data": "organ-local runtime unit declarations"
        },
        {
          "source": "infra/systemd/*.service",
          "data": "organism-level runtime unit declarations"
        }
      ],
      "outputs": [
        {
          "path": "CYNIC/organs/supervisor/state/SSOT.json",
          "format": "curated_json"
        },
        {
          "path": "CYNIC/organs/supervisor/state/supervision.json",
          "format": "generated_json"
        },
        {
          "path": "CYNIC/organs/supervisor/state/action-queue.jsonl",
          "format": "degraded_queue_jsonl"
        },
        {
          "path": "CYNIC/organs/supervisor/state/organ-contract-audit.json",
          "format": "generated_json"
        },
        {
          "path": "CYNIC/organs/supervisor/state/body-health.json",
          "format": "generated_json"
        }
      ],
      "status": "ACTIVE",
      "domain": "body-governance"
    },
    "gasdf": {
      "inputs": [
        {
          "source": "infra/registry.json",
          "data": "organ identity, role and deployment intent"
        },
        {
          "source": "operator environment",
          "data": "fee-payer and RPC credentials supplied outside the repo"
        }
      ],
      "outputs": [
        {
          "path": "organ-owned runtime membrane",
          "format": "structured gate report"
        },
        {
          "path": "Solana RPC",
          "format": "disabled until signer adapter and lifecycle approval exist"
        }
      ],
      "status": "ACTIVE",
      "domain": "gas-delegation"
    },
    "lifecycle": {
      "inputs": [],
      "outputs": [],
      "status": "planned",
      "domain": "UNKNOWN"
    },
    "twitter": {
      "inputs": [
        {
          "source": "kernel /observations",
          "data": "recent observations across all domains"
        },
        {
          "source": "~/.cynic/organs/twitter/dataset.jsonl",
          "data": "raw tweets from x_ingest_daemon"
        },
        {
          "source": "organs/twitter/state/context_items.jsonl",
          "data": "operator-supplied tweets, threads, articles, and notes for cortex context"
        },
        {
          "source": "kernel /verdicts",
          "data": "verdict history for feedback analysis"
        }
      ],
      "outputs": [
        {
          "path": "organs/twitter/state/context/latest.md",
          "format": "markdown",
          "frequency": "on-demand via cli.py bundle"
        },
        {
          "path": "organs/twitter/state/context/latest.json",
          "format": "json",
          "frequency": "on-demand via cli.py bundle"
        },
        {
          "path": "~/.cynic/organs/twitter/reflections/",
          "format": "json",
          "frequency": "hourly"
        },
        {
          "path": "kernel /observe (domain=twitter)",
          "format": "REST POST",
          "frequency": "per-cycle"
        },
        {
          "path": "~/.cynic/organs/hermes/x/domain_signals/",
          "format": "json",
          "frequency": "every 30min via hermes-curation"
        },
        {
          "path": "~/.cynic/organs/hermes/x/SKILL.md",
          "format": "markdown",
          "frequency": "every 1h/4h via feedback and briefing consumers"
        },
        {
          "path": "kernel /agent-tasks",
          "format": "REST POST",
          "frequency": "every 10min via K15 consumer"
        }
      ],
      "status": "ACTIVE",
      "domain": "social"
    }
  }
}
