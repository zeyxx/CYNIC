{
  "schema": "cynic.agent_exposure.v1.minimal",
  "status": "normative",
  "purpose": "Faithful agent-visible projection of the CYNIC runtime surface. This file lists the desired active cynic runtime tools and classifies them by domain/tier; runtime read-back decides whether the installed artifact is compatible. cynic dev surface-audit validates that contract.",
  "policy": {
    "secrets": "Do not store real endpoints, API keys, cookies, wallet secrets, or personal account data in this file.",
    "mutation_default": "local_operator_only",
    "transport": "stdio_local_cli",
    "default_transport": "stdio",
    "fallback": "read_only_local_cli",
    "fallback_scope": "read_only_observation_only by default; human_scoped_source_mutation_only is admissible only through cynic.coordination.human_scoped_fallback_admission.v1 after runtime unavailability, incompatibility, or instability is observed. Runtime, credential, network, fleet, release, merge, push, and automatic commit mutation remain blocked.",
    "fallback_commands": [
      "cynic dev surface-audit --json",
      "cynic dev framework --json",
      "cynic runtime agents --json",
      "cynic runtime hermes-run --json --run-id <id>",
      "cynic dev policy-formality-audit --json",
      "cynic dev schema-registry-audit --json"
    ],
    "project_root": "Inject runtime paths through operator deployment context; never commit machine-local absolute paths.",
    "honesty": "This projection is source-of-truth for the desired cynic runtime surface; an installed artifact must prove compatibility and freshness before it is treated as active. Tier labels mark product/legacy surfaces that are not low-layer runtime baseline."
  },
  "runtime_protocol_profile": {
    "target_revision": "2026-07-28",
    "rust_sdk": "tokio-1",
    "supported_versions": [
      "2026-07-28"
    ],
    "transport": "stdio",
    "stateless_core": true,
    "discovery_method": "local_cli",
    "request_metadata": "per_request_meta",
    "tool_schema": "json_schema_2020_12",
    "implementation_status": "source_ready_runtime_unproven",
    "block_until": [
      "stdio_read_back",
      "local_cli_conformance_read_back"
    ]
  },
  "projection_targets": {},
  "session_handshake": {
    "schema": "cynic.agent_session_handshake.v1",
    "contract_id": "cynic.agent_mcp",
    "contract_revision": 8,
    "session_identity": {
      "schema": "cynic.agent_session_identity.v1",
      "declared_override": "CYNIC_AGENT_ID",
      "agent_type_input": "CYNIC_AGENT_TYPE",
      "default_agent_type": "codex",
      "fallback": "generate_unique_identity_once_per_mcp_process",
      "concurrency": "distinct_processes_must_have_distinct_generated_principals",
      "lifetime": "mcp_process",
      "secret": false,
      "read_back": "cynic_runtime_surface.session_identity"
    },
    "required_capabilities": [
      "cynic_runtime_surface",
      "cynic_coord_register",
      "cynic_coord_who",
      "cynic_coord_claim",
      "cynic_source_control",
      "cynic_source_change_submit",
      "cynic_validate",
      "mcp_protocol_profile:2026-07-28",
      "mcp_sdk:rmcp-3.1.0"
    ],
    "compatibility_policy": "contract revision is a minimum floor and every required capability must be observed from the running artifact; artifact version alone never proves compatibility",
    "incompatible_status": "blocked_incompatible",
    "unknown_status": "blocked_unknown_compatibility",
    "required_sequence": [
      "cynic_runtime_surface",
      "cynic_coord_register",
      "cynic_coord_who"
    ],
    "source_mutation_requires": [
      "cynic_coord_claim",
      "cynic_source_control",
      "cynic_source_change_submit"
    ],
    "human_scoped_fallback": {
      "schema": "cynic.coordination.human_scoped_fallback_admission.v1",
      "when": [
        "runtime_unavailable_observed",
        "runtime_incompatible_observed",
        "runtime_unstable_observed"
      ],
      "requires": [
        "explicit_human_approval",
        "bounded_source_target",
        "action_budget",
        "wall_time_budget",
        "agent_claims_read_back_without_active_conflict",
        "pre_and_post_git_read_back",
        "targeted_validation_read_back"
      ],
      "permits": [
        "local_source_mutation",
        "local_source_validation"
      ],
      "forbids": [
        "runtime_mutation",
        "credential_mutation",
        "network_mutation",
        "fleet_mutation",
        "release_mutation",
        "commit",
        "push",
        "merge"
      ],
      "coordination_guarantee": "best_effort_unfenced",
      "expires_when": "stable_compatible_coordination_runtime_is_observed"
    },
    "validation_surface": "cynic_validate",
    "validation_execution_role": "build_runner",
    "mutation_execution_contract": "cynic.agent_workload_envelope.v1",
    "recursive_scheduler_status": "inactive",
    "legacy_agent_task_runtime_authority": false,
