[Unit]
Description=CYNIC Phase 2.0 — K15 Outcome Measurement T+7
After=cynic-kernel.service
Wants=cynic-kernel.service

[Service]
EnvironmentFile=%h/.config/cynic/env
Type=oneshot
Environment="PYTHONUNBUFFERED=1"
Environment="OUTPUT_DIR=@CYNIC_PROJECT_ROOT@/reports/phase-2.0"
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStartPre=/bin/mkdir -p @CYNIC_PROJECT_ROOT@/reports/phase-2.0
ExecStart=/bin/sh -c 'echo "legacy outcome measurement entrypoint removed; reforge this as an organ entrypoint before enabling cynic-outcome-measurement" >&2; exit 1'
TimeoutStartSec=3600
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cynic-outcome-measurement

[Install]
WantedBy=timers.target
