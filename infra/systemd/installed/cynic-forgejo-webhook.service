[Unit]
Description=CYNIC Forgejo webhook build-trigger server
Documentation=file:///var/lib/cynic/docs/forensic_notes.md#autonomous-pipeline
After=network.target nixos-container@cynic-builder.service
Wants=network-online.target

[Service]
Type=simple
User=cynic
Group=cynic
SupplementaryGroups=cynic-agent

# Runtime paths — must match runtime-authority.json signals
RuntimeDirectory=cynic
StateDirectory=cynic
LogsDirectory=cynic
WorkingDirectory=/var/lib/cynic

# Environment — adapter-injected, no hardcoding
Environment="CYNIC_REGISTRY=/etc/cynic/registry.json"
Environment="CYNIC_BUILD_RUNNER=cynic@10.10.10.119"
Environment="CYNIC_WEBHOOK_BIND=10.10.10.103:9147"
Environment="CYNIC_WEBHOOK_PHASE=check"
Environment="RUST_MIN_STACK=16777216"

# Secrets — mount via /etc/cynic/secrets (read-only, root-owned)
EnvironmentFile=-/etc/cynic/env.runtime
ReadOnlyPaths=/etc/cynic/secrets

# Executable + bounded action surface
# No shell composition — argv direct
ExecStart=/var/lib/cynic/bin/cynic build serve-webhook \
    --bind ${CYNIC_WEBHOOK_BIND} \
    --phase ${CYNIC_WEBHOOK_PHASE} \
    --registry ${CYNIC_REGISTRY} \
    --runner ${CYNIC_BUILD_RUNNER} \
    --json

# Restart policy — bounded, auditable
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Hardening — principle of least privilege
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cynic /var/log/cynic /run/cynic
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Read-back proof via journald + state file
RuntimeMaxSec=1h
WatchdogSec=60

[Install]
WantedBy=multi-user.target