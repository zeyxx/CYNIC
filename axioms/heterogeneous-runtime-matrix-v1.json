{
  "schema": "cynic.heterogeneous_runtime_matrix.v1",
  "status": "normative",
  "purpose": "Define the heterogeneous machine matrix that binds every real node to a machine type, an organism role, a local runtime contract, an allowed actuator set, mandatory proofs, network and DNS dependencies, and build/deploy/recover capabilities.",
  "authorities": {
    "runtime_registry": "infra/registry.json",
    "node_bootstrap": "axioms/node-bootstrap-v1.json",
    "runtime_principals": "axioms/runtime-principals-v1.json",
    "rust_crate_roles": "axioms/rust-crate-roles-v1.json"
  },
  "allowed_classes": [
    "hypervisor_host",
    "kernel_node",
    "storage_node",
    "build_node",
    "edge_node",
    "legacy_node",
    "inference_node",
    "cortex_surface"
  ],
  "allowed_machine_types": [
    "bare_metal_hypervisor",
    "lxc_service_container",
    "vm_runtime_node",
    "dedicated_host",
    "operator_workstation"
  ],
  "allowed_activation_modes": [
    "observe_only",
    "local_runtime_and_actuator",
    "build_and_publish",
    "kernel_primary",
    "storage_primary",
    "cortex_interactive"
  ],
  "allowed_local_agents": [
    "cynic-node",
    "organ-forge",
    "cynic-kernel",
    "cynic-mcp"
  ],
  "allowed_local_actuators": [
    "provider_exec_bridge",
    "mesh_route_apply",
    "mesh_dns_activate",
    "service_restart",
    "storage_primary_activate",
    "lifecycle_dispatch",
    "artifact_publish",
    "kernel_service_activate",
    "manual_operator"
  ],
  "allowed_network_planes": [
    "synapse",
    "provider_fallback"
  ],
  "allowed_dns_contracts": [
    "provider_lan_resolution",
    "mesh_dns_local_stub",
    "kernel_service_resolution",
    "storage_service_resolution",
    "forge_service_resolution"
  ],
  "allowed_proof_surfaces": [
    "fleet.node.status",
    "service.status",
    "service.health",
    "network.mesh.status",
    "network.mesh.dns.activation_status",
    "storage.primary.readiness",
    "identity.smoke_check"
  ],
  "roles": [
    {
      "role": "hypervisor",
      "class": "hypervisor_host",
      "organism_role": "Provider substrate, VM host, and last-resort recovery membrane.",
      "bootstrap_target_stage": "b3_constellation_declared",
      "required_local_agents": ["cynic-node"],
      "authorized_local_actuators": ["provider_exec_bridge", "manual_operator"],
      "activation_mode": "observe_only",
      "required_network_planes": ["provider_fallback"],
      "required_dns_contracts": ["provider_lan_resolution"],
      "required_proof_surfaces": ["fleet.node.status"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "The bare hypervisor must remain observable and recoverable without becoming the canonical kernel or release bus."
    },
    {
      "role": "mesh_access_control",
      "class": "edge_node",
      "organism_role": "Local mesh control and DNS activation surface.",
      "bootstrap_target_stage": "b4_services_sampled",
      "required_local_agents": ["cynic-node"],
      "authorized_local_actuators": ["mesh_route_apply", "mesh_dns_activate", "service_restart"],
      "activation_mode": "local_runtime_and_actuator",
      "required_network_planes": ["synapse", "provider_fallback"],
      "required_dns_contracts": ["mesh_dns_local_stub", "provider_lan_resolution"],
      "required_proof_surfaces": ["network.mesh.status", "network.mesh.dns.activation_status", "fleet.node.status"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "Mesh control nodes must be able to restore local routing and DNS contracts without depending on a cortex shell."
    },
    {
      "role": "storage_primary",
      "class": "storage_node",
      "organism_role": "Primary data substrate for the kernel bus and registry-backed state.",
      "bootstrap_target_stage": "b5_runtime_actionable",
      "required_local_agents": ["cynic-node"],
      "authorized_local_actuators": ["storage_primary_activate", "service_restart"],
      "activation_mode": "storage_primary",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "storage_service_resolution", "kernel_service_resolution"],
      "required_proof_surfaces": ["storage.primary.readiness", "network.mesh.status", "service.health"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "Primary storage must prove local readiness, mesh reachability, and bounded recovery primitives before the organism treats the bus as healthy."
    },
    {
      "role": "build_runner",
      "class": "build_node",
      "organism_role": "Canonical release builder and artifact propagation executor.",
      "bootstrap_target_stage": "b5_runtime_actionable",
      "required_local_agents": ["cynic-node", "organ-forge"],
      "authorized_local_actuators": ["lifecycle_dispatch", "artifact_publish", "service_restart"],
      "activation_mode": "build_and_publish",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "forge_service_resolution"],
      "required_proof_surfaces": ["fleet.node.status", "service.status", "identity.smoke_check"],
      "capabilities": {
        "build": true,
        "deploy": false,
        "recover": true
      },
      "why": "The canonical builder creates artifacts and publish proofs but does not own the kernel primary role."
    },
    {
      "role": "kernel_primary",
      "class": "kernel_node",
      "organism_role": "Authoritative runtime bus and lifecycle verification surface.",
      "bootstrap_target_stage": "b5_runtime_actionable",
      "required_local_agents": ["cynic-node", "cynic-kernel"],
      "authorized_local_actuators": ["kernel_service_activate", "service_restart"],
      "activation_mode": "kernel_primary",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "storage_service_resolution"],
      "required_proof_surfaces": ["service.health", "fleet.node.status", "identity.smoke_check"],
      "capabilities": {
        "build": false,
        "deploy": true,
        "recover": true
      },
      "why": "The kernel primary must host the task bus, survive local restart, and prove read-back after activation."
    },
    {
      "role": "legacy_core",
      "class": "legacy_node",
      "organism_role": "Visible migration surface with no active control authority.",
      "bootstrap_target_stage": "b2_kernel_reachable",
      "required_local_agents": ["cynic-node"],
      "authorized_local_actuators": ["manual_operator"],
      "activation_mode": "observe_only",
      "required_network_planes": ["provider_fallback"],
      "required_dns_contracts": ["provider_lan_resolution"],
      "required_proof_surfaces": ["fleet.node.status"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "Legacy nodes may stay visible during migration but must not carry undeclared active authority."
    },
    {
      "role": "kernel_staging",
      "class": "kernel_node",
      "organism_role": "Promotion candidate for the kernel runtime.",
      "bootstrap_target_stage": "b4_services_sampled",
      "required_local_agents": ["cynic-node", "cynic-kernel"],
      "authorized_local_actuators": ["kernel_service_activate", "service_restart"],
      "activation_mode": "local_runtime_and_actuator",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "storage_service_resolution"],
      "required_proof_surfaces": ["service.health", "fleet.node.status", "identity.smoke_check"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "A staging kernel node must behave like a real kernel host before promotion, but without taking over deploy authority."
    },
    {
      "role": "forge_primary",
      "class": "build_node",
      "organism_role": "Release orchestration surface for the forge organ.",
      "bootstrap_target_stage": "b5_runtime_actionable",
      "required_local_agents": ["cynic-node", "organ-forge"],
      "authorized_local_actuators": ["lifecycle_dispatch", "artifact_publish", "service_restart"],
      "activation_mode": "build_and_publish",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "forge_service_resolution"],
      "required_proof_surfaces": ["fleet.node.status", "service.status"],
      "capabilities": {
        "build": true,
        "deploy": false,
        "recover": true
      },
      "why": "The forge primary orchestrates release work and artifact propagation under the same bounded runtime contract as a build runner."
    },
    {
      "role": "candidate_build_runner",
      "class": "build_node",
      "organism_role": "Promotion candidate for build and publish duty.",
      "bootstrap_target_stage": "b4_services_sampled",
      "required_local_agents": ["cynic-node", "organ-forge"],
      "authorized_local_actuators": ["lifecycle_dispatch", "artifact_publish", "service_restart"],
      "activation_mode": "build_and_publish",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "forge_service_resolution"],
      "required_proof_surfaces": ["fleet.node.status", "service.status"],
      "capabilities": {
        "build": true,
        "deploy": false,
        "recover": true
      },
      "why": "Candidate build runners must prove the same local runtime posture and artifact contract before promotion."
    },
    {
      "role": "inference_node",
      "class": "inference_node",
      "organism_role": "Dedicated inference substrate with bounded local recovery.",
      "bootstrap_target_stage": "b4_services_sampled",
      "required_local_agents": ["cynic-node"],
      "authorized_local_actuators": ["service_restart"],
      "activation_mode": "local_runtime_and_actuator",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution"],
      "required_proof_surfaces": ["fleet.node.status", "service.status"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "Inference hosts must remain observable and recoverable without bypassing node proof or network contracts."
    },
    {
      "role": "cortex_host",
      "class": "cortex_surface",
      "organism_role": "Interactive operator surface with local node proof and MCP freshness.",
      "bootstrap_target_stage": "b2_kernel_reachable",
      "required_local_agents": ["cynic-node", "cynic-mcp"],
      "authorized_local_actuators": ["manual_operator"],
      "activation_mode": "cortex_interactive",
      "required_network_planes": ["synapse"],
      "required_dns_contracts": ["mesh_dns_local_stub", "kernel_service_resolution", "forge_service_resolution"],
      "required_proof_surfaces": ["fleet.node.status", "service.status", "identity.smoke_check"],
      "capabilities": {
        "build": false,
        "deploy": false,
        "recover": true
      },
      "why": "Interactive surfaces must stay usable without becoming an implicit build or deploy authority."
    }
  ],
  "node_bindings": [
    {
      "node": "cynic-host-proxmox",
      "role": "hypervisor",
      "machine_type": "bare_metal_hypervisor"
    },
    {
      "node": "organ-headscale",
      "role": "mesh_access_control",
      "machine_type": "lxc_service_container"
    },
    {
      "node": "cynic-lxc-surrealdb",
      "role": "storage_primary",
      "machine_type": "lxc_service_container"
    },
    {
      "node": "cynic-vm-anvil",
      "role": "build_runner",
      "machine_type": "vm_runtime_node"
    },
    {
      "node": "cynic-vm-v2",
      "role": "kernel_primary",
      "machine_type": "vm_runtime_node"
    },
    {
      "node": "cynic-vm-core",
      "role": "legacy_core",
      "machine_type": "vm_runtime_node"
    },
    {
      "node": "cynic-vm-staging",
      "role": "kernel_staging",
      "machine_type": "vm_runtime_node"
    },
    {
      "node": "cynic-lxc-git",
      "role": "forge_primary",
      "machine_type": "lxc_service_container"
    },
    {
      "node": "cynic-builder",
      "role": "candidate_build_runner",
      "machine_type": "lxc_service_container"
    },
    {
      "node": "cynic-host-gpu",
      "role": "inference_node",
      "machine_type": "dedicated_host"
    },
    {
      "node": "cynic-host-cortex",
      "role": "cortex_host",
      "machine_type": "operator_workstation"
    }
  ],
  "totals": {
    "roles": 11,
    "node_bindings": 11
  }
}
