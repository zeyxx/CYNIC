[Unit]
Description=Hermes X Curation — Transform high-signal tweets to domain signals
After=hermes-ingest.service
PartOf=hermes-curation.timer

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py curation
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-curation
MemoryMax=512M
TimeoutStartSec=120

[Install]
WantedBy=hermes-curation.timer
