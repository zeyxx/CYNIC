[Unit]
Description=CYNIC Organ Forge Hermes Agent - repo lifecycle manager
After=cynic-kernel.service hermes-agent-executor.service
Wants=cynic-kernel.service

[Service]
Type=simple
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=-%h/.config/cynic/env
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@CYNIC_PROJECT_ROOT@
Environment=HERMES_AGENT_DOMAIN_ALLOW=forge,organ-forge,repo-lifecycle
Environment=HERMES_AGENT_KIND_ALLOW=hermes
Environment=HERMES_AGENT_BATCH_LIMIT=5
Environment=X_ORGAN_DIR=@CYNIC_PROJECT_ROOT@/organs/forge/state
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/forge/src/entrypoints/cli.py daemon
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
