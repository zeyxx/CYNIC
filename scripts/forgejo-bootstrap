#!/usr/bin/env bash
# Bootstrap sovereign Forgejo remote: create repo (if missing) + push current branch.
#
# Requires: FORGEJO_TOKEN (API token for owner)
# Optional:
#   FORGEJO_URL    default http://10.10.10.101:3000
#   FORGEJO_OWNER  default jeanterre13
#   FORGEJO_REPO   default CYNIC
#
# Usage:
#   FORGEJO_TOKEN=… ./scripts/forgejo-bootstrap
#   FORGEJO_TOKEN=… ./scripts/forgejo-bootstrap --push-only
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

FORGEJO_URL="${FORGEJO_URL:-http://10.10.10.101:3000}"
FORGEJO_URL="${FORGEJO_URL%/}"
FORGEJO_OWNER="${FORGEJO_OWNER:-jeanterre13}"
FORGEJO_REPO="${FORGEJO_REPO:-CYNIC}"
PUSH_ONLY=0
for a in "$@"; do
  case "$a" in
    --push-only) PUSH_ONLY=1 ;;
  esac
done

if [[ -z "${FORGEJO_TOKEN:-}" ]]; then
  echo "FORGEJO_TOKEN is required (Forgejo → Settings → Applications → Generate Token)." >&2
  echo "Owner $FORGEJO_OWNER must be active (first web login activates the account)." >&2
  exit 2
fi

api() {
  local method=$1 path=$2
  shift 2
  curl -sS -m 30 -X "$method" \
    -H "Authorization: token ${FORGEJO_TOKEN}" \
    -H "Content-Type: application/json" \
    "${FORGEJO_URL}${path}" "$@"
}

echo "==> Forgejo ${FORGEJO_URL} as ${FORGEJO_OWNER}/${FORGEJO_REPO}"

if [[ "$PUSH_ONLY" -eq 0 ]]; then
  code=$(curl -sS -m 15 -o /tmp/fg-repo.json -w "%{http_code}" \
    -H "Authorization: token ${FORGEJO_TOKEN}" \
    "${FORGEJO_URL}/api/v1/repos/${FORGEJO_OWNER}/${FORGEJO_REPO}" || echo "000")
  if [[ "$code" == "404" ]]; then
    echo "==> creating private repository"
    api POST "/api/v1/user/repos" \
      -d "{\"name\":\"${FORGEJO_REPO}\",\"private\":true,\"auto_init\":false,\"default_branch\":\"main\"}"
    echo
  else
    echo "==> repo probe HTTP ${code}"
  fi
fi

HOSTPORT="${FORGEJO_URL#http://}"
HOSTPORT="${HOSTPORT#https://}"
REMOTE_URL="${FORGEJO_URL}/${FORGEJO_OWNER}/${FORGEJO_REPO}.git"
PUSH_URL="http://${FORGEJO_OWNER}:${FORGEJO_TOKEN}@${HOSTPORT}/${FORGEJO_OWNER}/${FORGEJO_REPO}.git"

if git remote get-url forgejo >/dev/null 2>&1; then
  git remote set-url forgejo "$REMOTE_URL"
else
  git remote add forgejo "$REMOTE_URL"
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
echo "==> push ${BRANCH} → forgejo (token not stored in remote URL)"
git push "$PUSH_URL" "HEAD:refs/heads/${BRANCH}"
echo "==> forgejo remote: ${REMOTE_URL}"
echo "ok"
