[Unit]
Description=CYNIC Organ Lifecycle - supply-chain convergence loop
After=cynic-kernel.service organ-forge-hermes-agent.service
Wants=cynic-kernel.service

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@CYNIC_PROJECT_ROOT@
Environment=CYNIC_PROJECT_ROOT=@CYNIC_PROJECT_ROOT@
Environment=X_ORGAN_DIR=@CYNIC_PROJECT_ROOT@/organs/lifecycle/state
ExecStart=/usr/bin/python3 -m organs.lifecycle.src.entrypoints.controller
StandardOutput=journal
StandardError=journal

