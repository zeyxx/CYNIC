{
  "schema": "cynic.runtime_authority.v1",
  "status": "normative",
  "purpose": "Minimal operational authority map for the rebuilt low-layer organism.",
  "authority_order": [
    "observed runtime state",
    "contracts/foundation.json",
    "infra/runtime-authority.json",
    "infra/directory-tree.json",
    "infra/registry.json",
    "Cargo.toml workspace",
    "canonical Rust crates",
    "infra/agent-exposure.json"
  ],
  "canonical_runtime_surfaces": {
    "kernel_bus": {
      "owner": "crates/cynic-kernel",
      "artifact": "cynic-kernel",
      "owns": [
        "coordination",
        "legacy agent coordination messages (not mutation execution authority)",
        "durable constitutional workload journal once implemented",
        "observations",
        "health",
        "runtime read-back"
      ]
    },
    "host_substrate": {
      "owner": "crates/cynic-host",
      "artifact": null,
      "owns": [
        "OS principal policy",
        "filesystem projection",
        "package and service projection",
        "bounded process execution",
        "host proof"
      ]
    },
    "node_runtime": {
      "owner": "crates/cynic-node",
      "artifact": "cynic-node",
      "owns": [
        "node-local supervision",
        "node-local constitutional agent scheduler once activation gates are proved",
        "runtime probes",
        "network and DNS status",
        "node proof emission"
      ],
      "must_consume": [
        "crates/cynic-host",
        "crates/cynic-protocol::agent_workload"
      ]
    },
    "operator_cli": {
      "owner": "crates/cynic-cli",
      "artifact": "cynic",
      "owns": [
        "operator command grammar",
        "automation JSON output",
        "bounded local audits"
      ]
    },
    "protocol_contracts": {
      "owner": "crates/cynic-protocol",
      "artifact": null,
      "owns": [
        "shared no-I/O protocol types",
        "payload helpers",
        "agent workload admission and pure lifecycle transitions"
      ]
    },
    "runtime_basket": {
      "owner": "infra/runtime-basket.json",
      "artifact": "role-specific runtime bundle",
      "owns": [
        "canonical runtime artifact catalog",
        "role-based artifact projection",
        "artifact verification and rollback contract"
      ],
      "must_consume": [
        "observed registry role",
        "runtime artifact proof"
      ]
    },
    "proof_history": {
      "owner": "crates/cynic-askesis",
      "artifact": null,
      "owns": [
        "append-only proof/history tooling"
      ]
    },
    "inference_plane": {
      "owner": "crates/cynic-inference",
      "artifact": null,
      "owns": [
        "model vault and layout under runtime principal",
        "native local inference unit control",
        "OpenAI-compat client adapters",
        "operator chat session event store",
        "chat stream and tool loop application service"
      ],
      "must_not_own": [
        "kernel coordination SSOT",
        "operator HOME as default authority when principal is resolvable"
      ]
    }
  },
  "installed_state": {
    "owner": "crates/cynic-host",
    "runtime_user": "cynic",
    "runtime_group": "cynic",
    "agent_access_group": "cynic-agent",
    "paths": [
      "/etc/cynic",
      "/var/lib/cynic",
      "/var/log/cynic",
      "/var/lib/cynic/reports"
    ],
    "rule": "Installed runtime state is owned by the cynic principal and must not live under an operator home directory."
  },
  "installed_service_projections": {
    "systemd_system_units": {
      "authority": "runtime_authority_adapter",
      "kind": "installed_service_unit",
      "provider": "systemd",
      "owner": "crates/cynic-host",
      "file_paths": [
        "infra/os/systemd/installed/cynic-kernel.service",
        "infra/os/systemd/installed/cynic-node.service"
      ],
      "signals": [
        "User=cynic",
        "Group=cynic",
        "SupplementaryGroups=cynic-agent",
        "RuntimeDirectory=cynic",
        "CYNIC_KERNEL_SOCKET=/run/cynic/kernel.sock",
        "WorkingDirectory=/var/lib/cynic",
        "Environment=\"CYNIC_REGISTRY=/etc/cynic/registry.json\"",
        "root-owned systemd unit target"
      ],
      "rule": "Service manager projections are adapters selected by host capabilities; systemd is not the runtime model."
    },
    "openrc_services": {
      "authority": "runtime_authority_adapter",
      "kind": "installed_service_script",
      "provider": "openrc",
      "owner": "crates/cynic-host",
      "file_paths": [],
      "signals": [
        "ServiceManagerKind::OpenRc",
        "/etc/init.d",
        "rc-service",
        "rc-update"
      ]
    },
    "gasdf_relay_units": {
      "authority": "runtime_authority_adapter",
      "kind": "installed_service_unit",
      "provider": "systemd",
      "owner": "peer-project gasdf (external, read-only mirror)",
      "file_paths": [
        "infra/os/systemd/gasdf-kora-mainnet.service",
        "infra/os/systemd/gasdf-facilitator.service",
        "infra/os/systemd/gasdf-relay.service"
      ],
      "signals": [
        "User=cynic",
        "Group=cynic",
        "EnvironmentFile=/etc/cynic/secrets/gasdf/relay/mainnet.env",
        "Requires=gasdf-kora-mainnet.service gasdf-facilitator.service"
      ],
      "rule": "Peer-project runtime supervised by the OS adapter; CYNIC does not own the code, only the supervision."
    }
  },
  "operator_projections": {
    "systemd_user_units": {
      "authority": "non_authoritative_operator_projection",
      "kind": "developer_or_operator_user_unit",
      "file_paths": [
        "infra/os/systemd/cynic-kernel.service",
        "infra/os/systemd/cynic-node.service"
      ],
      "signals": [
        "/home (operator-facing fallback only)",
        "/var/lib/cynic operator working directory",
        "/etc/cynic/env operator environment file"
      ],
      "migration_rule": "Keep these units explicit as operator projections. Installed service manager adapters are declared separately under installed_service_projections."
    }
  },
  "deleted_authorities": [
    "axioms",
    "organs",
    "docs as runtime authority",
    "Python lifecycle gates",
    "product UX as low-layer proof"
  ],
  "canonical_runtime_capabilities": {
    "runtime_publisher": {
      "authority_class": "RuntimeMachineIdentity",
      "bootstrap_grant_surface": "cynic-kernel::api::rest::bootstrap_binding (POST /bootstrap/runtime_publisher)",
      "bootstrap_grant_capability": "RuntimePublisherCapabilityBinding (kernel/node-signed)",
      "granted_when": "infra/runtime_proof.v1 roles.runtime_publisher.granted == true",
      "federated_evidence": "cynic.network.runtime_proof.v1 (RuntimeProofBundle gate: runtime_publisher_admission)",
      "rbac_scope_source": "infra/agent-roles.json #runtime_publisher",
      "mutation_authority": "zero-touch runtime after 2N+1 seed; no HumanAdmin required for publish_artifact_proof / publish_settlement_receipt / publish_attest_durable_receipt",
      "spof_model": "node-local grant signed by kernel; on peer death, a node with admitted runtime_publisher resumes publishing (no single HumanAdmin SPOF)"
    }
  },
  "experimental_workspace_crates": {
    "cynic-inference": {
      "owner": "crates/cynic-inference",
      "status": "extracting",
      "role": "CYNIC native model adapters, routing, embeddings, and local vault lifecycle. Peer attach plane (OpenAI-compat) optionally consumes Osmantic ODS (https://github.com/Osmantic/ODS) as an external bootstrap product \u2014 not reimplemented. Install via host ecosystem pin `ods`; attach via inference-discover probe/apply.",
      "not_yet": [
        "canonical runtime authority surface",
        "make check core package gate",
        "agent exposure domain ownership"
      ]
    }
  },
  "agent_coherence": {
    "exposure_ssot": "infra/agent-exposure.json",
    "audit_command": "cynic dev agent-exposure --json",
    "docs_policy": "docs/ is quarantined historical prose; see docs/README.md. Docs are not runtime law.",
    "rule": "Every #[tool] must appear in agent-exposure with a domain and tier. Machine-local absolute paths are forbidden in agent projections."
  },
  "development_default": {
    "primary_check": "make check",
    "new_contract_rule": "Do not add root contract forests. Add Rust types, tests, or a small field in this file only when runtime code needs it.",
    "deletion_rule": "Anything outside the authority map must prove current runtime use before it is kept."
  },
