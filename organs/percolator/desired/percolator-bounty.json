{
  "schema_version": "1.0.0",
  "organ": "percolator",
  "source_of_truth": "CYNIC/organs/percolator/desired/percolator-bounty.json",
  "workspace": {
    "root": "percolator",
    "upstream_source_of_truth": "percolator/upstream/percolator-prog",
    "duplicate_holding_area": "percolator/_duplicates",
    "audit_workspace": "percolator/audits",
    "ops_workspace": "percolator/ops"
  },
  "scope": {
    "primary_repository": "dcccrypto/percolator-prog",
    "primary_repository_url": "https://github.com/dcccrypto/percolator-prog",
    "repositories": [
      "dcccrypto/percolator-prog",
      "dcccrypto/percolator-keeper",
      "dcccrypto/percolator-sdk",
      "dcccrypto/percolator-launch",
      "dcccrypto/percolator-nft",
      "dcccrypto/percolator-stake"
    ]
  },
  "bounty_rules": {
    "preferred_submission": "github_issue",
    "pull_request_allowed_as_separate_fix": true,
    "proof_required": true,
    "poc_tests_preferred": true,
    "avoid_speculation": true,
    "after_issue_filed": "drop_issue_link_in_discord_channel",
    "general_severity": "high_or_critical",
    "timeboxed_override_severity": "medium_to_critical",
    "payment_timing": "payments_in_batches_after_review_and_fix_or_instant_when_timeboxed_announcement_says_so",
    "pinned_message": "Opening contributions back up as of today; this is our expectation. We prefer you file an issue on your findings over a PR. All issues submitted need proof of finding and as much detail as possible, including PoC tests where possible. Double check wording and details; avoid speculation. When you file an issue, drop the link in Discord. Focus on program, keeper, SDK, launch, nft, stake. Please focus on high/critical findings only."
  },
  "risk_areas": [
    "instruction_dispatch_and_account_validation",
    "authority_signer_pda_and_seed_checks",
    "spl_token_and_token_2022_cpi_assumptions",
    "oracle_parsing_freshness_confidence_and_feed_identity",
    "insurance_fund_accounting_and_withdrawals",
    "market_resolution_and_settlement_invariants",
    "account_closure_rent_recovery_and_stale_state_reuse",
    "feature_flags_and_test_only_bypasses"
  ],
  "duplicate_policy": {
    "intake_checklist": [
      "check_researcher_feed_for_same_instruction_account_path_or_invariant",
      "check_upstream_readme_security_docs_and_tests_for_acknowledged_issues",
      "check_public_github_issues_and_pull_requests_if_available",
      "record_overlap_risk_in_finding_board",
      "if_overlap_medium_or_higher_document_why_finding_is_distinct"
    ],
    "distinctness_criteria": [
      "different_root_cause",
      "different_exploit_preconditions",
      "different_impacted_funds_state_or_authority",
      "same_bug_class_but_separate_instruction_path",
      "existing_claim_lacks_exploitability_and_we_prove_concrete_impact"
    ],
    "do_not_submit_when": [
      "same_root_cause_and_impact_already_claimed_publicly",
      "only_difference_is_wording_or_stronger_explanation",
      "issue_depends_on_non_production_test_features_unless_bounty_rules_include_them"
    ]
  },
  "inputs": {
    "discord_researcher_feed": "percolator/ops/researcher-feed.json",
    "inference_queue": "percolator/ops/infer-queue.jsonl"
  },
  "outputs": {
    "workspace_index": "percolator/workspace.json",
    "ssot_index": "percolator/SSOT.json",
    "bounty_rules": "percolator/notes/bounty-rules.json",
    "audit_plan": "percolator/notes/audit-plan.json",
    "anti_duplicate_protocol": "percolator/ops/anti-duplicate-protocol.json",
    "finding_board": "percolator/ops/finding-board.json"
  }
}
