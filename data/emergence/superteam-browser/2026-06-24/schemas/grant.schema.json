{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Grant.schema.json",
  "title": "Grant",
  "type": "object",
  "required": [
    "source_layer",
    "slug",
    "url",
    "title"
  ],
  "properties": {
    "source_layer": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "min_reward": {
      "type": [
        "number",
        "integer",
        "null"
      ]
    },
    "max_reward": {
      "type": [
        "number",
        "integer",
        "null"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "sponsor": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_applications": {
      "type": [
        "number",
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true
}