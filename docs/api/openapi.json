    "/agent-proposals": {
      "get": {
        "tags": [
          "agent-tasks"
        ],
        "summary": "List operator-reviewable agent proposals projected from agent tasks",
        "operationId": "listAgentProposals",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "all"
              ]
            }
          },
          {
            "name": "visibility",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "review_state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Json"
          },
          "400": {
            "$ref": "#/components/responses/Json"
          }
        }
      }
    },
    "/agent-proposals/{proposal_id}/review": {
      "post": {
        "tags": [
          "agent-tasks"
        ],
        "summary": "Append an operator review event for an agent proposal",
        "operationId": "reviewAgentProposal",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected",
                      "needs_redaction",
                      "needs_evidence"
                    ]
                  },
                  "reviewer": {
                    "type": "string",
                    "maxLength": 96
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "public_eligible": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Json"
          },
          "400": {
            "$ref": "#/components/responses/Json"
          },
          "503": {
            "$ref": "#/components/responses/Json"
          }
        }
      }
    },
