[Unit]
Description=CYNIC Hermes Gemini Briefing — synthesizes domain wisdom (4h cron)
After=cynic-kernel.service hermes-ingest.service
PartOf=hermes-gemini-briefing.timer

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
Environment=X_ORGAN_DIR=%h/.cynic/organs/hermes/x
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py gemini-briefing --organ-dir %h/.cynic/organs/hermes/x
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hermes-gemini-briefing.timer
