[Unit]
Description=CYNIC Hermes X.com authentication — %i account — login via hermes-browser CDP
After=hermes-browser@%i.service
Requires=hermes-browser@%i.service

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/cynic/env
Environment=HERMES_ACCOUNT=%i
Environment=PYTHONUNBUFFERED=1
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py x-login
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=default.target
