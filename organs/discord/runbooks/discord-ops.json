{
  "schema_version": "1.0.0",
  "organ": "discord",
  "runbook": "discord-ops",
  "operating_order": [
    "read_this_runbook",
    "read_desired_state",
    "run_controller",
    "verify_runtime_state",
    "emit_or_queue_downstream_work"
  ],
  "principles": [
    "edge_capture_not_kernel_dependency",
    "personal_pc_should_not_run_night_inference",
    "proxy_is_controlled_by_pac_not_global_manual_mode",
    "discord_ui_should_remain_direct_except_target_api_routes",
    "messages_are_stored_only_for_allowlisted_channels",
    "heavy_semantic_dedupe_goes_to_queue_or_remote_worker"
  ],
  "controllers": {
    "reconcile": "CYNIC/organs/discord/controllers/reconcile_discord.py",
    "feed_export": "CYNIC/organs/discord/src/percolator_watch.py",
    "queue_export": "CYNIC/organs/discord/src/percolator_dedupe_queue.py"
  },
  "verification": [
    "runtime_config_contains_desired_channel_ids",
    "pac_policy_exists_and_is_served",
    "sqlite_has_raw_events_or_messages_when_browser_loads_target_channels",
    "researcher_feed_is_generated_from_sqlite",
    "inference_queue_is_generated_without_kernel_dependency"
  ],
  "secrets_policy": "No Discord tokens, API keys, or credentials in repo desired-state files."
}
