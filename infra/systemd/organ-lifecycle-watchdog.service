[Unit]
Description=CYNIC Organ Lifecycle - freshness watchdog and reconcile loop
After=organ-lifecycle.timer cynic-kernel.service
Wants=organ-lifecycle.timer

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@CYNIC_PROJECT_ROOT@
Environment=CYNIC_PROJECT_ROOT=@CYNIC_PROJECT_ROOT@
Environment=X_ORGAN_DIR=@CYNIC_PROJECT_ROOT@/organs/lifecycle/state
ExecStart=/usr/bin/python3 -m organs.lifecycle.src.entrypoints.watchdog
StandardOutput=journal
StandardError=journal

