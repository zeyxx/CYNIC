  "inference_tools": [
    {
      "name": "cynic_inference_backends",
      "kind": "local_read",
      "ssot": "/etc/cynic/inference.toml",
      "cli_equivalent": "cynic runtime inference --json",
      "description": "Returns declared inference backends with sovereign flag, model, health status. API keys are never emitted."
    },
    {
      "name": "cynic_inference_discover",
      "kind": "local_mutation",
      "ssot": "/etc/cynic/inference.toml",
      "cli_equivalent": "cynic runtime inference-discover --json --apply",
      "description": "Peer attach plane (loose coupling): probe OpenAI-compat peers (ODS optional product) and publish into inference.toml. Schema cynic.inference.ods_discovery.v1. Does not install ODS or start native vault profiles. CLI probe-only: inference-discover --json; chat prefer: cynic chat --ods."
    },
    {
      "name": "cynic_inference_vault",
      "kind": "local_read",
      "ssot": "~/.config/cynic/models",
      "cli_equivalent": "cynic runtime inference-vault --json",
      "description": "List all sovereign local model profiles, GGUF file locations, assigned ports, and context sizes."
    },
    {
      "name": "cynic_inference_start",
      "kind": "local_mutation",
      "ssot": "~/.config/cynic/models",
      "cli_equivalent": "cynic runtime inference-start <alias> --yes --json",
      "description": "Start a specific sovereign inference model profile by alias."
    },
    {
      "name": "cynic_inference_stop",
      "kind": "local_mutation",
      "ssot": "~/.config/cynic/models",
      "cli_equivalent": "cynic runtime inference-stop --yes --json",
      "description": "Stop the currently active sovereign local inference process."
    },
    {
      "name": "cynic_inference_switch",
      "kind": "local_mutation",
      "ssot": "~/.config/cynic/models",
      "cli_equivalent": "cynic runtime inference-start <target_alias> --yes --json",
      "description": "Switch active inference backend to a target model alias."
    },
    {
      "name": "cynic_operational_benchmark",
      "kind": "read_only",
      "ssot": "infra/operational-benchmarks.json",
      "cli_equivalent": "cynic runtime inference-benchmark --json",
      "description": "Execute CYNIC native operational benchmarks against a target model profile endpoint using infra/operational-benchmarks.json datasets."
    }
  ],
