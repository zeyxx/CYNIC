[Unit]
Description=CYNIC K15 Observation Consumer — Score observations, dispatch hermes tasks
After=cynic-kernel.service
PartOf=hermes-k15-consumer.timer

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
Environment="PYTHONPATH=@CYNIC_PROJECT_ROOT@/services/cynic-python/heuristics:@CYNIC_PROJECT_ROOT@/services/cynic-python"
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py k15-consumer --kernel-url "${CYNIC_REST_ADDR}" --poll-interval 10 --max-iter 1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-k15-consumer

[Install]
WantedBy=hermes-k15-consumer.timer
