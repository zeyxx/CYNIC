{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OpportunityDetail.schema.json",
  "title": "OpportunityDetail",
  "type": "object",
  "required": [
    "source_layer",
    "slug",
    "url",
    "title"
  ],
  "properties": {
    "source_layer": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "commitment_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "reward_amount": {
      "type": [
        "number",
        "integer",
        "null"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array"
    },
    "resources_detected": {
      "type": "array"
    }
  },
  "additionalProperties": true
}