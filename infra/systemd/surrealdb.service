[Unit]
Description=SurrealDB — CYNIC storage
After=network.target

[Service]
Type=simple
# Separate env file — no SURREAL_USER/SURREAL_PASS (causes "root user not created" warning).
# Only surrealkv tuning vars.
EnvironmentFile=/etc/cynic/surrealdb.env
ExecStartPre=/bin/sh -c 'if [ -f /var/lib/cynic/.surrealdb/data/LOCK ]; then \
  if ! fuser /var/lib/cynic/.surrealdb/data/LOCK >/dev/null 2>&1; then \
    rm -f /var/lib/cynic/.surrealdb/data/LOCK && echo "Removed stale LOCK file"; \
  fi; \
fi'
ExecStart=/usr/local/bin/surreal start --bind 0.0.0.0:8000 --transaction-timeout 10s --query-timeout 30s surrealkv:///var/lib/cynic/.surrealdb/data
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65535
MemoryMax=4G

[Install]
WantedBy=default.target
