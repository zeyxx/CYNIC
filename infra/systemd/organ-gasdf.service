[Unit]
Description=CYNIC Organ — GASdf Percolator Node
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.cynic-env
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=/usr/bin/env python3 @CYNIC_PROJECT_ROOT@/organs/gasdf/src/entrypoints/cli.py --loop --interval 30
Restart=always
RestartSec=5
TimeoutStopSec=15
MemoryMax=512M

[Install]
WantedBy=default.target
