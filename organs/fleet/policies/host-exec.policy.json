{
  "schema": "cynic.host_exec.policy.v1",
  "status": "planned",
  "helper_path": "/usr/local/libexec/cynic-host-exec",
  "sudoers_subject": "cynic",
  "max_timeout_seconds": 60,
  "allowed_purposes": {
    "read_only": {
      "description": "Non-mutating diagnostics on host-native runtime surfaces.",
      "allowed_roles": [
        "cortex_host",
        "inference_node",
        "hypervisor"
      ],
      "argv_prefixes": [
        ["cat", "/etc/os-release"],
        ["hostname"],
        ["systemctl", "is-active"],
        ["systemctl", "status"]
      ]
    },
    "service_control": {
      "description": "Bounded systemd control for registry-declared services on host-native surfaces.",
      "allowed_roles": [
        "cortex_host",
        "inference_node",
        "hypervisor"
      ],
      "argv_prefixes": [
        ["systemctl", "is-active"],
        ["systemctl", "status"],
        ["systemctl", "restart"],
        ["systemctl", "start"],
        ["systemctl", "stop"]
      ],
      "requires_declared_service": true
    }
  },
  "forbidden_tokens": [
    "sh",
    "bash",
    "-c",
    "curl",
    "wget",
    "nc",
    "python",
    "python3",
    "perl",
    "ruby",
    "chmod",
    "chown",
    "tee",
    "sudo",
    ">",
    ">>",
    "|",
    "&&",
    ";"
  ]
}
