{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYNIC Organ Manifest",
  "type": "object",
  "required": [
    "description",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "planned",
        "declared",
        "transitional",
        "quarantined",
        "legacy_blocked"
      ]
    },
    "state_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "id"
      ]
    },
    {
      "required": [
        "name"
      ]
    }
  ],
  "additionalProperties": true
}
