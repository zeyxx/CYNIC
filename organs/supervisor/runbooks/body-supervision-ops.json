{
  "schema_version": "1.0.0",
  "organ": "supervisor",
  "runbook": "body-supervision-ops",
  "operating_order": [
    "read_this_runbook",
    "read_desired_state",
    "ensure_contract_and_runtime_audits_exist",
    "run_supervisor_controller",
    "inspect_supervision_state_before_creating_or_promoting_organs",
    "consume_action_queue_from_highest_priority_items"
  ],
  "principles": [
    "supervisor_is_governance_not_business_logic",
    "diagnostics_without_action_are_insufficient",
    "manifest_only_is_not_autonomy",
    "usecases_consume_observations_but_do_not_own_raw_capture",
    "kernel_unavailable_degrades_to_queue_not_chat_memory",
    "external_actions_remain_manual_gated"
  ],
  "controllers": {
    "supervise": "CYNIC/organs/supervisor/controllers/supervise_body.py",
    "static_contract_audit": "CYNIC/organs/controllers/audit_organs.py",
    "runtime_health_audit": "CYNIC/organs/controllers/audit_runtime.py"
  },
  "verification": [
    "supervision_state_exists",
    "action_queue_contains_repair_items_for_untrusted_organs",
    "trusted_organs_are_subset_of_live_or_warm_contract_complete_organs",
    "new_organ_guard_is_closed_when_any production owner is unhealthy"
  ],
  "manual_gates": [
    "Do not auto-create GitHub issues.",
    "Do not auto-post Discord messages.",
    "Do not start long-running services from this controller.",
    "Do not delete or demote organs automatically."
  ]
}
