[Unit]
Description=CYNIC Soma firewall (nftables)
Before=cynic-kernel.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cynic/firewall.nft
ExecStop=/usr/bin/sudo /usr/sbin/nft flush ruleset
ExecReload=/usr/sbin/nft -f /etc/cynic/firewall.nft

[Install]
WantedBy=default.target
