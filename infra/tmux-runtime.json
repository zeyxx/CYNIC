{
  "schema": "cynic.tmux_runtime.v1",
  "status": "normative",
  "purpose": "Single Source of Truth for agent runtime execution, process isolation, and session governance under tmux across the CYNIC fleet.",
  "naming_convention": {
    "pattern": "^cynic-agent-[a-z0-9_-]{3,32}$",
    "template": "cynic-agent-{agent_id}-{role}",
    "param_kind": "path_segment",
    "anti_rules": [
      "No shell metacharacters in session name",
      "No leading hyphen (option lookalike defense)",
      "Length must not exceed 64 characters"
    ]
  },
  "logging": {
    "spool_directory": "/var/log/cynic/agents",
    "file_template": "/var/log/cynic/agents/{session_name}.log",
    "pipe_pane_command": "/usr/bin/tmux pipe-pane -o -t {session_name} 'cat >> /var/log/cynic/agents/{session_name}.log'"
  },
  "environment_injection": [
    "CYNIC_AGENT_ID",
    "CYNIC_NODE_ROLE",
    "CYNIC_REPO_ROOT",
    "CYNIC_SESSION_KIND=tmux_isolated"
  ],
  "lifecycle": {
    "default_inactivity_timeout_seconds": 3600,
    "kill_argv_template": [
      "/usr/bin/tmux",
      "kill-session",
      "-t",
      "{session_name}"
    ],
    "list_argv_template": [
      "/usr/bin/tmux",
      "list-sessions"
    ]
  },
  "fleet_targets": [
    {
      "node": "cortex",
      "role": "development-workstation",
      "binary_path": "/usr/bin/tmux"
    },
    {
      "node": "builder",
      "role": "remote-builder-and-ci",
      "binary_path": "/usr/bin/tmux"
    },
    {
      "node": "cynic-agent-host",
      "role": "isolated-agent-lxc-container",
      "binary_path": "/usr/bin/tmux"
    }
  ]
}
