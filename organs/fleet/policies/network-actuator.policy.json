{
  "schema": "cynic.network_actuator.policy.v1",
  "status": "planned",
  "helper_path": "/usr/local/libexec/cynic-network-actuator",
  "sudoers_subject": "cynic",
  "max_timeout_seconds": 60,
  "allowed_profiles": {
    "provider-fallback-route": {
      "description": "Restore temporary provider fallback route for resurrection only.",
      "command_prefixes": [
        ["ip", "route", "replace"],
        ["ip", "route", "show"]
      ]
    },
    "synapse-route": {
      "description": "Restore canonical Synapse route on the local node.",
      "command_prefixes": [
        ["ip", "route", "replace"],
        ["ip", "route", "show"]
      ]
    },
    "wireguard-mesh": {
      "description": "Activate or inspect canonical WireGuard mesh on the local node.",
      "command_prefixes": [
        ["systemctl", "start", "wg-quick@wg0.service"],
        ["systemctl", "restart", "wg-quick@wg0.service"],
        ["systemctl", "is-active", "wg-quick@wg0.service"],
        ["wg", "show"]
      ]
    }
  },
  "forbidden_tokens": [
    "sh",
    "bash",
    "-c",
    "curl",
    "wget",
    "nc",
    "python",
    "python3",
    "perl",
    "ruby",
    ">",
    ">>",
    "|",
    "&&",
    ";"
  ]
}
