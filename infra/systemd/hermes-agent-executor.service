[Unit]
Description=CYNIC Hermes Agent Executor — autonomous meta-agent task runner
After=cynic-kernel.service hermes-ingest.service
Wants=hermes-ingest.service

[Service]
Type=simple
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=-%h/.config/cynic/env
EnvironmentFile=-%h/.cynic-env
Environment=PYTHONUNBUFFERED=1
Environment=CYNIC_SERVICE_ID=hermes-agent-executor
Environment=PYTHONPATH=@CYNIC_PROJECT_ROOT@/services/reliability-runtime/src:@CYNIC_PROJECT_ROOT@/services/observability-runtime/src:@CYNIC_PROJECT_ROOT@/services/coordination-runtime/src:@CYNIC_PROJECT_ROOT@/services/ouroboros-runtime/src:@CYNIC_PROJECT_ROOT@/services/cynic-python:@CYNIC_PROJECT_ROOT@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_AGENT_KIND_ALLOW=hermes
Environment=HERMES_AGENT_TASK_TIMEOUT_SECS=120
Environment=HERMES_AGENT_STATUS_INTERVAL_SECS=5
Environment=HERMES_AGENT_DOMAIN_DENY=organ-anvil,repo-lifecycle
ExecStart=/usr/bin/python3 -m ouroboros_runtime.core.daemon --organ-dir %h/.cynic/organs/hermes/x
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
