{
  "id": "source_admission",
  "layer": "l2_node_apply_boundary",
  "owner_crate": "cynic-protocol",
  "adapter_module": "cynic-node::main",
  "domain_owner": "cynic-protocol::{source_control,source_release,source_materialization}",
  "owner_modules": [
    "cynic-protocol::source_control",
    "cynic-protocol::source_release",
    "cynic-protocol::source_materialization",
    "cynic-node::ports::source_materialization_port",
    "cynic-node::adapters::source_snapshot_store",
    "cynic-node::adapters::source_materialization_marker",
    "cynic-node::adapters::local_source_snapshot_acquisition",
    "cynic-node::adapters::https_source_snapshot_acquisition",
    "cynic-node::adapters::local_source_materialization",
    "cynic-node::usecases::source_materialization_uc",
    "cynic-node::usecases::source_admission_uc"
  ],
  "owner_call_markers": [
    "execute_source_admission_plan",
    "execute_source_materialization"
  ],
  "responsibility": "Admit a sovereign source commit, then plan digest-addressed acquisition, isolated materialization, commit read-back, digest read-back, retention, and build-runner handoff through injected ports.",
  "mutation_policy": "read_only_by_default_explicit_apply_for_actuators",
  "canonical_entrypoints": [
    "cynic-node source-admission-plan --json --request <release-request.json> --observation <release-observation.json>",
    "cynic-node source-materialize --json --request <materialization-request.json> --node-id <node> [--state-root <path>] [--snapshot-root <path>] [--snapshot-base-url <https-base>] [--apply]"
  ],
  "evidence": [
    "cynic.source.release_request.v1",
    "cynic.source.release_observation.v1",
    "cynic.source.release_plan.v1",
    "cynic.source.materialization_request.v1",
    "cynic.source.materialization_observation.v1",
    "cynic.source.materialization_plan.v1"
  ],
  "anti_responsibilities": [
    "copy source through scp",
    "create a checkout directly over ssh",
    "issue a grant before checkout digest read-back",
    "treat a local commit as sovereign remote proof",
    "retain snapshots without an explicit expiry"
  ]
}
