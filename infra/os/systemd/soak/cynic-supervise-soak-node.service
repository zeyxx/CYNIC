[Unit]
Description=CYNIC soak parent — node role placeholder, 30-day durability run
After=network-online.target
Wants=network-online.target
# Soak only: separate state dir, no ownership of any production role.
# Crash-looping parent must stop trying, never churn boot or the host.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Soak baseline started 2026-10-16. See infra/os/systemd/soak/README.md.
# Placeholder role label: this soaks the parent, not a real node. Child is a
# sacrificial `sleep infinity`; metric is parent crash rate vs child crash rate.
Type=simple
User=cynic
Group=cynic
WorkingDirectory=/var/lib/cynic
# The binary lives outside the Cargo tree on purpose: a build in the
# shared target directory replaces the file a running unit executes,
# which is a service-under-a-reclaimable-path failure.
#
# /var/lib/cynic/bin/cynic is the operator entry point that symlinks to
# current/ (infra/directory-tree.json, runtime_install.layer): the
# release is versioned under releases/ and the switch is a symlink, so
# a unit restart picks up a new release instead of a rebuilt cache file.
ExecStart=/var/lib/cynic/bin/cynic supervise run --role node --state-dir /var/lib/cynic/supervise-soak --status-file /var/lib/cynic/supervise-soak/node.status.json -- sleep infinity
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=10
LimitNOFILE=16384
MemoryMax=256M

[Install]
WantedBy=multi-user.target
