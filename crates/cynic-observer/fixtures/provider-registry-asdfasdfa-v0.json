        "endpoint_class": "chainstack_rpc",
        "methods": ["getSignaturesForAddress", "getTransaction"],
        "max_signature_pages": 10,
        "max_transactions": 50,
        "max_blocks": 0
      }
    },
    {
      "provider": "public_rpc",
      "endpoint_ref": "https://api.mainnet.solana.com",
      "auth_ref": null,
      "enabled": true,
      "probe": {
        "provider": "public_rpc",
        "endpoint_class": "solana_public_rpc",
        "methods": ["getSignaturesForAddress", "getTransaction"],
        "max_signature_pages": 2,
        "max_transactions": 10,
        "max_blocks": 0
