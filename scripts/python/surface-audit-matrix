#!/usr/bin/env python3
"""Emit reusable matrix reports for Cynic runtime surfaces, ownership, and phases.

Outputs:
- <out_dir>/cynic-surface-audit-matrix.json (surface + ownership + kernel + runtime phase summaries)
- <out_dir>/cynic-surface-audit-matrix.md (human-consumable report)
- <out_dir>/cynic-ownership-audit.json (ownership block)
- <out_dir>/cynic-kernel-audit.json (kernel block)
"""

from __future__ import annotations

import json
import os
import subprocess
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path


def _run_audit_binary(binary: Path, args: list[str], env: dict[str, str]) -> str:
    result = subprocess.run(
        [str(binary), *args],
        text=True,
        capture_output=True,
        env=env,
    )
    if result.returncode != 0 and not result.stdout.strip():
        raise RuntimeError(f"command failed: {' '.join(result.args)}: {result.stderr}")
    return result.stdout


def _run_with_cargo(env: dict[str, str], project_root: Path) -> str:
    cargo = project_root / "scripts" / "cargo"
    result = subprocess.run(
        [
            str(cargo),
            "run",
            "-q",
            "-p",
            "cynic-cli",
            "--",
            "dev",
            "surface-audit",
            "--json",
        ],
        text=True,
        capture_output=True,
        check=False,
        env=env,
        cwd=project_root,
    )
    if result.returncode != 0 and not result.stdout.strip():
        raise RuntimeError(f"cargo run surface-audit failed: {result.stderr}")
    return result.stdout


def _run_optional_kernel_audit(binary: Path, env: dict[str, str]) -> dict | None:
    # kernel-audit often returns a blocked exit code; still emit the report if present.
    output = _run_audit_binary(binary, ["dev", "kernel-audit", "--json"], env)
    payload = output.strip()
    if not payload:
        return None
    try:
        return json.loads(payload)
    except json.JSONDecodeError as error:
        raise RuntimeError(
            f"invalid JSON from {binary} dev kernel-audit --json: {error}"
        )


def _run_runtime_phase(
    binary: Path,
    env: dict[str, str],
    command: list[str],
    label: str,
) -> dict:
    result = subprocess.run(
        [str(binary), *command],
        text=True,
        capture_output=True,
        check=False,
        env=env,
    )
    output = result.stdout.strip()
    parse_error = None
    payload = {}
    if output:
        try:
            payload = json.loads(output)
        except json.JSONDecodeError as error:
            parse_error = str(error)
    status = payload.get("status")
    if status is None:
        if parse_error is not None or result.returncode != 0:
            status = "blocked"
        else:
            status = "ok"

    return {
        "phase": label,
        "command": "cynic " + " ".join(command),
        "status": status,
        "schema": payload.get("schema", "unknown"),
        "mutates": payload.get("mutates"),
        "exit_code": result.returncode,
        "parse_error": parse_error,
    }


def _load_audit(project_root: Path, env: dict[str, str], binary_hint: Path | None) -> tuple[dict, str]:
    if binary_hint is not None and binary_hint.exists():
        raw = _run_audit_binary(
            binary_hint, ["dev", "surface-audit", "--json"], env
        )
        return json.loads(raw), "binary"
    raw = _run_with_cargo(env, project_root)
    return json.loads(raw), "cargo"


def _markdown_escape(value: str) -> str:
    return (
        value.replace("|", "\\|")
        .replace("\n", " ")
        .replace("\r", " ")
        .strip()
    )


def _status_summary(report: dict) -> str:
    return " ".join(
        [
            f"surfaces={report.get('surface_count', 0)}",
            f"ok={report.get('ok_count', 0)}",
            f"blocked={report.get('blocked_count', 0)}",
            f"status={report.get('status', 'unknown')}",
        ]
    )


def _ownership_summary(report: dict) -> dict:
    surfaces = report.get("surfaces", [])
    migration_count = sum(1 for surface in surfaces if surface.get("status") == "migrate")
    blocked_count = sum(1 for surface in surfaces if surface.get("status") == "blocked")
    dev_only_count = sum(1 for surface in surfaces if surface.get("dev_only"))
    runtime_authority_count = len(surfaces) - dev_only_count
    return {
        "surface_count": len(surfaces),
        "migration_count": migration_count,
        "blocked_count": blocked_count,
        "dev_only_count": dev_only_count,
        "runtime_authority_count": runtime_authority_count,
        "project_root_dependency_count": sum(
            1 for surface in surfaces if surface.get("depends_on_cynic_project_root")
        ),
    }


def _kernel_summary(report: dict) -> dict:
    return {
        "status": report.get("status", "unknown"),
        "total_rust_file_count": report.get("total_rust_file_count", 0),
        "covered_file_count": report.get("covered_file_count", 0),
        "uncovered_file_count": report.get("uncovered_file_count", 0),
        "next_step_count": len(report.get("next_steps", [])),
        "extract_count": sum(1 for area in report.get("areas", []) if area.get("status") == "extract"),
        "stabilize_count": sum(1 for area in report.get("areas", []) if area.get("status") == "stabilize"),
    }


def main() -> None:
    project_root = Path(__file__).resolve().parents[1]
    out_dir = Path(os.environ.get("CYNIC_SURFACE_AUDIT_REPORT_DIR", project_root / "target-cynic-ci"))
    out_dir.mkdir(parents=True, exist_ok=True)

    binary_hint = os.environ.get("CYNIC_AUDIT_CLI_BIN")
    binary = Path(binary_hint) if binary_hint else project_root / "target/debug/cynic"

    env = os.environ.copy()
    env.setdefault("CYNIC_ALLOW_LOCAL_DEV_BUILD", "1")

    report, source = _load_audit(
        project_root,
        env,
        binary if binary_hint or binary.exists() else None,
    )
    ownership_report = _run_audit_binary(
        binary,
        ["dev", "ownership-audit", "--json"],
        env,
    )
    ownership_report = json.loads(ownership_report)
    kernel_report = _run_optional_kernel_audit(binary, env)
    runtime_env = env.copy()
    runtime_env.setdefault("CYNIC_HOST_PROBE_TIMEOUT_MS", "200")
    runtime_phases = [
        _run_runtime_phase(
            binary,
            env,
            ["runtime", "harness", "--json"],
            "runtime_harness",
        ),
        _run_runtime_phase(
            binary,
            runtime_env,
            ["runtime", "conformance", "--json", "--registry", "infra/registry.json"],
            "runtime_conformance",
        ),
        _run_runtime_phase(
            binary,
            runtime_env,
            ["runtime", "metrics", "--json", "--registry", "infra/registry.json"],
            "runtime_metrics",
        ),
    ]

    report_bundle = {
        "schema": "cynic.cli.surface_audit_matrix.v1",
        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
        "source": source,
        "binary": str(binary),
        "summary": {
            "surface_count": report.get("surface_count", 0),
            "ok_count": report.get("ok_count", 0),
            "blocked_count": report.get("blocked_count", 0),
            "status": report.get("status", "unknown"),
            "agent_exposure_status": report.get("agent_exposure", {}).get("status", "unknown"),
        },
        "surfaces": report.get("surfaces", []),
        "external_projection_findings": report.get("external_projection_findings", []),
        "agent_exposure": report.get("agent_exposure", {}),
        "ownership_audit": {
            "schema": ownership_report.get("schema", "cynic.cli.ownership_audit.v1"),
            "status": ownership_report.get("status", "unknown"),
            "summary": _ownership_summary(ownership_report),
            "surfaces": ownership_report.get("surfaces", []),
        },
        "runtime_phases": runtime_phases,
        "kernel_audit": _kernel_summary(kernel_report) if kernel_report else None,
    }

    json_path = out_dir / "cynic-surface-audit-matrix.json"
    json_path.write_text(json.dumps(report_bundle, indent=2) + "\n")

    if kernel_report:
        json_path_kernel = out_dir / "cynic-kernel-audit.json"
        json_path_kernel.write_text(json.dumps(kernel_report, indent=2) + "\n")

    json_path_ownership = out_dir / "cynic-ownership-audit.json"
    json_path_ownership.write_text(
        json.dumps(report_bundle["ownership_audit"], indent=2) + "\n"
    )

    owner_counts = Counter(surface.get("owner_crate", "unknown") for surface in report.get("surfaces", []))
    owner_rows = [
        f"| {owner} | {count} |"
        for owner, count in sorted(owner_counts.items(), key=lambda item: (-item[1], item[0]))
    ]

    lines = [
        "# Cynic Surface Matrix",
        "",
        f"- Generated: {report_bundle['generated_at_utc']}",
        f"- Source: `{report_bundle['source']}` via `{report_bundle['binary']}`",
        f"- Summary: {_status_summary(report)}",
        "",
        "## Surface Matrix",
        "",
        "| Surface ID | Status | Owner Crate | Domain Owner | Mutation Policy | Adapter Module | Owner Modules | Checks | Failed Checks |",
        "| --- | --- | --- | --- | --- | --- | --- | --- | --- |",
    ]

    for surface in report.get("surfaces", []):
        checks = surface.get("checks", [])
        ok_count = len([check for check in checks if check.get("status") == "ok"])
        total_checks = len(checks)
        failed_checks = [
            check.get("name", "unknown")
            for check in checks
            if check.get("status") != "ok"
        ]
        lines.append(
            "| "
            + " | ".join(
                [
                    _markdown_escape(surface.get("id", "")),
                    _markdown_escape(surface.get("status", "")),
                    _markdown_escape(surface.get("owner_crate", "")),
                    _markdown_escape(surface.get("domain_owner", "")),
                    _markdown_escape(surface.get("mutation_policy", "")),
                    _markdown_escape(surface.get("adapter_module", "")),
                    str(len(surface.get("owner_module_paths", []))),
                    f"{ok_count}/{total_checks}",
                    _markdown_escape(", ".join(failed_checks)),
                ]
            )
            + " |",
        )

    lines.extend(
        [
            "",
            "## Ownership Matrix",
            "",
            "| Owner Crate | Surface Count |",
            "| --- | ---: |",
            *owner_rows,
            "",
            "## External Projection Findings",
            "",
        ]
    )

    if report.get("external_projection_findings"):
        lines.extend(
            [
                "| File | Class | Status |",
                "| --- | --- | --- |",
            ]
        )
        for finding in report.get("external_projection_findings", []):
            lines.append(
                "| "
                + " | ".join(
                    [
                        _markdown_escape(finding.get("file_path", "")),
                        _markdown_escape(finding.get("projection_class", "")),
                        _markdown_escape(finding.get("status", "")),
                    ]
                )
                + " |"
            )
    else:
        lines.append("_No external projection findings reported._")

    lines.extend(
        [
            "",
            "## Ownership Surface Matrix",
            "",
            "| Surface | Owner Crate | Runtime Principal | Dev Only | Runtime Authority | FS Owners | Allowed Writers | Project Root Dependency | Migration Target | Status |",
            "| --- | --- | --- | --- | --- | --- | --- | --- | --- |",
        ]
    )

    for surface in ownership_report.get("surfaces", []):
        runtime_mode = surface.get("runtime_mode", "")
        lines.append(
            "| "
            + " | ".join(
                [
                    _markdown_escape(surface.get("surface", "")),
                    _markdown_escape(surface.get("crate_owner", "")),
                    _markdown_escape(str(surface.get("runtime_principal", False))),
                    _markdown_escape(str(surface.get("dev_only", False))),
                    _markdown_escape(runtime_mode),
                    _markdown_escape(", ".join(surface.get("expected_owner_filesystem", []))),
                    _markdown_escape(", ".join(surface.get("allowed_writers", []))),
                    _markdown_escape(str(surface.get("depends_on_cynic_project_root", False))),
                    _markdown_escape(
                        str(surface.get("migration_target") or "-"),
                    ),
                    _markdown_escape(surface.get("status", "")),
                ]
            )
            + " |"
        )

    lines.extend(
        [
            "",
            "## Runtime Phases",
            "",
            "| Phase | Status | Schema | Mutates | Command |",
            "| --- | --- | --- | --- | --- |",
        ]
    )
    for phase in runtime_phases:
        mutates = phase.get("mutates")
        if mutates is None:
            mutates_str = "unknown"
        elif mutates is True:
            mutates_str = "true"
        else:
            mutates_str = "false"
        lines.append(
            "| "
            + " | ".join(
                [
                    _markdown_escape(phase.get("phase", "")),
                    _markdown_escape(phase.get("status", "")),
                    _markdown_escape(phase.get("schema", "")),
                    _markdown_escape(mutates_str),
                    _markdown_escape(phase.get("command", "")),
                ]
            )
            + " |",
        )

    parse_error_phases = [
        phase
        for phase in runtime_phases
        if phase.get("status") != "ok" and phase.get("parse_error")
    ]
    if parse_error_phases:
        lines.extend(
            [
                "",
                "### Runtime Phase Parse Errors",
                "",
            ]
        )
        for phase in parse_error_phases:
            lines.append(
                f"- {phase.get('phase')}: {_markdown_escape(phase.get('parse_error', ''))}"
            )

    if kernel_report:
        lines.extend(
            [
                "",
                "## Kernel Boundary Audit Summary",
                "",
                f"- schema: {kernel_report.get('schema', 'unknown')}",
                f"- status: {kernel_report.get('status', 'unknown')}",
                f"- total_rust_file_count: {kernel_report.get('total_rust_file_count', 0)}",
                f"- covered_file_count: {kernel_report.get('covered_file_count', 0)}",
                f"- uncovered_file_count: {kernel_report.get('uncovered_file_count', 0)}",
            ]
        )

    lines.extend(
        [
            "",
            "## Agent Exposure",
            "",
            f"- schema: {report.get('agent_exposure', {}).get('schema', 'unknown')}",
            f"- status: {report.get('agent_exposure', {}).get('status', 'unknown')}",
            f"- exposed_tool_count: {report.get('agent_exposure', {}).get('exposed_tool_count', 'unknown')}",
        ]
    )

    md_path = out_dir / "cynic-surface-audit-matrix.md"
    md_path.write_text("\n".join(lines) + "\n")

    print(f"wrote {json_path}")
    print(f"wrote {md_path}")


if __name__ == "__main__":
    main()
