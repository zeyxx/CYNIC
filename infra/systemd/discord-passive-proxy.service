[Unit]
Description=CYNIC Discord Passive Capture Proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/discord/src/entrypoints/mitmdump_launcher.py \
    -s @CYNIC_PROJECT_ROOT@/organs/discord/src/passive_proxy.py \
    --listen-host 127.0.0.1 -p 8890 \
    --set stream_large_bodies=2m \
    --set ssl_insecure=true \
    --set allow_hosts="mitm\\.it|(?:.*\\.)?mitm\\.it|(?:.*\\.)?discord\\.com|earn\\.superteam\\.fun|superteam\\.fun|(?:.*\\.)?superteam\\.fun" \
    -q
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@CYNIC_PROJECT_ROOT@
EnvironmentFile=-%h/.config/cynic/env
EnvironmentFile=-%h/.cynic/organs/discord/env
MemoryMax=512M

[Install]
WantedBy=default.target
