[Unit]
Description=CYNIC Daily Telemetry Digest — 12 metrics → 1 kernel observation
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=/bin/sh -c 'echo "legacy telemetry digest entrypoint removed; reforge telemetry digest as an organ entrypoint before enabling cynic-telemetry-digest" >&2; exit 1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cynic-telemetry-digest
MemoryMax=128M
TimeoutStartSec=120

[Install]
WantedBy=cynic-telemetry-digest.timer
