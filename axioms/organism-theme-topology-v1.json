{
    "schema": "cynic.organism_theme_topology.v1",
    "status": "normative",
    "purpose": "Define the canonical thematic ownership map for CYNIC/TALARIA/Odysseum so scattered docs remain projections, evidence, drafts or archives instead of competing source-of-truth surfaces.",
    "authorities": {
        "human_readable_policy": "docs/foundation/CYNIC_THEME_TOPOLOGY_POLICY.md",
        "repo_topology_contract": "axioms/repo-topology-v1.json",
        "source_of_truth_hierarchy": "docs/foundation/CYNIC_SOURCE_OF_TRUTH_HIERARCHY.md",
        "foundation_index": "docs/foundation/README.md"
    },
    "shared_canonical_sources": [
        "docs/foundation/TALARIA_CYNIC_NAMING.md"
    ],
    "themes": [
        {
            "id": "talaria_legal_genesis",
            "class": "legal_identity",
            "owns": [
                "TALARIA SAS identity",
                "legal genesis plan",
                "corporate ownership boundaries",
                "statutory and counsel review route"
            ],
            "canonical_sources": [
                "docs/foundation/TALARIA_CYNIC_NAMING.md",
                "docs/foundation/TALARIA_SAS_GENESIS_NOTE.md",
                "docs/foundation/CYNIC_LEGAL_GENESIS_PLAN.md",
                "docs/foundation/CYNIC_OWNERSHIP_CONSTITUTION.md",
                "docs/foundation/CYNIC_LEGAL_MICA_ROUTE_MEMO.md"
            ],
            "allowed_projection_paths": [
                "docs/internal/",
                "docs/hackathon/",
                "docs/foundation/CYNIC_FEDERATED_ECONOMIC_ARCHITECTURE.md",
                "docs/foundation/CYNIC_PROTOCOL_TOKEN_PAPER.md"
            ],
            "must_not_own": [
                "protocol token rights",
                "kernel runtime placement",
                "agent coordination rules"
            ],
            "drift_rule": "Any doc that changes legal identity, equity rights or statutory claims must update the canonical sources first."
        },
        {
            "id": "cynic_protocol_framework",
            "class": "technical_and_protocol_identity",
            "owns": [
                "CYNIC framework identity",
                "CYNIC protocol semantics",
                "E-Score",
                "Proof of History",
                "technical whitepaper",
                "token/equity firewall"
            ],
            "canonical_sources": [
                "docs/foundation/TALARIA_CYNIC_NAMING.md",
                "docs/foundation/CYNIC_SOURCE_OF_TRUTH_HIERARCHY.md",
                "docs/foundation/CYNIC_E_SCORE.md",
                "docs/foundation/CYNIC_TOKEN_EQUITY_FIREWALL.md",
                "docs/foundation/CYNIC_PROTOCOL_REVENUE_WATERFALL.md",
                "docs/foundation/CYNIC_PROTOCOL_TOKEN_PAPER.md",
                "docs/foundation/CYNIC_FAIR_LAUNCH_COVENANT.md",
                "docs/foundation/CYNIC_TECHNICAL_WHITEPAPER.md",
                "docs/foundation/CYNIC_FEDERATED_ECONOMIC_ARCHITECTURE.md"
            ],
            "allowed_projection_paths": [
                "docs/CYNIC_ECOSYSTEM_ARCHITECTURE.md",
                "docs/CYNIC_OnePager_Corporate.md",
                "docs/CYNIC_OnePager_Deeptech.md",
                "docs/CYNIC_OnePager_Web3.md",
                "docs/vivatech_2026_pitch_cynic.md",
                "docs/internal/",
                "packages/talaria-demo/",
                "packages/talaria-landing/"
            ],
            "must_not_own": [
                "TALARIA SAS share ownership",
                "current fleet desired state",
                "runtime memory"
            ],
            "drift_rule": "Public or internal materials may summarize CYNIC, but cannot redefine token, equity, E-Score or protocol revenue rules."
        },
        {
            "id": "odysseum_futardio_legacy",
            "class": "historical_context",
            "owns": [
                "Odysseum/Futard.io historical submissions",
                "incubation narrative",
                "pre-genesis pitch evidence"
            ],
            "canonical_sources": [
                "docs/internal/ODYSSEUM_FUTARDIO_WHITEPAPER.md",
                "docs/internal/futardio-odysseum-submit.md",
                "docs/internal/futardio-project-analysis-2026-05-28.md"
            ],
            "allowed_projection_paths": [
                "docs/internal/",
                "docs/hackathon/",
                "data/curated/talaria/"
            ],
            "must_not_own": [
                "current legal identity",
                "current protocol identity",
                "repo topology",
                "runtime placement"
            ],
            "drift_rule": "Odysseum/Futard.io material is historical evidence unless explicitly promoted into foundation canon."
        },
        {
            "id": "organism_runtime_topology",
            "class": "runtime_and_filesystem_topology",
            "owns": [
                "repo concern boundaries",
                "organ shape",
                "runtime placement",
                "MCP exposure",
                "coordination lifecycle"
            ],
            "canonical_sources": [
                "AGENTS.md",
                "docs/foundation/CYNIC_ORGANISM_POLICY_MATRIX.md",
                "docs/foundation/CYNIC_REPO_TOPOLOGY_POLICY.md",
                "axioms/repo-topology-v1.json",
                "axioms/coordination-protocol-v1.json",
                "axioms/infrastructure-mcp-v1.json",
                "infra/registry.json",
                "infra/agent-exposure.json"
            ],
            "allowed_projection_paths": [
                "docs/architecture/",
                "docs/ops/",
                "organs/*/MANIFEST.yaml",
                "organs/*/README.md",
                "infra/systemd/"
            ],
            "must_not_own": [
                "legal rights",
                "market truth",
                "manual backlog memory"
            ],
            "drift_rule": "Architecture docs and generated topology reports are projections; durable topology changes must update contracts, registry/exposure or organ manifests."
        },
        {
            "id": "data_and_evidence",
            "class": "evidence_and_datasets",
            "owns": [
                "curated datasets",
                "test fixtures",
                "primary evidence snapshots",
                "reports that summarize observed data"
            ],
            "canonical_sources": [
                "docs/DATA_CONSTITUTION.md",
                "data/curated/talaria/genesis.v1.json",
                "data/curated/talaria/genesis.v1.meta.json"
            ],
            "allowed_projection_paths": [
                "data/reports/",
                "docs/audit/",
                "docs/research/",
                "crates/cynic-kernel/tests/fixtures/",
                "organs/*/state/"
            ],
            "must_not_own": [
                "organism memory",
                "policy",
                "legal rights",
                "protocol allocation rules"
            ],
            "drift_rule": "Reports and state snapshots are evidence; they cannot become memory or policy unless promoted into a canonical contract, registry entry, fixture or foundation doc."
        }
    ],
    "doc_zones": [
        {
            "path": "docs/foundation/",
            "class": "normative_policy",
            "may_own": [
                "cross-cutting doctrine",
                "public foundation canon",
                "human-readable policy"
            ],
            "must_not_own": [
                "runtime snapshots",
                "private draft backlog"
            ],
            "canonicality": "canonical_when_indexed"
        },
        {
            "path": "axioms/",
            "class": "machine_contract",
            "may_own": [
                "JSON semantic contracts",
                "payload schemas",
                "consumer profiles"
            ],
            "must_not_own": [
                "freeform markdown policy",
                "unstructured planning"
            ],
            "canonicality": "canonical_by_schema_and_status"
        },
        {
            "path": "docs/architecture/",
            "class": "implementation_map",
            "may_own": [
                "current implementation maps",
                "target architecture sketches"
            ],
            "must_not_own": [
                "policy that bypasses foundation docs",
                "registry desired state"
            ],
            "canonicality": "projection_unless_referenced_by_contract"
        },
        {
            "path": "docs/internal/",
            "class": "private_draft_and_context",
            "may_own": [
                "draft communications",
                "historical context",
                "private working notes"
            ],
            "must_not_own": [
                "legal truth",
                "protocol truth",
                "runtime truth"
            ],
            "canonicality": "noncanonical_evidence"
        },
        {
            "path": "docs/hackathon/",
            "class": "submission_projection",
            "may_own": [
                "submission drafts",
                "demo scripts",
                "external program packaging"
            ],
            "must_not_own": [
                "identity rules",
                "token/equity claims",
                "runtime topology"
            ],
            "canonicality": "projection_only"
        },
        {
            "path": "data/",
            "class": "curated_data_and_reports",
            "may_own": [
                "curated machine datasets",
                "generated reports",
                "evidence artifacts"
            ],
            "must_not_own": [
                "policy",
                "coordination memory",
                "deployment desired state"
            ],
            "canonicality": "canonical_only_for_declared_curated_datasets"
        },
        {
            "path": "packages/",
            "class": "product_projection",
            "may_own": [
                "frontend applications",
                "public UI copy",
                "package-local README files"
            ],
            "must_not_own": [
                "foundation doctrine",
                "legal claims",
                "protocol allocation rules"
            ],
            "canonicality": "projection_only"
        }
    ],
    "promotion_rule": {
        "from": [
            "docs/internal/",
            "docs/hackathon/",
            "data/reports/",
            "docs/research/",
            "docs/reference/"
        ],
        "to": [
            "docs/foundation/",
            "axioms/",
            "infra/registry.json",
            "infra/agent-exposure.json",
            "organs/<role>/MANIFEST.yaml"
        ],
        "requires": [
            "declared theme id",
            "canonical source update",
            "drift rule preserved",
            "mechanical validation when the concern is machine-readable"
        ]
    }
}
