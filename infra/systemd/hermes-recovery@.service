[Unit]
Description=CYNIC Hermes X recovery daemon — %i account
After=network-online.target hermes-ingest@%i.service
Wants=network-online.target
PartOf=hermes-ingest@%i.service

[Service]
Type=simple
EnvironmentFile=%h/.config/cynic/env
Environment=HERMES_ACCOUNT=%i
Environment=RECOVERY_LOG_PATH=%h/.cynic/organs/hermes/x/recovery.log
Environment=RECOVERY_CHECK_INTERVAL=30
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py x-recovery
Restart=on-failure
RestartSec=10
# Recovery daemon must keep running to detect failures — aggressive restart
StandardOutput=append:%h/.cynic/organs/hermes/x/recovery.log
StandardError=append:%h/.cynic/organs/hermes/x/recovery.log
# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
