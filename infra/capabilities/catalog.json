{
  "schema": "cynic.capability_catalog.v1",
  "status": "normative",
  "authority": {
    "declared_by": "docs/design/single-binary-capability-selected.md",
    "observed_by": "cynic privilege catalog --json",
    "rule": "A privileged action runs only if its capability is declared here AND installed on this node AND every parameter validates. There is one catalog and one admit(); a domain that builds its own argv is a second source of truth.",
    "negative_boundary": "This file never carries a secret, a hostname, or a path that varies per node. Node-specific values are parameters, validated at admission."
  },
  "consolidates": [
    "infra/privilege/pve-pct-helper.policy.json",
    "infra/privilege/transport-capabilities.policy.json"
  ],
  "capabilities": [
    {
      "id": "forgejo-inspect-app-ini",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "exec",
        "{vmid}",
        "--",
        "ls",
        "-la",
        "/etc/forgejo/app.ini"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "read-only inspection of forgejo app.ini inside a CT"
    },
    {
      "id": "forgejo-inspect-user",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "exec",
        "{vmid}",
        "--",
        "sh",
        "-c",
        "id forgejo; ls /usr/local/bin/forgejo /usr/bin/forgejo 2>/dev/null; which sudo || true"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "read-only inspection of forgejo user and binary locations inside a CT"
    },
    {
      "id": "forgejo-machine-token",
      "domain": "identity",
      "argv_template": [
        "/usr/sbin/pct",
        "exec",
        "{vmid}",
        "--",
        "forgejo",
        "admin",
        "user",
        "generate-access-token",
        "--username",
        "{principal}",
        "--token-name",
        "{token_name}",
        "--scopes",
        "write:repository"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        },
        {
          "name": "principal",
          "kind": "path_segment"
        },
        {
          "name": "token_name",
          "kind": "path_segment"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "one-shot RuntimeMachineIdentity issuance for a Forgejo principal"
    },
    {
      "id": "node-control",
      "domain": "runtime",
      "argv_template": [
        "node",
        "control"
      ],
      "params": [],
      "requires_root": false,
      "mandatory": true,
      "purpose": "supervised node runtime (the node cannot function without it)"
    },
    {
      "id": "pct-clone",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "clone",
        "{source}",
        "{target}",
        "--full"
      ],
      "params": [
        {
          "name": "source",
          "kind": "vmid"
        },
        {
          "name": "target",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "ephemeral build container provisioning from a clean template"
    },
    {
      "id": "pct-destroy",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "destroy",
        "{vmid}"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "destroy an ephemeral container after read-back proof"
    },
    {
      "id": "pct-list",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "list"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "CT inventory for fleet observation (read-only)"
    },
    {
      "id": "pct-probe-hostname",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "exec",
        "{vmid}",
        "--",
        "hostname"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "read-only hostname observation of a CT"
    },
    {
      "id": "pct-resize",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "resize",
        "{vmid}",
        "rootfs",
        "{delta}"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        },
        {
          "name": "delta",
          "kind": "size_delta"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "grow a container rootfs (never shrink)"
    },
    {
      "id": "pct-status",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/sbin/pct",
        "status",
        "{vmid}"
      ],
      "params": [
        {
          "name": "vmid",
          "kind": "vmid"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "observe a container's run state (read-only)"
    },
    {
      "id": "systemctl-restart-pve-cluster",
      "domain": "system",
      "argv_template": [
        "/usr/bin/systemctl",
        "restart",
        "pve-cluster"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "hypervisor watchdog recovery of a wedged pmxcfs"
    },
    {
      "id": "systemctl-restart-pvedaemon",
      "domain": "system",
      "argv_template": [
        "/usr/bin/systemctl",
        "restart",
        "pvedaemon"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "hypervisor watchdog recovery of the PVE API daemon"
    },
    {
      "id": "apt-install",
      "domain": "system",
      "argv_template": [
        "/usr/bin/apt-get",
        "install",
        "-y",
        "{package}"
      ],
      "params": [
        {
          "name": "package",
          "kind": "path_segment"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "install a system package via apt (e.g., tmux, htop)"
    },
    {
      "id": "tmux-session-create",
      "domain": "runtime",
      "argv_template": [
        "/usr/bin/tmux",
        "new-session",
        "-d",
        "-s",
        "{session_name}"
      ],
      "params": [
        {
          "name": "session_name",
          "kind": "path_segment"
        }
      ],
      "requires_root": false,
      "mandatory": false,
      "purpose": "create a detached tmux session for long-running agents"
    },
    {
      "id": "tmux-session-observe",
      "domain": "runtime",
      "argv_template": [
        "/usr/bin/tmux",
        "list-sessions"
      ],
      "params": [],
      "requires_root": false,
      "mandatory": false,
      "purpose": "observe tmux sessions (read-only)"
    },
    {
      "id": "tmux-session-kill",
      "domain": "runtime",
      "argv_template": [
        "/usr/bin/tmux",
        "kill-session",
        "-t",
        "{session_name}"
      ],
      "params": [
        {
          "name": "session_name",
          "kind": "path_segment"
        }
      ],
      "requires_root": false,
      "mandatory": false,
      "purpose": "terminate a detached tmux session cleanly"
    },
    {
      "id": "bridge-install",
      "domain": "host-bridge",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "bridge",
        "install",
        "--apply"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "install the root-owned privilege bridge from a staged bundle"
    },
    {
      "id": "pve-helper-install",
      "domain": "hypervisor",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "membrane",
        "install",
        "--apply",
        "--yes",
        "--policy",
        "{policy}",
        "--bundle-dir",
        "{bundle_dir}"
      ],
      "params": [
        {
          "name": "policy",
          "kind": "absolute_path"
        },
        {
          "name": "bundle_dir",
          "kind": "local_path"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "install the generated pve sudoers membrane (consent-gated)"
    },
    {
      "id": "principal-prepare",
      "domain": "host-principal",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "principal",
        "prepare",
        "--apply"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "create the runtime principal (user/group/home/state)"
    },
    {
      "id": "runtime-seed-reconcile",
      "domain": "runtime-seed",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "seed",
        "reconcile",
        "--request",
        "{request}",
        "--apply"
      ],
      "params": [
        {
          "name": "request",
          "kind": "absolute_path"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "run the seed rotation ceremony against a signed request"
    },
    {
      "id": "service-reconcile",
      "domain": "host-service",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "service",
        "reconcile",
        "--node",
        "{node}",
        "--registry",
        "{registry}",
        "{unit}",
        "--apply"
      ],
      "params": [
        {
          "name": "node",
          "kind": "path_segment"
        },
        {
          "name": "registry",
          "kind": "absolute_path"
        },
        {
          "name": "unit",
          "kind": "path_segment"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "reconcile a systemd unit to declared state"
    },
    {
      "id": "network-actuate",
      "domain": "network",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "network",
        "actuate",
        "--profile",
        "{profile}",
        "--target",
        "{target}",
        "--registry",
        "{registry}",
        "--apply"
      ],
      "params": [
        {
          "name": "profile",
          "kind": "path_segment"
        },
        {
          "name": "target",
          "kind": "path_segment"
        },
        {
          "name": "registry",
          "kind": "absolute_path"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "actuate a network profile against an observed target"
    },
    {
      "id": "network-baseline-apply",
      "domain": "network",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "network",
        "baseline",
        "--profile",
        "{profile}",
        "--target",
        "{target}",
        "--registry",
        "{registry}",
        "--apply"
      ],
      "params": [
        {
          "name": "profile",
          "kind": "path_segment"
        },
        {
          "name": "target",
          "kind": "path_segment"
        },
        {
          "name": "registry",
          "kind": "absolute_path"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "apply the network baseline (mutating side; observe without --apply)"
    },
    {
      "id": "storage-identity-enroll",
      "domain": "storage",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "storage",
        "enroll",
        "--endpoint",
        "{endpoint}",
        "--namespace",
        "{namespace}",
        "--database",
        "{database}",
        "--admin-user",
        "{admin_user}",
        "--username",
        "{username}",
        "--apply"
      ],
      "params": [
        {
          "name": "endpoint",
          "kind": "endpoint"
        },
        {
          "name": "namespace",
          "kind": "path_segment"
        },
        {
          "name": "database",
          "kind": "path_segment"
        },
        {
          "name": "admin_user",
          "kind": "path_segment"
        },
        {
          "name": "username",
          "kind": "path_segment"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "enroll the storage runtime identity (root + interactive admin secret)"
    },
    {
      "id": "storage-schema-migrate",
      "domain": "storage",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "storage",
        "migrate",
        "--endpoint",
        "{endpoint}",
        "--namespace",
        "{namespace}",
        "--database",
        "{database}",
        "--admin-user",
        "{admin_user}",
        "--schema-file",
        "{schema_file}",
        "--apply"
      ],
      "params": [
        {
          "name": "endpoint",
          "kind": "endpoint"
        },
        {
          "name": "namespace",
          "kind": "path_segment"
        },
        {
          "name": "database",
          "kind": "path_segment"
        },
        {
          "name": "admin_user",
          "kind": "path_segment"
        },
        {
          "name": "schema_file",
          "kind": "absolute_path"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "migrate the storage schema (root + interactive admin secret)"
    },
    {
      "id": "hardware-baseline-enroll",
      "domain": "host-baseline",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "hardware",
        "enroll",
        "--apply"
      ],
      "params": [],
      "requires_root": true,
      "mandatory": false,
      "purpose": "record the hardware baseline for attestation"
    },
    {
      "id": "ssh-trust-admit",
      "domain": "ssh-trust",
      "argv_template": [
        "/usr/local/bin/cynic",
        "host",
        "ssh",
        "admit",
        "--host",
        "{host}",
        "--fingerprint",
        "{fingerprint}",
        "--attestation-source",
        "{attestation_source}",
        "--yes"
      ],
      "params": [
        {
          "name": "host",
          "kind": "endpoint"
        },
        {
          "name": "fingerprint",
          "kind": "sha256_hex"
        },
        {
          "name": "attestation_source",
          "kind": "path_segment"
        }
      ],
      "requires_root": true,
      "mandatory": false,
      "purpose": "admit an SSH host key into the system trust store"
    }
  ]
}
