[Unit]
Description=CYNIC Dog Health Monitor — K15 Acting Consumer
After=cynic-kernel.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "legacy dog health shell entrypoint closed; reforge as supervisor/dog organ entrypoint before enabling cynic-dog-monitor" >&2; exit 1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cynic-dog-monitor
EnvironmentFile=%h/.config/cynic/env
