{
  "version": 1,
  "schema": "cynic.registry.v1.minimal",
  "purpose": "Minimal runtime placement registry for the rebuilt low-layer organism.",
  "network_policy": {
    "canonical_service_plane": "synapse",
    "planes": {
      "management": {
        "cidr": "192.168.100.0/24",
        "canonical": false,
        "purpose": "direct bare-metal management transport"
      },
      "synapse": {
        "cidr": "10.10.10.0/24",
        "dns_zone": "synapse.cynic",
        "canonical": true
      }
    },
    "reservations": [
      {
        "name": "cynic-host-proxmox",
        "addresses": {
          "management": "192.168.100.1",
          "synapse": "10.10.10.1"
        }
      },
      {
        "name": "cynic-host-cortex",
        "addresses": {
          "management": "192.168.100.2"
        }
      },
      {
        "name": "forgejo",
        "dns": [
          "forgejo.synapse.cynic"
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "cynic-host-proxmox",
      "name": "cynic-host-proxmox",
      "aliases": ["pve"],
      "role": "hypervisor",
      "host_family": "linux.proxmox.systemd",
      "provider_controls": ["proxmox"],
      "status": "observed",
      "deploy_target": false,
      "transports": {
        "ssh": {
          "target": "proxmox-forge",
          "trust": "known_hosts"
        }
      },
      "network": {
        "management": "192.168.100.1",
        "synapse": "10.10.10.1"
      },
      "services": []
    },
    {
      "id": "cynic-host-cortex",
      "name": "cynic-host-cortex",
      "aliases": ["ubuntu"],
      "role": "cortex_host",
      "status": "candidate",
      "deploy_target": false,
      "network": {
        "management": "192.168.100.2"
      },
      "network_links": [
        {
          "plane": "management",
          "provider": "network-manager",
          "interface": "enp42s0",
          "connection": "Connexion filaire 1",
          "address": "192.168.100.2/24",
          "gateway": "192.168.100.1",
          "routes": ["10.10.10.0/24"],
          "default_route": false
        }
      ],
      "services": []
    },
    {
      "id": "local-kernel",
      "name": "local-kernel",
      "role": "kernel_primary",
      "status": "candidate",
      "deploy_target": true,
      "network": {
        "synapse": "127.0.0.1"
      },
      "services": [
        {
          "name": "cynic-kernel",
          "artifact": "cynic-kernel",
          "port": 3030,
          "unit": "cynic-kernel.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "tcp",
            "port": 3030
          }
        },
        {
          "name": "cynic-node",
          "artifact": "cynic-node",
          "unit": "cynic-node.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "process",
            "process": "cynic-node"
          }
        },
        {
          "name": "surrealdb",
          "unit": "surrealdb.service",
          "port": 8000,
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "tcp",
            "port": 8000
          }
        }
      ]
    },
    {
      "id": "cynic-builder",
      "name": "cynic-builder",
      "aliases": [
        "10.10.10.119"
      ],
      "role": "build_runner",
      "host_family": "linux.ubuntu.systemd",
      "status": "candidate",
      "deploy_target": false,
      "proxmox_id": "lxc/105",
      "transports": {
        "ssh": {
          "target": "cynic-builder",
          "trust": "known_hosts"
        }
      },
      "network": {
        "synapse": "10.10.10.119"
      },
      "source_workspace_layout": {
        "repository_store": "source/repositories",
        "workspace_store": "source/workspaces",
        "principal": "cynic",
        "dedicated_worktrees": true,
        "repositories": [
          {
            "id": "cynic",
            "relative_path": "CYNIC"
          }
        ]
      },
      "services": []
    },
    {
      "id": "forgejo",
      "name": "forgejo",
      "aliases": [
        "organ-forgejo",
        "cynic-lxc-git"
      ],
      "role": "forge_primary",
      "status": "candidate",
      "deploy_target": true,
      "proxmox_id": "lxc/101",
      "network": {
        "local": "10.10.10.101",
        "synapse": "10.10.10.101"
      },
      "services": [
        {
          "name": "ssh",
          "scheme": "ssh",
          "port": 22
        },
        {
          "name": "forgejo-backend",
          "scheme": "http",
          "port": 3000
        },
        {
          "name": "forgejo-api-tls",
          "scheme": "https",
          "port": 443
        }
      ]
    }
  ],
  "fleet_desired": {
    "targets": [
      {
        "id": "cynic-builder-bootstrap",
        "provider": "proxmox",
        "resource_id": "lxc/105",
        "role": "build_runner",
        "desired_power": "running"
      },
      {
        "id": "forgejo-primary",
        "provider": "proxmox",
        "resource_id": "lxc/101",
        "role": "forge_primary",
        "desired_power": "running"
      }
    ]
  },
  "lifecycle": {
    "kernel_release": {
      "build_runner_role": "build_runner",
      "deploy_target_role": "kernel_primary",
      "host_bootstrap": {
        "role_profiles": {
          "kernel_primary": {
            "target_stage": "h6_host_actionable",
            "required_domains": [
              "host",
              "services",
              "storage",
              "kernel"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "kernel_service_observed",
              "storage_health_observed"
            ]
          },
          "build_runner": {
            "target_stage": "h4_privilege_helpers_ready",
            "required_domains": [
              "host",
              "toolchain",
              "build"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "cargo_check_observed",
              "binary_build_observed"
            ]
          },
          "storage_primary": {
            "target_stage": "h5_services_projected",
            "required_domains": [
              "host",
              "storage"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "storage_health_observed"
            ]
          },
          "forge_primary": {
            "target_stage": "h5_services_projected",
            "required_domains": [
              "host",
              "services",
              "network",
              "forge"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "forgejo_backend_observed",
              "forgejo_tls_identity_observed"
            ]
          }
        }
      },
      "runtime_artifacts": [
        "cynic-kernel",
        "cynic-node",
        "cynic-mcp",
        "cynic"
      ]
    }
  }
}
