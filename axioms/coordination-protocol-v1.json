{
    "schema": "cynic.coordination_protocol.v1",
    "status": "normative",
    "coordination_protocol": {
        "id": "urn:cynic:coordination:protocol:v1",
        "version": "1.0.0",
        "name": "Portable Coordination Protocol",
        "description": "Transport-agnostic coordination event contract exposed by CYNIC MCP",
        "governance": {
            "source_of_truth": "project_repository",
            "transport_is_transient": true,
            "sensitivity": "repo_first",
            "default_retention_hint": "repo_authoritative_events"
        },
        "event_contract": {
            "version": "coordination-event-v1",
            "required_fields_by_event": {
                "workstream.started": [
                    "project",
                    "workstream",
                    "summary"
                ],
                "workstream.blocked": [
                    "project",
                    "workstream",
                    "summary"
                ],
                "workstream.updated": [
                    "project",
                    "workstream",
                    "summary"
                ],
                "interface.changed": [
                    "project",
                    "workstream",
                    "summary"
                ],
                "run.completed": [
                    "project",
                    "workstream",
                    "summary"
                ],
                "artifact.share": [
                    "project",
                    "workstream",
                    "summary",
                    "artifacts"
                ],
                "thread.reply": [
                    "project",
                    "workstream",
                    "thread_id",
                    "message"
                ],
                "decision.record": [
                    "project",
                    "workstream",
                    "summary",
                    "artifacts",
                    "open_points"
                ],
                "decision.recorded": [
                    "project",
                    "workstream",
                    "topic",
                    "decision",
                    "rationale",
                    "source_artifact"
                ]
            },
            "schema": {
                "required": [
                    "coordination_contract",
                    "project",
                    "event",
                    "workstream",
                    "summary"
                ],
                "properties": {
                    "coordination_contract": {
                        "required": [
                            "version",
                            "operation"
                        ],
                        "allowed_operations": [
                            "status.publish",
                            "thread.reply",
                            "artifact.share",
                            "decision.record"
                        ]
                    },
                    "project": {
                        "type": "string",
                        "description": "Canonical project id, e.g. privacy-ethereum-framework"
                    },
                    "workstream": {
                        "type": "string",
                        "description": "Workstream or stage identifier"
                    },
                    "thread_id": {
                        "type": "string",
                        "nullable": true,
                        "description": "Optional thread key used for grouped discussion"
                    },
                    "status": {
                        "type": "string",
                        "description": "Machine state label such as stable, blocked, review-needed"
                    },
                    "summary": {
                        "type": "string",
                        "description": "Human-readable concise statement"
                    },
                    "event": {
                        "type": "string",
                        "enum": [
                            "workstream.started",
                            "workstream.blocked",
                            "workstream.updated",
                            "interface.changed",
                            "run.completed",
                            "decision.recorded",
                            "thread.reply",
                            "artifact.share",
                            "decision.record"
                        ]
                    },
                    "artifacts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Repo authoritative artifact references",
                        "default": []
                    },
                    "open_points": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Unresolved follow-ups",
                        "default": []
                    },
                    "extra": {
                        "type": "object",
                        "description": "Repo-specific extension fields"
                    }
                }
            }
        },
        "permission_model": {
            "version": "1.0.0",
            "identity_attributes": [
                "project",
                "workstream",
                "agent_kind",
                "sensitivity"
            ],
            "default_mode": "strict",
            "default_allow_unknown_client": false,
            "profiles": {
                "clients": {
                    "codex": {
                        "kind": "cli-agent",
                        "allowed_operations": [
                            "coordination.status.publish",
                            "coordination.status.read",
                            "coordination.thread.reply",
                            "coordination.artifact.share",
                            "coordination.decision.record"
                        ],
                        "project_scope": "*"
                    },
                    "claude": {
                        "kind": "cli-agent",
                        "allowed_operations": [
                            "coordination.status.publish",
                            "coordination.status.read",
                            "coordination.thread.reply",
                            "coordination.artifact.share",
                            "coordination.decision.record"
                        ],
                        "project_scope": "*"
                    },
                    "antigravity": {
                        "kind": "cli-agent",
                        "allowed_operations": [
                            "coordination.status.publish",
                            "coordination.status.read",
                            "coordination.thread.reply",
                            "coordination.artifact.share",
                            "coordination.decision.record"
                        ],
                        "project_scope": "*"
                    },
                    "hermes": {
                        "kind": "organ-adapter",
                        "allowed_operations": [
                            "coordination.status.publish",
                            "coordination.status.read",
                            "coordination.thread.reply",
                            "coordination.artifact.share",
                            "coordination.decision.record"
                        ],
                        "project_scope": "*"
                    }
                }
            }
        },
        "capabilities": {
            "mcp_tools": {
                "coordination_status_publish": {
                    "semantic": "coordination.status.publish",
                    "input_contract": {
                        "required": [
                            "project",
                            "workstream",
                            "event",
                            "summary"
                        ],
                        "optional": [
                            "branch",
                            "status",
                            "artifacts",
                            "open_points",
                            "thread_id",
                            "payload",
                            "sensitivity",
                            "contract_version"
                        ]
                    },
                    "notes": "Persists event in /observe with domain=coordination"
                },
                "coordination_status_read": {
                    "semantic": "coordination.status.read",
                    "input_contract": {
                        "required": [
                            "project"
                        ],
                        "optional": [
                            "workstream",
                            "thread_id",
                            "limit",
                            "domain"
                        ]
                    }
                },
                "coordination_thread_reply": {
                    "semantic": "coordination.thread.reply",
                    "input_contract": {
                        "required": [
                            "project",
                            "workstream",
                            "thread_id",
                            "message"
                        ],
                        "optional": [
                            "branch",
                            "reply_to",
                            "artifacts"
                        ]
                    }
                },
                "coordination_artifact_share": {
                    "semantic": "coordination.artifact.share",
                    "input_contract": {
                        "required": [
                            "project",
                            "workstream",
                            "artifacts"
                        ],
                        "optional": [
                            "thread_id",
                            "message",
                            "branch"
                        ]
                    }
                },
                "coordination_decision_record": {
                    "semantic": "coordination.decision.record",
                    "input_contract": {
                        "required": [
                            "project",
                            "workstream",
                            "topic",
                            "decision",
                            "rationale",
                            "source_artifact"
                        ],
                        "optional": [
                            "branch",
                            "thread_id",
                            "open_points",
                            "artifacts"
                        ]
                    }
                }
            }
        },
        "routing_model": {
            "domain": "coordination",
            "target": "coord://{project}/{workstream}[#{thread_id}]",
            "adapter_binding": [
                "slack"
            ],
            "channel_mapping": "routing_rules.slack_routing in infra/registry.json"
        },
        "privacy": {
            "policy": "Do not treat Slack as source of truth",
            "allow": [
                "commit_refs",
                "artifact_paths",
                "decision_records",
                "risk_summary"
            ],
            "deny": [
                "secrets",
                "raw_sensitive_logs",
                "credentials",
                "private_keys",
                "PII"
            ]
        }
    }
}
