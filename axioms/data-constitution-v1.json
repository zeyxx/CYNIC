{
  "$schema": "./schemas/data-constitution-v1.schema.json",
  "schema": "cynic.data_constitution.v1",
  "status": "normative",
  "data_rules": {
    "membrane_policy": {
      "enforce_validation_library": {
        "python": [
          "pydantic"
        ],
        "rust": [
          "serde",
          "serde_json"
        ]
      },
      "requires_manifest_schemas": true
    },
    "state_isolation_policy": {
      "forbidden_imports": [
        "organs.*.state"
      ],
      "allowed_shared_bus": [
        "cynic-kernel",
        "surrealdb"
      ]
    },
    "persistence_policy": {
      "allowed_extensions_under_state": [
        ".jsonl",
        ".meta.json",
        ".png",
        ".json"
      ],
      "enforce_append_only_for_extensions": [
        ".jsonl"
      ]
    }
  }
}
