[Unit]
Description=Hermes X Search Generator — Autonomous search from SKILL.md wisdom
After=hermes-data-organism.service
PartOf=hermes-search-generator.timer

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/twitter/src/entrypoints/python_launcher.py @CYNIC_PROJECT_ROOT@/organs/twitter/src/entrypoints/hermes_x.py search-generator
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-search-generator
MemoryMax=256M
TimeoutStartSec=60

[Install]
WantedBy=hermes-search-generator.timer
