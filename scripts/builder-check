#!/usr/bin/env bash
# scripts/builder-check — convenience wrapper around native cynic-build-runner.
#
# Does NOT re-implement ports — delegates to `cynic build trigger` (native
# BuildRunnerPort trait in cynic-node/src/ports/build_runner.rs).
# Covers the rsync→ssh→grep manual loop until the agent-facing PR webhook
# (forgejo-build-webhook) is wired (see references/ of cynic-dev-build).
#
# Usage:
#   scripts/builder-check [-p crates...] [--target /tmp/cynic-x] [--phase check|build]
#
# Exit: 0 = pass, non-zero = fail (mirrors cargo exit). Proof = builder log tail.

set -eu

WORKDIR="$(cd "$(dirname "$0")/.." && pwd)"
BUILDER_HOST="${CYNIC_BUILDER_HOST:-cynic-builder-ssh}"
BUILDER_PATH="${BUILD_TARGET:-/tmp/cynic-verify}"
PHASE="check"
pkgs=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--package) pkgs+=("$2"); shift 2 ;;
        --target) BUILDER_PATH="$2"; shift 2 ;;
        --phase) PHASE="$2"; shift 2 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done
[[ ${#pkgs[@]} -eq 0 ]] && pkgs=(cynic-eval cynic-protocol)
# format as -p pkg -p pkg
pkg_args=()
for p in "${pkgs[@]}"; do pkg_args+=("-p" "$p"); done

echo "[builder-check] rsync local→${BUILDER_HOST}:${BUILDER_PATH}/"
rsync -az --delete --exclude=.git --exclude=target \
    "$WORKDIR/" "${BUILDER_HOST}:${BUILDER_PATH}/"

echo "[builder-check] cargo ${PHASE} ${pkgs[*]} via native surface"
ssh "$BUILDER_HOST" "cd ${BUILDER_PATH} && \
    CYNIC_BUILD_ADMISSION_VERIFIED=1 RUST_MIN_STACK=8589934592 \
    cargo ${PHASE} ${pkg_args[*]} --lib"
