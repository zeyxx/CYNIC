[Unit]
Description=Token Benchmark — judge 45 tracked tokens, measure discrimination
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/cynic/env
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=/bin/sh -c 'echo "legacy token benchmark entrypoint removed; reforge token benchmark as an organ entrypoint before enabling token-benchmark" >&2; exit 1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=token-benchmark
MemoryMax=128M
TimeoutStartSec=1800

[Install]
WantedBy=token-benchmark.timer
