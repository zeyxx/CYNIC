[Unit]
Description=CYNIC Discord PAC policy server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/discord/src/entrypoints/pac_server.py
Restart=on-failure
RestartSec=5
MemoryMax=128M

[Install]
WantedBy=default.target
