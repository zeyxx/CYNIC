#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
scope="repo"
apply_mode=0
json_mode=0
dry_run="true"
cleanup_timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

print_usage() {
  cat <<'EOF'
Usage: scripts/cynic-space-gc [--scope repo|devops|all] [--apply] [--json]

  --scope repo    Clean repo-local CYNIC build/dependency artifacts only (default).
  --scope devops  Include selected CYNIC/devops user caches.
  --scope all     Include repo + devops + broader runtime caches.
  --apply         Execute deletions (without this flag, runs in dry-run mode).
  --json          Emit machine-readable summary JSON to stdout.
  --help          Show this help.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --scope)
      scope="${2:-}"
      shift 2
      ;;
    --apply)
      apply_mode=1
      dry_run="false"
      shift
      ;;
    --json)
      json_mode=1
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      print_usage
      exit 2
      ;;
  esac
done

if [[ "${scope}" != "repo" && "${scope}" != "devops" && "${scope}" != "all" ]]; then
  echo "invalid --scope value: ${scope}" >&2
  exit 2
fi

if [[ "${scope}" == "repo" ]]; then
  target_paths=(
    "${project_root}/target"
    "${project_root}/target-cynic-ci"
    "${project_root}/target-cynic-mcp-test"
    "${project_root}/.cargo-home/registry/cache"
    "${project_root}/.cargo-home/registry/src"
  )
elif [[ "${scope}" == "devops" ]]; then
  target_paths=(
    "${project_root}/target"
    "${project_root}/target-cynic-ci"
    "${project_root}/target-cynic-mcp-test"
    "${project_root}/.cargo-home/registry/cache"
    "${project_root}/.cargo-home/registry/src"
    "${HOME}/.cache/cargo"
    "${HOME}/.cache/uv"
    "${HOME}/.cynic"
  )
else
  target_paths=(
    "${project_root}/target"
    "${project_root}/target-cynic-ci"
    "${project_root}/target-cynic-mcp-test"
    "${project_root}/.cargo-home/registry/cache"
    "${project_root}/.cargo-home/registry/src"
    "${HOME}/.cache/cargo"
    "${HOME}/.cache/uv"
    "${HOME}/.cache/huggingface"
    "${HOME}/.cache/solana"
    "${HOME}/.cache/yarn"
    "${HOME}/.cache/google-chrome"
    "${HOME}/.cache/ms-playwright"
    "${HOME}/.cache/puppeteer"
    "${HOME}/.cache/llama.cpp"
    "${HOME}/.cynic"
    "${HOME}/.codex/sessions"
  )
fi

if [[ "${apply_mode}" == "0" ]]; then
  echo "Dry run: no paths will be removed (add --apply to execute)."
fi

total_size=0
rows=()
for candidate in "${target_paths[@]}"; do
  if [[ ! -e "${candidate}" ]]; then
    continue
  fi
  size="$(du -sb "${candidate}" | awk '{print $1}')"
  reason="purge candidate"
  case "${candidate}" in
    *"/target") reason="build artifacts (cargo target)" ;;
    *"/target-cynic-ci") reason="CI matrix artifacts" ;;
    *"/target-cynic-mcp-test") reason="MCP test artifacts" ;;
    *"/.cargo-home/registry/cache") reason="cargo registry cache" ;;
    *"/.cargo-home/registry/src") reason="cargo registry source copy" ;;
    "${HOME}/.cache/cargo") reason="global cargo cache" ;;
    "${HOME}/.cache/uv") reason="UV cache" ;;
    "${HOME}/.cache/huggingface") reason="HF cache" ;;
    "${HOME}/.cache/solana") reason="solana cache" ;;
    "${HOME}/.cache/yarn") reason="yarn cache" ;;
    "${HOME}/.cache/google-chrome") reason="browser cache" ;;
    "${HOME}/.cache/ms-playwright") reason="playwright browser binaries/cache" ;;
    "${HOME}/.cache/puppeteer") reason="puppeteer cache" ;;
    "${HOME}/.cache/llama.cpp") reason="llama.cpp model artifacts cache" ;;
    "${HOME}/.cynic") reason="cynic state/caches" ;;
    "${HOME}/.codex/sessions") reason="codex session cache" ;;
  esac
  total_size=$((total_size + size))
  rows+=("${candidate}|${size}|${reason}")
done

if [[ "${json_mode}" == "1" ]]; then
  printf '{'
  printf '"timestamp":"%s",' "${cleanup_timestamp}"
  printf '"scope":"%s",' "${scope}"
  printf '"apply":%s,' "${apply_mode}"
  printf '"dry_run":%s,' "${dry_run}"
  printf '"project_root":"%s",' "${project_root}"
  printf '"targets":['
  first=1
  for row in "${rows[@]}"; do
    path="${row%%|*}"
    rest="${row#*|}"
    size="${rest%%|*}"
    reason="${rest#*|}"
    if [[ "${first}" == "0" ]]; then
      printf ','
    fi
    first=0
    printf '{"path":%s,"size_bytes":%s,"reason":%s}' \
      "$(printf '%s' "\"${path}\"")" \
      "${size}" \
      "$(printf '%s' "\"${reason}\"")"
  done
  printf '],'
  printf '"total_size_bytes":%s,' "${total_size}"
  printf '"disk_before":'
  df -PB1 "${project_root}" | awk 'NR == 2 {printf "{\"filesystem\":\"%s\",\"size_bytes\":%s,\"used_bytes\":%s,\"avail_bytes\":%s}", $1, $2, $3, $4}'
  printf '}'
  printf '\n'
fi

echo "Planned cleanup scope: ${scope}"
echo "Planned reclaim bytes: ${total_size}"
for row in "${rows[@]}"; do
  path="${row%%|*}"
  size="${row#*|}"
  size="${size%%|*}"
  reason="${row#*|}"
  reason="${reason#*|}"
  printf '  - %s (%s): %s\n' "${path}" "${reason}" "${size}"
done

if [[ "${apply_mode}" == "0" ]]; then
  if [[ ${#rows[@]} -eq 0 ]]; then
    echo "Nothing to remove."
  else
    echo "Run again with --apply to reclaim space."
  fi
  exit 0
fi

if [[ ${#rows[@]} -eq 0 ]]; then
  echo "Nothing to remove."
  exit 0
fi

read -r -p "Apply cleanup for scope '${scope}'? [y/N] " -n 1 confirm
echo
if [[ "${confirm,,}" != "y" && "${confirm,,}" != "yes" ]]; then
  echo "Aborted."
  exit 1
fi

removed_bytes=0
for row in "${rows[@]}"; do
  path="${row%%|*}"
  size="${row#*|}"
  size="${size%%|*}"
  reason="${row#*|}"
  reason="${reason#*|}"
  rm -rf -- "${path}"
  echo "removed ${path} (${reason}) [${size}]"
  removed_bytes=$((removed_bytes + size))
done

echo "Removed bytes: ${removed_bytes}"
df -h "${project_root}"
exit 0

