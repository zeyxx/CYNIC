[Unit]
Description=organ-slack — CYNIC Slack relay daemon
Documentation=file://@CYNIC_PROJECT_ROOT@/organs/slack/MANIFEST.yaml
After=network-online.target cynic-kernel.service
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=%h/.cynic-env
WorkingDirectory=@CYNIC_PROJECT_ROOT@
ExecStart=/usr/bin/python3 -m organs.slack.src.dispatch
Restart=on-failure
RestartSec=30s
# Sovereignty note: Slack is a transitional dependency.
# When Organ-Wireguard V3 is operational, replace sender.py only.

[Install]
WantedBy=multi-user.target
