{
    "schema": "cynic.lxc_exec_bridge.v1",
    "status": "normative",
    "description": "Least-privilege bridge contract for executing bounded diagnostics or service-control commands inside Proxmox LXC containers without granting agents raw pct exec, SSH, or sudo authority.",
    "authority": {
        "infra_contract": "axioms/infrastructure-mcp-v1.json",
        "organ": "organs/fleet",
        "policy_file": "organs/fleet/policies/lxc-exec-bridge.policy.json"
    },
    "principles": [
        "deny_by_default",
        "no_raw_shell",
        "no_agent_direct_pct_exec",
        "root_owned_helper_only",
        "sudoers_allows_helper_not_pct",
        "structured_json_request",
        "audit_every_attempt"
    ],
    "runtime_shape": {
        "helper_path": "/usr/local/libexec/cynic-lxc-exec-bridge",
        "source_path": "organs/fleet/src/entrypoints/lxc_exec_bridge_helper.py",
        "request_transport": "stdin_json",
        "response_transport": "stdout_json",
        "bundle_command": "make lxc-exec-bridge-bundle out=/tmp/cynic-lxc-bridge",
        "mcp_transport_env": {
            "CYNIC_LXC_EXEC_BRIDGE_SSH_TARGET": "Required after activation, e.g. cynic@<proxmox-host>. Enables MCP fleet_node_exec LXC transport.",
            "CYNIC_LXC_EXEC_BRIDGE_HELPER": "Optional override, defaults to /usr/local/libexec/cynic-lxc-exec-bridge."
        },
        "sudoers_subject": "cynic",
        "sudoers_rule_shape": "cynic ALL=(root) NOPASSWD: /usr/local/libexec/cynic-lxc-exec-bridge",
        "forbidden_sudoers_shape": "cynic ALL=(root) NOPASSWD: /usr/sbin/pct, /usr/bin/pct, /usr/bin/bash, /bin/sh"
    },
    "request": {
        "required_fields": [
            "node",
            "vmid",
            "purpose",
            "argv",
            "agent_id"
        ],
        "fields": {
            "node": "Proxmox API node name such as pve.",
            "vmid": "Numeric LXC id, e.g. 103.",
            "purpose": "Policy purpose such as read_only or service_control.",
            "argv": "Array command form. Shell strings are forbidden.",
            "agent_id": "Calling cortex, organ, or persistent agent identity.",
            "timeout_seconds": "Optional bounded timeout."
        }
    },
    "policy": {
        "allowed_command_shape": "argv_prefix_allowlist_per_purpose",
        "max_timeout_seconds": 60,
        "allowed_purposes": [
            "read_only",
            "service_control"
        ]
    },
    "mcp_integration": {
        "operation": "fleet.node.exec",
        "lxc_transition": "fleet_node_exec must return precondition_missing until this bridge is installed, observable on the Proxmox host, and CYNIC_LXC_EXEC_BRIDGE_SSH_TARGET is configured.",
        "activation_evidence": [
            "source_helper_tests_pass",
            "helper_exists_root_owned",
            "sudoers_rule_matches_contract",
            "policy_validates",
            "dry_run_read_only_command_passes",
            "raw_pct_exec_not_allowed_to_agent",
            "activation_status_reports_active"
        ]
    }
}
