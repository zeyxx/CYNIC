{
  "id": "node_identity",
  "layer": "l2_node_apply_boundary",
  "owner_crate": "cynic-node",
  "adapter_module": "cynic-node::main",
  "domain_owner": "cynic-protocol::node_identity",
  "owner_modules": [
    "ports::node_identity_port",
    "adapters::local_node_identity",
    "usecases::node_identity_uc"
  ],
  "owner_call_markers": [
    "execute_node_identity"
  ],
  "responsibility": "Generate a node-local Ed25519 machine identity exactly once, observe only its public commitment and private-file safety, and require post-generation read-back before enrollment may continue.",
  "mutation_policy": "read_only_by_default_explicit_apply_create_once",
  "canonical_entrypoints": [
    "cynic-node node-identity --json --node-id <node> [--signing-key-path <path>] [--apply]"
  ],
  "evidence": [
    "cynic.node_identity.desired_state.v1",
    "cynic.node_identity.observation.v1",
    "cynic.node_identity.plan.v1",
    "cynic.node_identity.report.v1"
  ],
  "anti_responsibilities": [
    "return or transport the private signing key",
    "replace an existing key",
    "claim machine enrollment before authority-signed grant read-back",
    "generate build grants directly"
  ]
}
