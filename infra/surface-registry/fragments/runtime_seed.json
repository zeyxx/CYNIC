{
  "id": "runtime_seed",
  "layer": "l1_host_apply_boundary",
  "owner_crate": "cynic-host",
  "adapter_module": "cynic-host::host_exec_cli::runtime_seed",
  "domain_owner": "cynic-protocol::{runtime_seed,runtime_release,release_publication}",
  "owner_modules": [
    "cynic-protocol::runtime_seed",
    "cynic-protocol::runtime_release",
    "cynic-protocol::release_publication",
    "cynic-kernel::api::rest::node_control",
    "cynic-host::runtime_seed::signature",
    "cynic-host::runtime_seed::filesystem",
    "cynic-host::runtime_seed",
    "cynic-host::host_exec_cli::runtime_seed",
    "cynic-host::framework_bootstrap::bundle"
  ],
  "owner_call_markers": [
    "reconcile_runtime_seed",
    "RuntimeSeedSignatureVerifier",
    "RuntimeSeedActivationPort",
    "execute_plan"
  ],
  "responsibility": "Keep a separately governed bootstrap root capable of admitting signed content-addressed runtime baskets bound to an exact source commit and admitted build proof through monotonic epochs, two-slot activation, postflight read-back, and rollback without depending on the MCP version being replaced.",
  "mutation_policy": "explicit_apply_or_admitted_node_desired_state_after_signature_digest_epoch_node_and_slot_preflight",
  "canonical_entrypoints": [
    "cynic_runtime_release_declare",
    "PUT /node-control/{node_id}/desired-state with cynic.runtime_release_declaration.v1",
    "cynic-host-exec runtime-seed-plan --request <request.json> --observation <observation.json>",
    "cynic-host-exec runtime-seed-reconcile --request <request.json> [--apply]"
  ],
  "evidence": [
    "cynic.runtime_seed.request.v4",
    "cynic.release_publication.desired_state.v1",
    "cynic.runtime_release_declaration.v1",
    "cynic.runtime_release_admission.v2",
    "cynic.release.signed_basket_read_back.v2",
    "cynic.release.publication_manifest.v2",
    "cynic.runtime_seed.observation.v4",
    "cynic.runtime_seed.plan.v4",
    "cynic.host.runtime_seed.apply_report.v2"
  ],
  "anti_responsibilities": [
    "include the runtime seed in the mutable runtime basket",
    "use MCP availability as upgrade authority",
    "activate an unsigned or digest-mismatched basket",
    "permit release epoch rollback",
    "claim convergence before postflight read-back"
  ]
}
