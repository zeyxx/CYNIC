{
  "version": 1,
  "schema": "cynic.registry.v1.minimal",
  "purpose": "Minimal runtime placement registry for the rebuilt low-layer organism.",
  "provider_control": {
    "schema": "cynic.provider_control.desired_state.v1",
    "provider": "proxmox",
    "endpoint": "https://pve.synapse.cynic:8006",
    "token_identity": "cynic@pve!runtime",
    "credential_ref": "/etc/cynic/secrets/proxmox-token",
    "credential_lease_metadata_ref": "/etc/cynic/identity/proxmox-credential-lease.json",
    "credential_authority_public_key_ref": "/etc/cynic/identity/proxmox-credential-authority.pub"
  },
  "release_publication": {
    "schema": "cynic.release_publication.desired_state.v1",
    "storage_role": "storage_primary",
    "service_name": "runtime-artifact-store",
    "protocol": "generic_https_put_get",
    "authentication_kind": "bearer_file",
    "credential_path": "/var/lib/cynic/identity/artifact-store-token",
    "signing_key_path": "/var/lib/cynic/identity/release-signing-key",
    "signer_identity": "cynic-release",
    "signature_namespace": "cynic-runtime-seed"
  },
  "storage_registry": {
    "schema": "cynic.storage_registry.v1",
    "classes": [
      {
        "schema": "cynic.storage_class.v1",
        "id": "artifact_store",
        "provider": "proxmox",
        "management_policy": ["observe", "update"],
        "reclaim_policy": "retain",
        "allow_expansion": true,
        "allow_shrink": false,
        "minimum_bytes": 10737418240,
        "maximum_bytes": 1099511627776
      }
    ],
    "volumes": [
      {
        "schema": "cynic.storage_volume.v1",
        "id": "storage_primary_artifacts",
        "class_id": "artifact_store",
        "provider_resource_id": "lxc/103:mp0",
        "owner": "runtime-artifact-store"
      }
    ],
    "claims": [
      {
        "schema": "cynic.storage_claim.v1",
        "id": "runtime_artifact_store_claim",
        "owner": "runtime-artifact-store",
        "class_id": "artifact_store",
        "requested_bytes": 8589934592,
        "mode": "permanent",
        "expires_at_ms": null
      }
    ],
    "bindings": [
      {
        "schema": "cynic.storage_binding.v1",
        "id": "runtime_artifact_store_binding",
        "volume_id": "storage_primary_artifacts",
        "claim_id": "runtime_artifact_store_claim",
        "mount_path": "/data",
        "service": "runtime-artifact-store"
      }
    ]
  },
  "node_enrollment": {
    "schema": "cynic.node_enrollment.desired_state.v1",
    "authority_role": "kernel_primary",
    "endpoint_service": "cynic-kernel",
    "credential_delivery": "machine_enrollment_staging",
    "public_key_delivery": "machine_enrollment_staging",
    "authority_policy": {
      "authority_id": "cynic-runtime-machine-enrollment",
      "token_ttl_s": 900,
      "renewal_authority_ttl_s": 2592000,
      "max_grant_ttl_s": 86400,
      "allowed_roles": [
        "build_runner"
      ],
      "allowed_capabilities": [
        "node_control",
        "build_runner",
        "kernel_to_node_workload_delivery_read_back",
        "scheduler_claim_renewal",
        "scheduler_cancellation_delivery",
        "scheduler_crash_recovery",
        "node_owned_build_grant_machine_signer",
        "build_runner_signature_and_live_workload_verifier",
        "scheduler_to_build_runner_execution_transport",
        "build_completion_and_artifact_read_back",
        "node_workspace_observer_wiring_and_proof"
      ]
    }
  },
  "network_policy": {
    "canonical_service_plane": "synapse",
    "planes": {
      "management": {
        "cidr": "192.168.100.0/24",
        "canonical": false,
        "purpose": "direct bare-metal management transport"
      },
      "synapse": {
        "cidr": "10.10.10.0/24",
        "dns_zone": "synapse.cynic",
        "canonical": true
      }
    },
    "reservations": [
      {
        "name": "cynic-host-proxmox",
        "management": "192.168.100.1",
        "synapse": "10.10.10.1",
        "dns": [
          "cynic-host-proxmox.synapse.cynic",
          "pve.synapse.cynic"
        ]
      },
      {
        "name": "cynic-host-cortex",
        "management": "192.168.100.2"
      },
      {
        "name": "forgejo",
        "synapse": "10.10.10.101",
        "dns": [
          "forgejo.synapse.cynic",
          "organ-forgejo.synapse.cynic",
          "cynic-lxc-git.synapse.cynic"
        ]
      },
      {
        "name": "cynic-lxc-surrealdb",
        "synapse": "10.10.10.103",
        "dns": [
          "cynic-lxc-surrealdb.synapse.cynic",
          "cynic-storage-primary.synapse.cynic",
          "organ-surrealdb.synapse.cynic"
        ]
      },
      {
        "name": "cynic-builder",
        "synapse": "10.10.10.119",
        "dns": [
          "cynic-builder.synapse.cynic"
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "cynic-host-proxmox",
      "name": "cynic-host-proxmox",
      "aliases": ["pve"],
      "role": "hypervisor",
      "host_family": "linux.proxmox.systemd",
      "provider_controls": ["proxmox"],
      "status": "observed",
      "deploy_target": false,
      "transports": {
        "ssh": {
          "target": "proxmox-forge",
          "trust": "known_hosts",
          "known_hosts_ref": "/etc/cynic/identity/proxmox-known-hosts"
        }
      },
      "network": {
        "management": "192.168.100.1",
        "synapse": "10.10.10.1"
      },
      "services": []
    },
    {
      "id": "cynic-host-cortex",
      "name": "cynic-host-cortex",
      "aliases": ["ubuntu"],
      "role": "cortex_host",
      "status": "candidate",
      "deploy_target": false,
      "network": {
        "management": "192.168.100.2"
      },
      "network_links": [
        {
          "plane": "management",
          "provider": "network-manager",
          "interface": "enp42s0",
          "connection": "Connexion filaire 1",
          "address": "192.168.100.2/24",
          "gateway": "192.168.100.1",
          "routes": ["10.10.10.0/24"],
          "default_route": false
        }
      ],
      "services": []
    },
    {
      "id": "local-kernel",
      "name": "local-kernel",
      "host_node_id": "cynic-host-cortex",
      "role": "kernel_primary",
      "status": "candidate",
      "deploy_target": true,
      "services": [
        {
          "name": "cynic-kernel",
          "artifact": "cynic-kernel",
          "scheme": "http",
          "endpoint_host": "192.168.100.2",
          "network_plane": "management",
          "port": 3030,
          "unit": "cynic-kernel.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "tcp",
            "port": 3030
          }
        },
        {
          "name": "cynic-node",
          "artifact": "cynic-node",
          "unit": "cynic-node.service",
          "supervisor": {
            "provider": "process-port"
          },
          "health": {
            "kind": "process",
            "process": "cynic-node"
          }
        }
      ]
    },
    {
      "id": "cynic-lxc-surrealdb",
      "name": "cynic-lxc-surrealdb",
      "aliases": [
        "cynic-storage-primary",
        "organ-surrealdb"
      ],
      "role": "storage_primary",
      "host_family": "linux.debian.systemd",
      "status": "candidate",
      "deploy_target": true,
      "proxmox_id": "lxc/103",
      "transports": {
        "ssh": {
          "target": "cynic-storage-primary.synapse.cynic",
          "trust": "known_hosts",
          "enrollment_authority": {
            "class": "machine_enrollment",
            "principal": "root",
            "credential_ref": "registry-machine-ssh-identity"
          }
        }
      },
      "network": {
        "synapse": "10.10.10.103"
      },
      "services": [
        {
          "name": "surrealdb",
          "artifact": "surreal",
          "scheme": "http",
          "port": 8000,
          "unit": "surrealdb.service",
          "supervisor": {
            "provider": "systemd"
          },
          "health": {
            "kind": "http",
            "path": "/health",
            "port": 8000
          }
        },
        {
          "name": "runtime-artifact-store",
          "artifact": "external-runtime-artifact-store",
          "install_authority": {
            "channel": "external",
            "provenance": "storage_primary_image"
          },
          "scheme": "https",
          "endpoint_host": "cynic-storage-primary.synapse.cynic",
          "port": 8443,
          "base_path": "/runtime-releases",
          "protocol": "generic_https_put_get",
          "authentication_kind": "bearer_file",
          "unit": "runtime-artifact-store.service",
          "supervisor": {
            "provider": "systemd"
          },
          "health": {
            "kind": "https",
            "path": "/health",
            "port": 8443
          }
        }
      ]
    },
    {
      "id": "cynic-builder",
      "name": "cynic-builder",
      "role": "build_runner",
      "host_family": "linux.ubuntu.systemd",
      "status": "candidate",
      "deploy_target": true,
      "proxmox_id": "lxc/105",
      "transports": {
        "ssh": {
          "target": "cynic-builder",
          "trust": "known_hosts",
          "enrollment_authority": {
            "class": "machine_enrollment",
            "principal": "root",
            "credential_ref": "registry-machine-ssh-identity"
          }
        }
      },
      "network": {
        "synapse": "10.10.10.119"
      },
      "source_workspace_layout": {
        "repository_store": "source/repositories",
        "workspace_store": "source/workspaces",
        "principal": "cynic",
        "dedicated_worktrees": true,
        "repositories": [
          {
            "id": "cynic",
            "relative_path": "CYNIC"
          }
        ]
      },
      "build_lifecycle": {
        "schema": "cynic.build_runner.resource_policy.v1",
        "minimum_available_bytes": 4294967296,
        "canonical_target_relative_path": "build-targets/bootstrap",
        "canonical_cache_reclaim": {
          "schema": "cynic.build_runner.cache_reclaim_policy.v1",
          "trigger": "available_bytes_below_minimum",
          "action": "rust_remove_bounded_profile",
          "target_profile": "debug",
          "preserve_profiles": ["release"],
          "rollback_intent": "none_reproducible_build_cache_only"
        },
        "noncanonical_cache_candidates": [
          {
            "base": "temporary_directory",
            "relative_path": "cynic-cargo-targets"
          },
          {
            "base": "state_root",
            "relative_path": "source/repositories/CYNIC/target"
          }
        ],
        "bootstrap_containment": {
          "schema": "cynic.build_runner.bootstrap_containment.v1",
          "authority_class": "MachineEnrollment",
          "adapter": "ssh_machine_enrollment",
          "scope": "n_minus_one_seed_only",
          "entrypoint": "scripts/build-runner-bootstrap",
          "removal_requires": [
            "node_substrate_provisioning_read_back",
            "source_snapshot_transport_read_back",
            "durable_workload_delivery_read_back",
            "machine_enrollment_without_operator_transport",
            "canonical_build_completion_read_back"
          ]
        }
      },
      "services": [
        {
          "name": "cynic-node",
          "artifact": "cynic-node",
          "unit": "cynic-node.service",
          "supervisor": {
            "provider": "systemd"
          },
          "health": {
            "kind": "process",
            "process": "cynic-node"
          }
        }
      ]
    },
    {
      "id": "forgejo",
      "name": "forgejo",
      "aliases": [
        "organ-forgejo",
        "cynic-lxc-git"
      ],
      "role": "forge_primary",
      "status": "candidate",
      "deploy_target": true,
      "proxmox_id": "lxc/101",
      "network": {
        "local": "10.10.10.101",
        "synapse": "10.10.10.101"
      },
      "services": [
        {
          "name": "ssh",
          "scheme": "ssh",
          "port": 22
        },
        {
          "name": "forgejo-backend",
          "scheme": "http",
          "port": 3000
        },
        {
          "name": "forgejo-api-tls",
          "scheme": "https",
          "port": 443
        }
      ]
    }
  ],
  "fleet_desired": {
    "targets": [
      {
      "id": "cynic-builder",
        "provider": "proxmox",
        "resource_id": "lxc/105",
        "role": "build_runner",
        "desired_power": "running"
      },
      {
        "id": "forgejo-primary",
        "provider": "proxmox",
        "resource_id": "lxc/101",
        "role": "forge_primary",
        "desired_power": "running"
      },
      {
        "id": "storage-primary",
        "provider": "proxmox",
        "resource_id": "lxc/103",
        "role": "storage_primary",
        "desired_power": "running"
      }
    ]
  },
  "lifecycle": {
    "kernel_release": {
      "build_runner_role": "build_runner",
      "deploy_target_role": "kernel_primary",
      "host_bootstrap": {
        "role_profiles": {
          "kernel_primary": {
            "target_stage": "h6_host_actionable",
            "required_domains": [
              "host",
              "services",
              "storage",
              "kernel"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "kernel_service_observed",
              "storage_health_observed"
            ]
          },
          "build_runner": {
            "target_stage": "h4_privilege_helpers_ready",
            "required_domains": [
              "host",
              "toolchain",
              "build"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "cargo_check_observed",
              "binary_build_observed",
              "build_resource_preflight_read_back",
              "runtime_marker_read_back",
              "node_control_config_read_back",
              "node_service_active_read_back",
              "bootstrap_completion_read_back"
            ]
          },
          "storage_primary": {
            "target_stage": "h5_services_projected",
            "required_domains": [
              "host",
              "storage"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "storage_health_observed"
            ]
          },
          "forge_primary": {
            "target_stage": "h5_services_projected",
            "required_domains": [
              "host",
              "services",
              "network",
              "forge"
            ],
            "required_proof": [
              "host_identity_observed",
              "host_bootstrap_target_satisfied",
              "forgejo_backend_observed",
              "forgejo_tls_identity_observed"
            ]
          }
        }
      },
      "runtime_artifacts": [
        "cynic-kernel",
        "cynic-node",
        "cynic-mcp",
        "cynic-lxc-exec-bridge",
        "cynic"
      ]
    }
  }
}
