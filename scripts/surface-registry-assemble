#!/usr/bin/env python3
"""Assemble canonical surface-registry JSON from fragment files.

Inputs:
  - infra/surface-registry/manifest.json
  - manifest surface entries path references under infra/surface-registry/

Output:
  - infra/surface-registry.json (deterministic, ordered by manifest)

Usage:
  scripts/surface-registry-assemble
  scripts/surface-registry-assemble --check
  scripts/surface-registry-assemble --output path/to/file.json
"""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from collections.abc import MutableMapping
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / "infra" / "surface-registry" / "manifest.json"
DEFAULT_OUTPUT = ROOT / "infra" / "surface-registry.json"
EXPECTED_SCHEMA = "cynic.surface_registry.v1"
_READ_FLAGS = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
_DIRECTORY_FLAGS = _READ_FLAGS | os.O_DIRECTORY


def fail(message: str) -> None:
    print(f"surface-registry-assemble: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_json(path: Path) -> Any:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        fail(f"missing file: {path}")
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {path}: {error}")


def read_json_fd(fd: int, display_path: Path) -> Any:
    try:
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        fail(f"missing file: {display_path}")
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {display_path}: {error}")


def canonical_signature(document: Any) -> str:
    return json.dumps(document, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def safe_relative_path(value: Any, *, context: str) -> Path:
    if not isinstance(value, str) or not value:
        fail(f"{context}: missing path")
    path = Path(value)
    if path.is_absolute() or "\\" in value or any(part in ("", ".", "..") for part in path.parts):
        fail(f"{context}: path must be safe and relative: {value!r}")
    return path


def fragment_path(
    value: Any, *, context: str, manifest_root: Path, fragments_dir: Path
) -> tuple[Path, Path]:
    """Validate a manifest path, including containment and lexical checks."""
    relative = safe_relative_path(value, context=context)
    candidate = manifest_root.joinpath(relative)
    try:
        candidate.relative_to(fragments_dir)
    except ValueError:
        fail(f"{context}: path must be beneath fragments directory: {value!r}")

    # Retain the explicit no-symlink and resolved containment checks for clear
    # diagnostics. The descriptor-relative open below is the security boundary.
    current = manifest_root
    for component in relative.parts:
        current /= component
        try:
            if stat.S_ISLNK(os.lstat(current).st_mode):
                fail(f"{context}: symlink components/files are not allowed: {value!r}")
        except FileNotFoundError:
            break

    resolved_root = fragments_dir.resolve(strict=True)
    resolved_candidate = candidate.resolve(strict=False)
    try:
        resolved_candidate.relative_to(resolved_root)
    except ValueError:
        fail(f"{context}: resolved path escapes fragments directory: {value!r}")
    if resolved_candidate == resolved_root:
        fail(f"{context}: path must name a fragment beneath fragments directory: {value!r}")
    return relative, candidate


def verify_root_fd(root_fd: int, intended_root: Path) -> None:
    """Ensure the opened root descriptor names the intended resolved root."""
    try:
        actual_root = Path(os.readlink(f"/proc/self/fd/{root_fd}")).resolve(strict=True)
    except (OSError, RuntimeError) as error:
        fail(f"cannot verify repository root descriptor: {error}")
    if actual_root != intended_root:
        fail(
            "repository root descriptor identity mismatch: "
            f"expected {intended_root}, found {actual_root}"
        )


def open_relative(root_fd: int, relative: Path, *, directory: bool = False) -> int:
    """Open a path beneath root_fd without following any component symlink."""
    current = os.dup(root_fd)
    try:
        for index, component in enumerate(relative.parts):
            is_final = index == len(relative.parts) - 1
            flags = _DIRECTORY_FLAGS if (directory or not is_final) else _READ_FLAGS
            next_fd = os.open(component, flags, dir_fd=current)
            os.close(current)
            current = next_fd
        return current
    except OSError as error:
        os.close(current)
        fail(f"unsafe or missing path {relative}: {error.strerror}")


def read_fragment(root_fd: int, relative: Path, display_path: Path) -> Any:
    """Read an already descriptor-resolved fragment; no pathname reopen occurs."""
    fd = open_relative(root_fd, relative)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            fail(f"fragment {display_path} is not a regular file")
        return read_json_fd(fd, display_path)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def scan_files(dir_fd: int, relative: Path) -> set[Path]:
    """Recursively scan using directory descriptors and reject symlink entries."""
    found: set[Path] = set()
    try:
        entries = list(os.scandir(dir_fd))
    except OSError as error:
        fail(f"cannot scan fragments directory {relative}: {error.strerror}")
    for entry in entries:
        entry_relative = relative / entry.name
        if entry.is_symlink():
            fail(f"symlink components/files are not allowed under fragments: {entry_relative}")
        try:
            child_fd = os.open(entry.name, _DIRECTORY_FLAGS, dir_fd=dir_fd)
        except NotADirectoryError:
            child_fd = os.open(entry.name, _READ_FLAGS, dir_fd=dir_fd)
            try:
                if stat.S_ISLNK(os.fstat(child_fd).st_mode):
                    fail(f"symlink components/files are not allowed under fragments: {entry_relative}")
                if stat.S_ISREG(os.fstat(child_fd).st_mode):
                    found.add(entry_relative)
            finally:
                os.close(child_fd)
        except FileNotFoundError:
            fail(f"entry disappeared while scanning fragments: {entry_relative}")
        except OSError as error:
            fail(f"unsafe entry under fragments {entry_relative}: {error.strerror}")
        else:
            try:
                found.update(scan_files(child_fd, entry_relative))
            finally:
                os.close(child_fd)
    return found


def build_document(manifest: MutableMapping[str, Any], fragments_root: Path) -> dict[str, Any]:
    raw_fragments_dir = fragments_root / "fragments"
    if raw_fragments_dir.is_symlink():
        fail(f"fragments directory is a symlink: {raw_fragments_dir}")
    manifest_root = fragments_root.resolve(strict=True)
    fragments_dir = manifest_root / "fragments"
    if not fragments_dir.is_dir() or fragments_dir.is_symlink():
        fail(f"fragments directory is missing or unsafe: {fragments_dir}")
    if manifest.get("schema") != EXPECTED_SCHEMA:
        fail(
            "manifest schema mismatch: expected "
            f"{EXPECTED_SCHEMA}, found {manifest.get('schema', '<missing>')}"
        )

    entries = manifest.get("surfaces")
    if not isinstance(entries, list):
        fail("manifest.surfaces must be an array")
    if len(entries) == 0:
        fail("manifest.surfaces is empty")

    retired = manifest.get("retired", [])
    if not isinstance(retired, list):
        fail("manifest.retired must be an array")

    root_fd: int | None = None
    fragments_fd: int | None = None
    try:
        root_fd = os.open(manifest_root, _DIRECTORY_FLAGS)
        verify_root_fd(root_fd, manifest_root)
        fragments_fd = open_relative(root_fd, Path("fragments"), directory=True)
        seen_ids: set[str] = set()
        active_ids: set[str] = set()
        referenced_paths: set[Path] = set()
        retired_paths: set[Path] = set()
        surfaces = []
        for entry in entries:
            if not isinstance(entry, dict):
                fail("manifest.surfaces entries must be objects")
            surface_id = entry.get("id")
            path = entry.get("path")
            if not isinstance(surface_id, str) or not surface_id:
                fail("manifest surface entry is missing a non-empty id")
            relative_path, _ = fragment_path(
                path, context=f"surface {surface_id}", manifest_root=manifest_root, fragments_dir=fragments_dir
            )
            if relative_path in referenced_paths:
                fail(f"duplicate fragment path in manifest: {path}")
            referenced_paths.add(relative_path)
            fragment = read_fragment(root_fd, relative_path, manifest_root / relative_path)
            if not isinstance(fragment, dict):
                fail(f"fragment {path} must be an object")
            if fragment.get("id") != surface_id:
                fail(
                    f"fragment id mismatch for {surface_id}: "
                    f"manifest expects {surface_id}, fragment has {fragment.get('id')}"
                )
            if surface_id in seen_ids:
                fail(f"duplicate surface id in manifest: {surface_id}")
            seen_ids.add(surface_id)
            active_ids.add(surface_id)
            surfaces.append(fragment)

        for entry in retired:
            if not isinstance(entry, dict):
                fail("manifest.retired entries must be objects")
            retired_id = entry.get("id")
            reason = entry.get("reason")
            path = entry.get("path")
            if not isinstance(retired_id, str) or not retired_id:
                fail("retired entry is missing a non-empty id")
            if not isinstance(reason, str) or not reason:
                fail(f"retired {retired_id}: missing reason")
            relative_path, _ = fragment_path(
                path, context=f"retired {retired_id}", manifest_root=manifest_root, fragments_dir=fragments_dir
            )
            if retired_id in seen_ids:
                if retired_id in active_ids:
                    fail(f"retired surface is also active: {retired_id}")
                fail(f"duplicate retired surface id: {retired_id}")
            seen_ids.add(retired_id)
            if relative_path in referenced_paths or relative_path in retired_paths:
                fail(f"duplicate fragment path in manifest: {path}")
            retired_paths.add(relative_path)
            fragment = read_fragment(root_fd, relative_path, manifest_root / relative_path)
            if not isinstance(fragment, dict):
                fail(f"retired fragment {path} must be an object")
            if fragment.get("id") != retired_id:
                fail(
                    f"retired fragment id mismatch for {retired_id}: "
                    f"fragment has {fragment.get('id')}"
                )

        manifest_paths = referenced_paths | retired_paths
        fragment_paths = scan_files(fragments_fd, Path("fragments"))
        orphaned = sorted(fragment_paths - manifest_paths)
        if orphaned:
            fail("unclassified fragment(s): " + ", ".join(str(path) for path in orphaned))

        return {"schema": EXPECTED_SCHEMA, "surfaces": surfaces}
    finally:
        if fragments_fd is not None:
            os.close(fragments_fd)
        if root_fd is not None:
            os.close(root_fd)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", default=str(DEFAULT_MANIFEST), help="path to surface-registry manifest")
    parser.add_argument("--output", default=str(DEFAULT_OUTPUT), help="target assembled surface-registry JSON")
    parser.add_argument("--check", action="store_true", help="validate assembled output against manifest without writing")
    args = parser.parse_args()

    manifest_path = Path(args.manifest)
    output_path = Path(args.output)
    manifest = read_json(manifest_path)
    if not isinstance(manifest, dict):
        fail(f"manifest must be an object: {manifest_path}")
    assembled = build_document(manifest, manifest_path.parent)

    if args.check:
        existing = read_json(output_path)
        if canonical_signature(existing) != canonical_signature(assembled):
            fail("assembled output does not match manifest fragments")
        print("surface-registry is consistent with fragments")
        return

    output_path.parent.mkdir(parents=True, exist_ok=True)
    with output_path.open("w", encoding="utf-8") as handle:
        json.dump(assembled, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
    print(str(output_path))


if __name__ == "__main__":
    main()
