[Unit]
Description=CYNIC organ-browser — Chrome with CDP for sovereign browser perception
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/cynic/env
Environment=CHROME_BIN=/usr/bin/google-chrome
Environment=ORGAN_BROWSER_CDP_PORT=40769
Environment=ORGAN_BROWSER_STATE_DIR=%h/.cynic/organs/browser
Environment=DISPLAY=:0
ExecStart=@CYNIC_PROJECT_ROOTpython3 @/organs/browser/src/entrypoints/launch_browser.py
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
MemoryMax=1G

[Install]
WantedBy=default.target
