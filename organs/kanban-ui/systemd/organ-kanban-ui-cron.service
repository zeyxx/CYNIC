[Unit]
Description=CYNIC Organ Kanban UI Projector
After=cynic-kernel.service

[Service]
Type=oneshot
WorkingDirectory=@CYNIC_PROJECT_ROOT@
EnvironmentFile=%h/.config/cynic/env
ExecStart=/usr/bin/python3 @CYNIC_PROJECT_ROOT@/organs/kanban-ui/src/entrypoints/cli.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
